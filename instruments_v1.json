/* =====================================================
   ASSET / RESOURCE HELPERS
===================================================== */

function assetLiquidationMonth(
  inputs,
  asset
){
  return clamp(
    ageToMonth(
      inputs,
      asset.liquidationAge
    ),
    0,
    totalMonthsFor(inputs)
  );
}

function resourceRealValue(
  inputs,
  resource
){
  if(
    !resource.enabled ||
    resource.futureNominalAmount <= 0
  ){
    return 0;
  }

  const years =
    Math.max(
      0,
      resource.realizationAge -
      inputs.currentAge
    );

  const inflationFactor =
    Math.pow(
      1+inputs.inflation,
      years
    );

  if(
    !Number.isFinite(inflationFactor) ||
    inflationFactor <= 0
  ){
    return 0;
  }

  /*
    Future amount is entered in FUTURE NOMINAL money.
    Convert it once to today's purchasing power.
  */
  return (
    resource.futureNominalAmount /
    inflationFactor
  );
}

function resourceRealizationMonth(
  inputs,
  resource
){
  return clamp(
    ageToMonth(
      inputs,
      resource.realizationAge
    ),
    0,
    totalMonthsFor(inputs)
  );
}


/* =====================================================
   PUBLIC PENSION
===================================================== */

function publicPensionAtMonth(
  inputs,
  month
){

  if(inputs.publicPension <= 0){
    return 0;
  }

  const age =
    inputs.currentAge +
    month / 12;

  if(age < inputs.publicPensionAge){
    return 0;
  }

  const yearsSinceStart =
    Math.max(
      0,
      age - inputs.publicPensionAge
    );

  return (
    inputs.publicPension *
    Math.pow(
      1 + inputs.publicPensionGrowth,
      yearsSinceStart
    )
  );

}

function supplementaryPensionAtMonth(
  inputs,
  month
){

  if(inputs.supplementaryPension <= 0){
    return 0;
  }

  const age =
    inputs.currentAge +
    month / 12;

  const startAge =
    inputs.supplementaryPensionStatus === "receiving"
      ? inputs.currentAge
      : inputs.publicPensionAge;

  if(age < startAge){
    return 0;
  }

  const yearsSinceStart =
    Math.max(
      0,
      age - startAge
    );

  return (
    inputs.supplementaryPension *
    Math.pow(
      1 + inputs.publicPensionGrowth,
      yearsSinceStart
    )
  );

}


/* =====================================================
   PUBLIC PENSION — PV CACHE

   One backward calculation for the entire
   Life Cycle instead of recalculating all
   future cashflows for every month.

   PV[T] = 0

   PV[t] =
     (Pension[t+1] + PV[t+1]) /
     (1 + monthlyUseRate)
===================================================== */

const publicPensionPVCache =
  new WeakMap();
const supplementaryPensionPVCache = new WeakMap();


function buildPublicPensionPV(
  inputs,
  annualUseRealRate
){

  const totalMonths =
    totalMonthsFor(inputs);

  const monthlyRate =
    annualToMonthly(
      annualUseRealRate
    );

  const pv =
    new Array(totalMonths + 1).fill(0);

  if(inputs.publicPension <= 0){
    return pv;
  }

  /*
    BACKWARD RECURSION
  */

  for(
    let month = totalMonths - 1;
    month >= 0;
    month--
  ){

    const nextPension =
      publicPensionAtMonth(
        inputs,
        month + 1
      );

    pv[month] =
      (
        nextPension +
        pv[month + 1]
      ) /
      (1 + monthlyRate);

  }

  return pv;

}

function supplementaryPensionShadowAtMonth(
  inputs,
  month,
  annualUseRealRate
){

  if(inputs.supplementaryPension <= 0){
    return 0;
  }

  const totalMonths =
    totalMonthsFor(inputs);

  if(month >= totalMonths){
    return 0;
  }

  /*
    CACHE BY INPUT OBJECT AND USE RATE
  */

  let rateCache =
    supplementaryPensionPVCache.get(inputs);

  if(!rateCache){

    rateCache =
      new Map();

    supplementaryPensionPVCache.set(
      inputs,
      rateCache
    );

  }

  const cacheKey =
    annualUseRealRate;

  let pv =
    rateCache.get(cacheKey);

  if(!pv){

    pv =
      buildSupplementaryPensionPV(
        inputs,
        annualUseRealRate
      );

    rateCache.set(
      cacheKey,
      pv
    );

  }

  return pv[month] ?? 0;

}

