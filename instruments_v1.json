  */

  document.getElementById("lcAccountLogoutBtn")
    ?.addEventListener("click",async () => {

      console.log("LIFE CYCLE LOGOUT START");

      const button =
        document.getElementById("lcAccountLogoutBtn");

      const message =
        document.getElementById("lcAccountMemberMessage");

      if(button) button.disabled = true;
      if(message) message.textContent = "";

      try{

        const {error} =
          await supabaseClient.auth.signOut();

        if(error) throw error;

        closeLifeCycleLogin();

        console.log("LIFE CYCLE LOGOUT SUCCESS");

      }catch(error){

        console.error("LIFE CYCLE LOGOUT ERROR",error);

        if(message){
          message.textContent =
            error.message || "Logout failed.";
        }

      }finally{

        if(button) button.disabled = false;

      }

    });

  /*
    CLICK OUTSIDE MODAL
  */

  overlay.addEventListener("click",event => {

    if(event.target === overlay){
      closeLifeCycleLogin();
    }

  });

  /*
    ESCAPE KEY
  */

  document.addEventListener("keydown",event => {

    if(
      event.key === "Escape" &&
      !overlay.hidden
    ){
      closeLifeCycleLogin();
    }

  });

  /*
    INITIAL MODE
  */

  setLifeCycleAccountMode("login");

}

