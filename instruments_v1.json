function renderFreedomHeader(scenario){

  const lang =
    INIT.lang === "da"
      ? "da"
      : "en";

  const T = {

    en:{
      notReached:"NOT REACHED",
      notReachedText:
        "Not reached within expected lifetime",

      alreadyReached:"REACHED",
      alreadyReachedText:
        "Life Cycle begins in the USING phase today",

      expectedText:
        "Expected financial freedom",

      rangeText:
        "Favorable – adverse scenarios"
    },

    da:{
      notReached:"IKKE OPNÅET",
      notReachedText:
        "Ikke opnået inden for forventet levetid",

      alreadyReached:"OPNÅET",
      alreadyReachedText:
        "Livscyklussen begynder i nedsparingssfasen i dag",

      expectedText:
        "Forventet økonomisk frihed",

      rangeText:
        "Gunstigt – ugunstigt scenarie"
    }

  }[lang];


  const expected =
    scenario?.expected;

  const ageEl =
    byId("freedomAge");

  const minEl =
    byId("freedomMin");

  const maxEl =
    byId("freedomMax");

  const rangeEl =
    byId("freedomRange");


  /*
    RESET
  */

  ageEl.textContent = "—";
  minEl.textContent = "—";
  maxEl.textContent = "—";
  rangeEl.textContent = "";



/*
  NOT REACHED
*/

if(
  !expected ||
  expected.status === "notReached"
){

  ageEl.textContent = "—";

  rangeEl.textContent =
    lang === "da"
      ? "Ingen Financial Freedom Day identificeret"
      : "No Financial Freedom Day identified";

  return;
}


/*
  ALREADY REACHED
*/

if(
  expected.status === "alreadyReached"
){

  ageEl.textContent =
    lang === "da" ? "I DAG" : "TODAY";

  rangeEl.textContent =
    lang === "da"
      ? "Du kan allerede overgå til nedsparingsfasen"
      : "You can already transition to the wealth-decumulation phase";

  return;
}


  /*
    EXPECTED AGE
  */

  ageEl.textContent =
    formatAge(expected.age);


  /*
    FAVORABLE / ADVERSE AGES
  */

  const validScenarioAges = [
    scenario.favorable,
    scenario.adverse
  ]
    .filter(
      item =>
        item &&
        item.status !== "notReached" &&
        Number.isFinite(item.age)
    )
    .map(
      item => item.age
    );


  /*
    INCOMPLETE SENSITIVITY RANGE
  */

  if(validScenarioAges.length < 2){

    rangeEl.textContent =
      T.expectedText;

    return;
  }


  /*
    RANGE INCLUDING EXPECTED AGE
  */

  const lowAge =
    Math.min(
      ...validScenarioAges,
      expected.age
    );

  const highAge =
    Math.max(
      ...validScenarioAges,
      expected.age
    );


  /*
    PAINT THREE VALUES
  */

  minEl.textContent =
    formatAge(lowAge);

  maxEl.textContent =
    formatAge(highAge);


  /*
    EXPLANATORY TEXT
  */

  rangeEl.textContent =
    T.rangeText;

}

