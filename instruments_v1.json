      riskDot > 0
        ? `${riskDot} / 7`
        : "— / 7";

  }


  /*
    =========================
    METRICS

    Gross/net return and costs are
    portfolio-level nominal figures.

    No personal tax or inflation
    adjustment is applied here.
    =========================
  */

  const metricFields = {

    mReturn:
      pct(metrics.expRetGross, 2),

    mReturnNet:
      pct(metrics.expRetNet, 2),

    mRisk:
      pct(metrics.risk, 2),

    mCost:
      pct(metrics.costs, 2),

    mEquity:
      pct(metrics.equityWeight, 2),

    mBonds:
      pct(metrics.bondsWeight, 2),

    mAlternatives:
      pct(metrics.alternativesWeight, 2)

  };

  Object.entries(metricFields).forEach(
    ([id,value]) => {

      const el =
        document.getElementById(id);

      if(el){
        el.textContent = value;
      }

    }
  );


  /*
    =========================
    NET SHARPE RATIO

    Read from portfolio data only.
    Do not invent a risk-free rate.
    =========================
  */

  const sharpeNetRaw =
    metrics.sharpeRatioNet;

  const sharpeNet =
    sharpeNetRaw == null ||
    sharpeNetRaw === ""
      ? NaN
      : Number(sharpeNetRaw);

  const sharpeEl =
    document.getElementById("mSharpeNet");

  if(sharpeEl){

    sharpeEl.textContent =
      Number.isFinite(sharpeNet)
        ? sharpeNet.toFixed(2)
        : "—";

  }


  /*
    =========================
    HOLDINGS + HISTORY HEADERS
    =========================
  */

  const isDA =
    INIT.lang === "da";

  const phaseLabel =
    phase === "phase1"
      ? (
          isDA
            ? "Formueopbygning"
            : "Building Wealth"
        )
      : (
          isDA
            ? "Formueforbrug"
            : "Using Wealth"
        );

  const holdingsSub =
    document.getElementById("holdingsSub");

  if(holdingsSub){

    holdingsSub.textContent =
      phaseLabel +
      " · " +
      modelName;

  }

  const chartHeader =
    document.getElementById("chartHeader");

  if(chartHeader){

    chartHeader.textContent =
      modelName +
      (
        isDA
          ? " · historik"
          : " · history"
      );

  }


  /*
    =========================
    RENDER CONTENT
    =========================
  */

  renderHoldings(
    holdings
  );

  drawHistory(
    history
  );

}




