let ACCOUNT_PORTFOLIOS = [];



function initializeAccountPortfolioSelectors(rows = []){

  ACCOUNT_PORTFOLIOS =
    rows.filter(row =>
      row?.modelNo != null
    );


  /*
    UNIQUE ISSUERS — ALPHABETICAL
  */

  const issuers = [
    ...new Set(
      ACCOUNT_PORTFOLIOS
        .map(row => getAccountIssuer(row))
        .filter(Boolean)
    )
  ].sort((a,b) =>
    a.localeCompare(b)
  );


  /*
    POPULATE MODEL DROPDOWN
    FOR SELECTED ISSUER
  */

  function populateModels(phase){

    const issuerSelect =
      byId(phase + "Issuer");

    const modelSelect =
      byId(phase + "ModelNo");

    if(!issuerSelect || !modelSelect){
      return;
    }

    const issuer =
      issuerSelect.value;

    const models =
      ACCOUNT_PORTFOLIOS
        .filter(row =>
          getAccountIssuer(row) === issuer
        )
        .sort((a,b) =>
          String(a.modelLabel || "")
            .localeCompare(
              String(b.modelLabel || "")
            )
        );

    modelSelect.innerHTML = "";

    models.forEach(row => {

      const option =
        document.createElement("option");

      option.value =
        String(row.modelNo);

      option.textContent =
        row.modelLabel || "—";

      modelSelect.appendChild(option);

    });

    modelSelect.disabled =
      models.length === 0;

  }


  /*
    INITIALIZE BOTH PHASES
  */

  ["build", "use"].forEach(phase => {

    const issuerSelect =
      byId(phase + "Issuer");

    const modelSelect =
      byId(phase + "ModelNo");

    if(!issuerSelect || !modelSelect){
      return;
    }


    /*
      POPULATE ISSUERS
    */

    issuerSelect.innerHTML = "";

    issuers.forEach(issuer => {

      const option =
        document.createElement("option");

      option.value =
        issuer;

      option.textContent =
        issuer;

      issuerSelect.appendChild(option);

    });

    issuerSelect.disabled =
      issuers.length === 0;


    /*
      PHASE-SPECIFIC DEFAULT MODEL
    */

    const phaseKey =
      phase === "build"
        ? "phase1"
        : "phase2";

    const defaultModel =
      ACCOUNT_PORTFOLIOS.find(row =>
        String(row.modelNo) ===
        String(DEFAULT_MODELS[phaseKey])
      );



    /*
      SELECT DEFAULT ISSUER
    */

    if(defaultModel){

      issuerSelect.value =
        getAccountIssuer(defaultModel);

    }


    /*
      POPULATE MODELS FOR ISSUER
    */

    populateModels(phase);


    /*
      SELECT DEFAULT MODEL
    */

    if(defaultModel){

      modelSelect.value =
        String(defaultModel.modelNo);

    }


    /*
      ISSUER CHANGE
    */

    issuerSelect.onchange = () => {

      populateModels(phase);

      updateAccountSelectedModel(phase);

    };


    /*
      MODEL CHANGE
    */

    modelSelect.onchange = () => {

      updateAccountSelectedModel(phase);

    };


    /*
      INITIALIZE SELECTED MODEL
    */

    updateAccountSelectedModel(phase);

  });

}

