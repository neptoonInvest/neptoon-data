/* =====================================================
   4. LEGACY SLIDER
===================================================== */

function numberFromLegacyInput(value){

  const cleaned =
    String(value || "")
      .replace(/\s/g,"")
      .replace(/\./g,"")
      .replace(",",".");

  return Math.max(
    0,
    Number(cleaned) || 0
  );

}


function legacyLocale(){

  return document.documentElement.lang === "da"
    ? "da-DK"
    : "en-GB";

}





function paintLegacySlider(){

  const legacyInput =
    byId("legacy");

  const slider =
    byId("legacySlider");

  if(!legacyInput || !slider){
    return;
  }

  /*
    BASE LEGACY
  */

  const base =
    Math.max(
      0,
      numberFromLegacyInput(
        legacyInput.value
      )
    );

  const max =
    base * 2;

  /*
    SLIDER POSITION 0–100
  */

  const sliderPosition =
    clamp(
      Number(slider.value) || 0,
      0,
      100
    );

  /*
    EFFECTIVE LEGACY TARGET
  */

  const target =
    base +
    (
      base *
      sliderPosition / 100
    );

  /*
    UPDATE STATE
  */

  STATE.legacyBase =
    base;

  STATE.legacyTarget =
    target;

  /*
    SLIDER CONFIGURATION
  */

  slider.min = "0";
  slider.max = "100";
  slider.step = "1";

  slider.disabled =
    base <= 0;

  /*
    LABELS
  */

  const formatFullMoney = value =>
    Math.round(value).toLocaleString(
      INIT?.lang === "da"
        ? "da-DK"
        : "en-GB"
    );

  const minField =
    byId("legacySliderMin");

  const maxField =
    byId("legacySliderMax");

  const valueField =
    byId("legacySliderValue");

  if(minField){

    minField.textContent =
      "MIN " +
      formatFullMoney(base);

  }

  if(maxField){

    maxField.textContent =
      "MAX " +
      formatFullMoney(max);

  }

  if(valueField){

    valueField.textContent =
      formatFullMoney(target);

  }

}


function syncPerspective(){

  const root =
    document.getElementById("tabLifeCycle");

  if(!root){
    return;
  }

  const legacyBar =
    document.getElementById("legacyControlBar");

  const fireBar =
    root.querySelector(
      ".fireControlBar:not(.legacyControlBar)"
    );

  const isLegacy =
    root.dataset.perspective === "legacy";

  if(fireBar){
    fireBar.hidden = isLegacy;
  }

  if(legacyBar){
    legacyBar.hidden = !isLegacy;
  }

  paintLegacySlider();

}

