/* =====================================================
   WEALTHPLANS · SELECTED METRICS MODEL
===================================================== */

function getSelectedMetricsModel(){

  const index = APP.metricsPlan;

  if(
    !Number.isInteger(index) ||
    index < 0 ||
    index >= APP.planSlots.length
  ){
    return null;
  }

  const modelNo =
    APP.planSlots[index]?.modelNo;

  if(
    modelNo === null ||
    modelNo === undefined ||
    modelNo === ""
  ){
    return null;
  }

  return (PORTFOLIO_STATE.all || []).find(
    p => Number(p.modelNo) === Number(modelNo)
  ) || null;

}

/* =====================================================
   WEALTHPLANS · PORTFOLIO OVERVIEW
===================================================== */

function renderPlanMetrics(){

  const container =
    document.getElementById("plan-details");

  if(!container) return;

  const p = getSelectedMetricsModel();

  if(!p){
    container.innerHTML = "";
    return;
  }

  const m = p.objKeyFigures || {};

const riskDotsCount =
  dotsCountConverter(m.risk);

  const da = APP.lang === "da";

  /*
    ==========================================
    FORMATTERS
    ==========================================
  */

  const pct = (value, digits = 2) => {

    if(
      value === null ||
      value === undefined ||
      value === ""
    ){
      return "—";
    }

    const n = Number(value);

    return Number.isFinite(n)
      ? (n * 100).toFixed(digits) + "%"
      : "—";

  };

  const decimal = (value, digits = 2) => {

    if(
      value === null ||
      value === undefined ||
      value === ""
    ){
      return "—";
    }

    const n = Number(value);

    return Number.isFinite(n)
      ? n.toFixed(digits)
      : "—";

  };

  /*
    ==========================================
    ASSET ALLOCATION
    ==========================================
  */

  const allocation = [

    {
      key: "equity",
      label: da ? "Aktier" : "Equity",
      value: Number(m.equityWeight) || 0,
      color: "#315e9c"
    },

    {
      key: "bonds",
      label: da ? "Obligationer" : "Bonds",
      value: Number(m.bondsWeight) || 0,
      color: "#8aa9ce"
    },

    {
      key: "alternatives",
      label: da ? "Alternativer" : "Alternatives",
      value: Number(m.alternativesWeight) || 0,
      color: "#b8c7d9"
    }

  ];

  const allocationTotal =
    allocation.reduce(
      (sum, x) => sum + x.value,
      0
    );

  /*
    Single stocks are a subset of equity.
    They must not be added to the allocation bar,
    otherwise we would double-count them.
  */

  const singleStocks =
    Number(m.singleStocksWeight) || 0;

  /*
    ==========================================
    METRIC ITEMS
    ==========================================
  */

  const metrics = [

    {
      label: da
        ? "Forventet nettoafkast"
        : "Expected net return",

      value: pct(m.expRetNet)
    },

    {
      label: da
        ? "Risiko / volatilitet"
        : "Risk / volatility",

      value: pct(m.risk)
    },

    {
      label: da
        ? "Årlige omkostninger"
        : "Annual costs",

      value: pct(m.costs)
    },

    {
      label: da
        ? "Sharpe-ratio"
        : "Sharpe ratio",

      value: decimal(m.sharpeRatioNet)
    }

  ];

  /*
    ==========================================
    DESCRIPTION
    ==========================================
  */

  const description = da
    ? (
        p.descriptionLong ||
        p.descriptionLong_en ||
        ""
      )
    : (
        p.descriptionLong_en ||
        p.descriptionLong ||
        ""
      );

  const holdingCount =
    Array.isArray(p.arrayHoldings)
      ? p.arrayHoldings.length
      : 0;

  /*
    ==========================================
    HTML
    ==========================================
  */

  container.innerHTML = `

    <div class="details wealthplan-overview">

      <!-- HEADER -->

      <div class="detail-top">

        <div>

          <div class="kicker">
            ${
              da
                ? "PORTEFØLJEOVERSIGT"
                : "PORTFOLIO OVERVIEW"
            }
          </div>

          <h3>
            ${esc(p.modelLabel)}
          </h3>

        </div>

        <button
          type="button"
          class="icon-btn"
          data-close-plan-metrics
          aria-label="Close metrics"
        >
          ${icon("x")}
        </button>

      </div>


      <!-- MODEL INFORMATION -->

      <div class="detail-meta">

        <span>
          ${da ? "Udsteder" : "Issuer"}:
          <b>${esc(p.issuerName || "—")}</b>
        </span>

        <span>
          ${da ? "Beholdninger" : "Holdings"}:
          <b>${holdingCount}</b>
        </span>

        <span>
          ${da ? "Strategi" : "Strategy"}:
          <b>${esc(p.anchorStrategyId || "—")}</b>
        </span>

        <!-- RISK INDICATOR -->

        <span class="wealthplan-risk-indicator">

          <span>
            ${da ? "Risikoindikator" : "Risk indicator"}:
          </span>

          <span class="wealthplan-risk-dots">

            ${Array.from({length:7}, (_, i) => `

              <span
                class="dot ${i < riskDotsCount ? "on" : ""}"
              ></span>

            `).join("")}

          </span>

          <b>${riskDotsCount}/7</b>

        </span>

      </div>


      <!-- PRIMARY METRICS -->

      <div class="wealthplan-overview-metrics">

        ${metrics.map(item => `

          <div class="wealthplan-overview-metric">

            <div class="wealthplan-overview-label">
              ${item.label}
            </div>

            <div class="wealthplan-overview-value">
              ${item.value}
            </div>

          </div>

        `).join("")}

      </div>


      <!-- ASSET ALLOCATION -->

      <div class="wealthplan-allocation-heading">

        ${
          da
            ? "Aktivfordeling"
            : "Asset allocation"
        }

      </div>

      <div class="allocation wealthplan-allocation">

        ${allocation
          .filter(x => x.value > 0)
          .map(x => `

            <span
              style="
                width:${
                  allocationTotal > 0
                    ? (x.value / allocationTotal) * 100
                    : 0
                }%;
                background:${x.color};
              "
            ></span>

          `).join("")}

      </div>


      <!-- ALLOCATION LEGEND -->

      <div class="legend wealthplan-allocation-legend">

        ${allocation.map(x => `

          <span>

            <em
              style="background:${x.color}"
            ></em>

            ${x.label} ${pct(x.value, 0)}

          </span>

        `).join("")}

        <span>
          ${
            da
              ? "Enkeltaktier"
              : "Single stocks"
          }
          ${pct(singleStocks, 0)}
        </span>

      </div>


      <!-- DESCRIPTION -->

      ${description ? `

<div class="wealthplan-description">

  <button
    type="button"
    class="wealthplan-description-toggle"
    aria-expanded="false"
    onclick="
      const content = this.nextElementSibling;
      const expanded = this.getAttribute('aria-expanded') === 'true';

      content.hidden = expanded;
      this.setAttribute('aria-expanded', String(!expanded));

      this.querySelector('.toggle-label').textContent =
        expanded
          ? '${da ? "Læs mere" : "Read more"}'
          : '${da ? "Læs mindre" : "Read less"}';
    "
  >
    <span class="toggle-chevron">⌄</span>
    <span class="toggle-label">
      ${da ? "Læs mere" : "Read more"}
    </span>
  </button>

  <div class="wealthplan-description-content" hidden>
    ${esc(description)}
  </div>

</div>
      ` : ""}

    </div>

  `;

  icons();

}

/* =====================================================
   WEALTHPLANS · EXPECTED WEALTH
===================================================== */

function renderPlanExpectedWealth(){

  const container =
    document.getElementById(
      "plan-expected-wealth"
    );

  if(!container) return;

  const p = getSelectedMetricsModel();

  if(!p){
    container.innerHTML = "";
    return;
  }

  const m = p.objKeyFigures || {};

  const expRet =
    Number(m.expRetNet);

  const risk =
    Number(m.risk);

  if(
    !Number.isFinite(expRet) ||
    !Number.isFinite(risk) ||
    risk < 0
  ){
    container.innerHTML = "";
    return;
  }

  /*
    ==========================================
    FIXED COMPARISON ASSUMPTIONS
    ==========================================
  */

  const W0 = 100000;
  const horizon = 10;

  /*
    ==========================================
    EXISTING GBM ENGINE
    ==========================================
  */

  const result = calcWealthGBM({

    W0,
    savingsMonthly: 0,
    horizon,
    expRet,
    risk

  });

  if(!result){
    container.innerHTML = "";
    return;
  }

  /*
    IMPORTANT:
    These keys should match the result object
    already used by the Welcome statistics.
  */

const expected = Number(result.expectedWealth);
const median = Number(result.medianWealth);
const p10 = Number(result.q10);
const p90 = Number(result.q90);

  if(
    ![
      expected,
      median,
      p10,
      p90
    ].every(Number.isFinite)
  ){
    console.warn(
      "Unexpected GBM result structure",
      result
    );

    container.innerHTML = "";
    return;
  }

  const da = APP.lang === "da";

  const fmtMoney = value =>
    Math.round(value).toLocaleString(
      da ? "da-DK" : "en-US"
    );

  /*
    ==========================================
    OUTCOME RANGE POSITION
    ==========================================
  */

  const range =
    p90 - p10;

  const medianPosition =
    range > 0
      ? Math.max(
          0,
          Math.min(
            100,
            ((median - p10) / range) * 100
          )
        )
      : 50;

  /*
    ==========================================
    HTML
    ==========================================
  */

  container.innerHTML = `

    <div class="details wealthplan-expected-wealth">

      <!-- HEADER -->

      <div class="wealthplan-expected-header">

        <div>

          <div class="kicker">
            ${
              da
                ? "FORVENTET FORMUE"
                : "EXPECTED WEALTH"
            }
          </div>

          <h3>
            ${esc(p.modelLabel)}
          </h3>

          <div class="wealthplan-expected-subtitle">
            ${fmtMoney(W0)}
            ${
              da
                ? "investeret · 10 år"
                : "invested · 10 years"
            }
          </div>

        </div>

      </div>


      <!-- EXPECTED WEALTH -->

      <div class="wealthplan-expected-main">

        <div class="wealthplan-expected-label">
          ${
            da
              ? "Forventet formue"
              : "Expected wealth"
          }
        </div>

        <div class="wealthplan-expected-number">
          ${fmtMoney(expected)}
        </div>

      </div>


      <!-- OUTCOME RANGE -->

      <div class="wealthplan-range-heading">

        <span>
          ${
            da
              ? "10-årigt udfaldsinterval"
              : "10-year outcome range"
          }
        </span>

        <span>P10–P90</span>

      </div>


      <div class="wealthplan-range-track">

        <div
          class="wealthplan-range-fill"
          style="width:${medianPosition}%"
        ></div>

      </div>


      <!-- DISTRIBUTION STATISTICS -->

      <div class="wealthplan-range-values">

        <div>

          <span>P10</span>

          <strong>
            ${fmtMoney(p10)}
          </strong>

        </div>

        <div>

          <span>
            ${da ? "Median" : "Median"}
          </span>

          <strong>
            ${fmtMoney(median)}
          </strong>

        </div>

        <div>

          <span>P90</span>

          <strong>
            ${fmtMoney(p90)}
          </strong>

        </div>

      </div>

    </div>

  `;

}

function bindPortfolioSelectors(){

  const basket =
    document.getElementById("portfolios-basket");

  if(!basket) return;

  // Prevent duplicate event listeners.
  if(basket.dataset.selectorsBound === "true"){
    return;
  }

  basket.dataset.selectorsBound = "true";

  basket.addEventListener("change", e => {

    const target = e.target;

    /*
      ==========================================
      1 · INVESTMENT PREFERENCE
      ==========================================
    */

    if(target.matches("[data-plan-risk]")){

      const i =
        Number(target.dataset.planRisk);

      const preference =
        target.value;

      if(
        !APP.planSlots[i] ||
        !INVESTMENT_PREFERENCES[preference]
      ){
        return;
      }

      APP.planSlots[i].preference =
        preference;

      // Clear previous investment model.
      APP.planSlots[i].modelNo = "";

      APP.expandedPlan = null;
      APP.metricsPlan = null;

      renderPortfolios();

      console.log(
        "INVESTMENT PREFERENCE CHANGED",
        i,
        preference
      );

      return;
    }


    /*
      ==========================================
      2 · INVESTMENT MODEL
      ==========================================
    */

    if(target.matches("[data-plan-select]")){

      const i =
        Number(target.dataset.planSelect);

      if(!APP.planSlots[i]){
        return;
      }

      const modelNo =
        target.value;

      APP.planSlots[i].modelNo =
        modelNo === ""
          ? ""
          : Number(modelNo);

      APP.expandedPlan = null;
      APP.metricsPlan = null;

      renderPortfolios();

      console.log(
        "INVESTMENT MODEL CHANGED",
        i,
        APP.planSlots[i].modelNo
      );

      return;
    }

  });

}

