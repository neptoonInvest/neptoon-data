  );

  button.textContent =
    `${T.view} (${holdings.length}) ▾`;

  content.innerHTML = "";

  if(!holdings.length){
    return;
  }

  /*
    CREATE TABLE
  */

  const table =
    document.createElement("table");

  table.className =
    "accountHoldingsTable";

  const thead =
    document.createElement("thead");

  const headerRow =
    document.createElement("tr");

  [
    T.instrument,
    T.assetClass,
    T.isin,
    T.weight
  ].forEach(label => {

    const th =
      document.createElement("th");

    th.textContent = label;

    headerRow.appendChild(th);

  });

  thead.appendChild(headerRow);
  table.appendChild(thead);

  const tbody =
    document.createElement("tbody");

  /*
    HOLDING ROWS
  */

  holdings.forEach(holding => {

    const tr =
      document.createElement("tr");

    const instrumentName =
      holding.instrumentName || "—";

    const ticker =
      holding.tickerExchange ||
      holding.ticker ||
      "—";

    const typeLabel =
      isDA
        ? holding.type_label_dk
        : holding.type_label_eng;

    const classMajor =
      isDA
        ? holding.classMajorTop
        : holding.class_major_top_eng;

    const isin =
      holding.isin || "—";

    const ccy =
      holding.ccy || "—";

    const weight =
      Number(holding.weight) || 0;

    /*
      INSTRUMENT + SUBMETA
    */

    const instrumentCell =
      document.createElement("td");

    const name =
      document.createElement("div");

    name.className =
      "accountHoldingName";

    name.textContent =
      instrumentName;

    const subMeta =
      document.createElement("div");

    subMeta.className =
      "accountHoldingSubMeta";

    subMeta.textContent =
      [ticker, typeLabel, ccy]
        .filter(Boolean)
        .join(" · ");

    instrumentCell.appendChild(name);
    instrumentCell.appendChild(subMeta);

    tr.appendChild(instrumentCell);

    /*
      ASSET CLASS, ISIN, WEIGHT
    */

    [
      classMajor || "—",
      isin,
      `${(weight * 100).toFixed(1)}%`
    ].forEach((value,index) => {

      const td =
        document.createElement("td");

      td.textContent = value;

      if(index === 2){
        td.className =
          "accountHoldingWeight";
      }

      tr.appendChild(td);

    });

    tbody.appendChild(tr);

  });

  table.appendChild(tbody);
  content.appendChild(table);

  /*
    EXPAND / COLLAPSE
  */

  button.onclick = () => {

    const opening =
      panel.hidden;

    panel.hidden =
      !opening;

    button.setAttribute(
      "aria-expanded",
      String(opening)
    );

    button.textContent =
      `${T.view} (${holdings.length}) ${opening ? "▴" : "▾"}`;

  };

}

function getAccountIssuer(row){

  const modelNo =
    Number(row?.modelNo);

  if(
    Number.isInteger(modelNo) &&
    modelNo >= 0 &&
    modelNo <= 7
  ){
    return "NEPTOON WEALTH";
  }

  return row?.issuerName || row?.issuer || "";

}


