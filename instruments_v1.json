async function initAssetHistoryViewer(){

  if(!ASSET_HISTORY_VIEW.initialized){

    ASSET_HISTORY_VIEW.initialized = true;

    document.addEventListener("click", e => {

      /* ============================================
         PERIOD SELECTOR · ASSETS ONLY
      ============================================ */

      const periodButton =
        e.target.closest(
          "#assetHistorySection [data-history-period]"
        );

      if(periodButton){

        ASSET_HISTORY_VIEW.period =
          periodButton.dataset.historyPeriod;

        document.querySelectorAll(
          "#assetHistorySection [data-history-period]"
        ).forEach(btn => {

          btn.classList.toggle(
            "active",
            btn === periodButton
          );

        });

        renderAssetHistory();
        return;

      }


      /* ============================================
         RESULT ROW HIGHLIGHT · ASSETS ONLY
      ============================================ */

      const row =
        e.target.closest(
          "#assetHistorySection [data-history-highlight]"
        );

      if(row){

        const ticker =
          row.dataset.historyHighlight;

        ASSET_HISTORY_VIEW.highlighted =
          ASSET_HISTORY_VIEW.highlighted === ticker
            ? null
            : ticker;

        renderAssetHistory();
        return;

      }

    });


    /* ============================================
       CHART RESIZE OBSERVER
    ============================================ */

    const chart =
      document.getElementById("assetHistoryChart");

    if(chart && "ResizeObserver" in window){

      ASSET_HISTORY_VIEW.resizeObserver =
        new ResizeObserver(() => {

          renderAssetHistory();

        });

      ASSET_HISTORY_VIEW.resizeObserver.observe(chart);

    }

  }


  /* ================================================
     LOAD HISTORY + INITIAL RENDER
  ================================================ */

  await loadInstrumentHistory();

  renderAssetHistory();

}


/* =====================================================
   WEALTHPLANS · PERFORMANCE RESULTS
===================================================== */

function renderPlanHistoryResults(series){

  const container =
    document.getElementById("planHistoryResults");

  if(!container) return;

  if(!series.length){

    container.innerHTML =
      '<div style="padding:20px;color:#64748b;font-size:12px;">No historical data available.</div>';

    return;

  }

  const formatReturn = value => {

    if(!Number.isFinite(value)) return "—";

    const pct = value * 100;

    return (
      (pct > 0 ? "+" : "") +
      pct.toFixed(1) +
      "%"
    );

  };

  container.innerHTML = series.map(s => {

    const muted =
      PLAN_HISTORY_VIEW.highlighted &&
      PLAN_HISTORY_VIEW.highlighted !== s.ticker;

    const highlighted =
      PLAN_HISTORY_VIEW.highlighted === s.ticker;

    return `
      <div
        class="asset-history-result-row
          ${muted ? "is-muted" : ""}
          ${highlighted ? "is-highlighted" : ""}"
        data-plan-history-highlight="${esc(s.ticker)}"
        style="cursor:pointer"
      >

        <div class="asset-history-result-instrument">

          <span
            class="asset-history-color"
            style="background:${s.color}"
          ></span>

          <div class="asset-history-result-identity">

            <div class="asset-history-result-ticker">
              ${esc(s.ticker)}
            </div>

            <div class="asset-history-result-name">
              ${esc(s.name)}
            </div>

          </div>

        </div>

        <div class="asset-history-result-total">
          ${formatReturn(s.totalReturn)}
        </div>

        <div class="asset-history-result-annual">
          ${formatReturn(s.annualReturn)}
        </div>

      </div>
    `;

  }).join("");

}


