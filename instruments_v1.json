/* =========================================
   BALANCE SHEET — UNIFIED ASSET GRID
========================================= */

.optionalComponent .componentRow {
  display: grid;
  grid-template-columns:
    minmax(240px, 2.2fr)
    repeat(5, minmax(0, 1fr));

  column-gap: 8px;
  align-items: end;
}

/* Asset identity */

.optionalComponent .componentIdentity {
  grid-column: 1;
  min-width: 0;
}

/* Input fields */

.optionalComponent .miniField {
  min-width: 0;
  width: 100%;
}

/* Consistent labels */

.optionalComponent .miniField label {
  display: block;
  white-space: nowrap;
  font-size: 11px;
  margin-bottom: 4px;
}

/* Consistent input sizes */

.optionalComponent .miniField input,
.optionalComponent .miniField select {
  box-sizing: border-box;
  display: block;
  width: 100%;
  min-width: 0;
  height: 32px;
  margin: 0;
  text-align: right;
}

/* Disabled calculated fields */

.optionalComponent .miniField input:disabled {
  text-align: right;
}


/* =========================================
   BALANCE SHEET — ASSET ROW GRID ONLY
   Does not affect liabilities
========================================= */

#optionalComponents > .optionalComponent > .componentRow {
  display: grid;
  grid-template-columns:
    minmax(220px, 2.2fr)
    repeat(4, minmax(0, 1fr));

  column-gap: 8px;
  align-items: end;
}

/* Identity column */

#optionalComponents > .optionalComponent
.componentIdentity {
  grid-column: 1;
  min-width: 0;
}

/* Uniform field cells */

#optionalComponents > .optionalComponent
.miniField {
  min-width: 0;
  width: 100%;
}

/* Labels */

#optionalComponents > .optionalComponent
.miniField label {
  display: block;
  margin-bottom: 5px;
  font-size: 11px;
  line-height: 1.2;
  white-space: normal;
  overflow-wrap: anywhere;
}

/* Inputs */

#optionalComponents > .optionalComponent
.miniField input,
#optionalComponents > .optionalComponent
.miniField select {
  box-sizing: border-box;
  display: block;
  width: 100%;
  min-width: 0;
  height: 32px;
  margin: 0;
  text-align: right;
}

/* =========================================
   ASSET FIELD POSITIONS
========================================= */

/* Column 2 — current value / monthly pension */

#optionalComponents .miniField:has(
  #houseValue,
  #enterpriseValue,
  #privatePensionValue,
  #publicPension,
  #heritageValueToday,
  #otherValueToday
) {
  grid-column: 2;
}

/* Column 3 — contributions / future values */

#optionalComponents .miniField:has(
  #privatePensionContribution,
  #heritageAmount,
  #otherAmount
) {
  grid-column: 3;
}

/* Column 4 — age */

#optionalComponents .miniField:has(
  #houseLiquidationAge,
  #enterpriseLiquidationAge,
  #privatePensionLiquidationAge,
  #publicPensionAge,
  #heritageAge,
  #otherAge
) {
  grid-column: 4;
}

/* Column 5 — calculated growth / return */

#optionalComponents .miniField:has(
  #publicPensionGrowth,
  #heritageImpliedReturn,
  #otherImpliedReturn
) {
  grid-column: 5;
}

/* =========================================
   BALANCE SHEET — UNIFORM FIELD GEOMETRY
   ASSETS ONLY — LIABILITIES UNTOUCHED
========================================= */

#optionalComponents > .optionalComponent > .componentRow {
  grid-template-columns:
    minmax(240px, 2.2fr)
    repeat(4, minmax(0, 1fr));
}

/* Make every input field fill its grid cell */

#optionalComponents > .optionalComponent > .componentRow > .miniField {
  width: 100%;
  min-width: 0;
  max-width: none;
  justify-self: stretch;
}

/* Make every input fill its field */

#optionalComponents > .optionalComponent > .componentRow > .miniField > input,
#optionalComponents > .optionalComponent > .componentRow > .miniField > select {
  width: 100%;
  max-width: none;
  min-width: 0;
  box-sizing: border-box;
}


/* =========================================
   PRIVATE PENSION — GRID ALIGNMENT FIX
   No effect on liabilities or other assets
========================================= */

#optionalComponents
> .optionalComponent
> .privatePensionRow {
  display: grid;
  grid-template-columns:
    minmax(240px, 2.2fr)
    repeat(4, minmax(0, 1fr));
}

/* Value today */

#optionalComponents
.privatePensionRow
.miniField:has(#privatePensionValue) {
  grid-column: 2;
}

/* Monthly contribution */

#optionalComponents
.privatePensionRow
.miniField:has(#privatePensionContribution) {
  grid-column: 3;
}

/* Liquidation age */

#optionalComponents
.privatePensionRow
.miniField:has(#privatePensionLiquidationAge) {
  grid-column: 4;
}

/* Uniform widths */

#optionalComponents
.privatePensionRow
.miniField {
  width: 100%;
  min-width: 0;
  max-width: none;
}

#optionalComponents
.privatePensionRow
.miniField input {
  width: 100%;
  min-width: 0;
  max-width: none;
  box-sizing: border-box;
}

/* =========================================
   BALANCE SHEET — UNIFIED ASSET LAYOUT
   Liabilities remain untouched
========================================= */

#optionalComponents > .optionalComponent > .componentRow {
  display: grid;
  grid-template-columns:
    minmax(240px, 2.2fr)
    repeat(4, minmax(0, 1fr));
  column-gap: 8px;
  align-items: end;
}

/* Identity always occupies first column */

#optionalComponents > .optionalComponent > .componentRow > .componentIdentity {
  grid-column: 1;
  min-width: 0;
}

/* Fields follow consecutively */

#optionalComponents > .optionalComponent > .componentRow > .miniField {
  grid-column: auto;
  width: 100%;
  min-width: 0;
  max-width: none;
  justify-self: stretch;
}

/* Identical input geometry */

#optionalComponents > .optionalComponent > .componentRow > .miniField input,
#optionalComponents > .optionalComponent > .componentRow > .miniField select {
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  max-width: none;
  height: 32px;
  margin: 0;
  text-align: right;
}

/* Labels */

#optionalComponents > .optionalComponent > .componentRow > .miniField label {
  display: block;
  margin-bottom: 5px;
  font-size: 11px;
  line-height: 1.2;
  white-space: normal;
}


/* =========================================
   BALANCE SHEET — RIGHT-ALIGNED ASSET FIELDS
   Liabilities untouched
========================================= */

/* Two-field rows: columns 4–5 */

#optionalComponents > .optionalComponent
.realEstateRow > .miniField:first-of-type,
#optionalComponents > .optionalComponent
.enterpriseRow > .miniField:first-of-type {
  grid-column: 4 !important;
}

/* Three-field rows: columns 3–5 */

#optionalComponents > .optionalComponent
.privatePensionRow > .miniField:nth-child(2),
#optionalComponents > .optionalComponent
.pension > .miniField:nth-child(2) {
  grid-column: 3 !important;
}

/* Remaining fields flow into subsequent columns */

#optionalComponents > .optionalComponent
.componentRow > .miniField {
  grid-row: 1;
}

#optionalComponents > .optionalComponent
.realEstateRow > .miniField:nth-child(2),
#optionalComponents > .optionalComponent
.enterpriseRow > .miniField:nth-child(2) {
  grid-column: 4 !important;
}
  
  
/* =========================================
   REAL ESTATE + ENTERPRISE — FINAL ALIGNMENT
   Two fields in the two rightmost columns
========================================= */

/* Value today → column 4 */

#optionalComponents > .optionalComponent
> .realEstateRow > .miniField:nth-child(2),

#optionalComponents > .optionalComponent
> .enterpriseRow > .miniField:nth-child(2) {
  grid-column: 4 !important;
  grid-row: 1 !important;
}

/* Liquidation age → column 5 */

#optionalComponents > .optionalComponent
> .realEstateRow > .miniField:nth-child(3),

#optionalComponents > .optionalComponent
> .enterpriseRow > .miniField:nth-child(3) {
  grid-column: 5 !important;
  grid-row: 1 !important;
}

  
/* =========================================
   BALANCE SHEET — LABEL / INPUT SPACING
   Assets only — liabilities untouched
========================================= */

#optionalComponents > .optionalComponent
> .componentRow > .miniField label {
  margin-top: 0 !important;
  margin-bottom: 2px !important;
  line-height: 1.1;
}

#optionalComponents > .optionalComponent
> .componentRow > .miniField {
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  gap: 0 !important;
}
  
  
/* ASSET FIELDS — REMOVE VERTICAL SEPARATION */

#optionalComponents > .optionalComponent
> .componentRow > .miniField {
  display: flex !important;
  flex-direction: column !important;
  justify-content: flex-end !important;
  align-items: stretch !important;
  gap: 2px !important;
}

#optionalComponents > .optionalComponent
> .componentRow > .miniField > label {
  margin: 0 !important;
  padding: 0 !important;
  line-height: 1 !important;
}

#optionalComponents > .optionalComponent
> .componentRow > .miniField > input {
  margin: 0 !important;
}


  /* =========================================
   BALANCE SHEET — ASSET LABEL SPACING
   Liabilities untouched
========================================= */

#optionalComponents > .optionalComponent
> .componentRow > .miniField > label {
  min-height: 0 !important;
  height: auto !important;
  margin: 0 0 3px 0 !important;
  padding: 0 !important;
  line-height: 1.2;
}
