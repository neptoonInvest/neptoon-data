/* =================================================
   ASSET ROWS — FIVE COLUMN LAYOUT
   Real Estate / Enterprise / Private Pension
================================================= */

.componentRow.realEstateRow,
.componentRow.enterpriseRow,
.componentRow.privatePensionRow {
  display: grid;

  grid-template-columns:
    minmax(180px, 1fr)
    minmax(95px, 125px)
    minmax(105px, 135px)
    minmax(90px, 115px)
    minmax(75px, 95px);

  gap: 10px;
  align-items: center;
}

/* FIELDS */

.realEstateRow .miniField,
.enterpriseRow .miniField,
.privatePensionRow .miniField {
  min-width: 0;
}

/* INPUTS AND SELECTORS */

.realEstateRow .miniField input,
.realEstateRow .miniField select,
.enterpriseRow .miniField input,
.enterpriseRow .miniField select,
.privatePensionRow .miniField input,
.privatePensionRow .miniField select {
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  height: 31px;
}

/* DROPDOWNS */

.realEstateRow .miniField select,
.enterpriseRow .miniField select,
.privatePensionRow .miniField select {
  padding: 4px 6px;
  background: #fff;
  cursor: pointer;
}

/* PENSION PAL NOTE */

.pensionTaxNote {
  margin-top: 4px;
  font-family: Arial, sans-serif;
  font-size: 9px;
  line-height: 1.3;
  color: #64748b;
}

/* =================================================
   RESPONSIVE
================================================= */

@media (max-width: 750px) {

  .componentRow.realEstateRow,
  .componentRow.enterpriseRow,
  .componentRow.privatePensionRow {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .realEstateRow .componentIdentity,
  .enterpriseRow .componentIdentity,
  .privatePensionRow .componentIdentity {
    grid-column: 1 / -1;
  }

}



/* ============================================
   PRIVATE PENSION — COMPACT SINGLE ROW
============================================ */

.componentRow.privatePensionRow{
  display:grid;
  grid-template-columns:
    minmax(150px, 1fr)
    105px
    115px
    135px
    105px
    115px;

  column-gap:10px;
  row-gap:0;
  align-items:start;
  width:100%;
  box-sizing:border-box;
}

.privatePensionRow .componentIdentity,
.privatePensionRow .miniField{
  min-width:0;
  width:100%;
}

.privatePensionRow .miniField input,
.privatePensionRow .miniField select{
  width:100%;
  min-width:0;
  box-sizing:border-box;
}

.privatePensionRow .miniField label{
  display:block;
  font-size:10px;
  white-space:nowrap;
}

.privatePensionRow .pensionTaxNote{
  margin-top:5px;
  font-size:9px;
  line-height:1.25;
  color:#7b8492;
}

/* Responsive layout */
@media(max-width:760px){
  .componentRow.privatePensionRow{
    grid-template-columns:repeat(2,minmax(0,1fr));
    row-gap:12px;
  }

  .privatePensionRow .componentIdentity{
    grid-column:1 / -1;
  }
}

@media(max-width:480px){
  .componentRow.privatePensionRow{
    grid-template-columns:minmax(0,1fr);
  }
}


/* ============================================
   PRIVATE PENSION — FORCE SIX COLUMNS
============================================ */



.componentRow.privatePensionRow > *{
  min-width:0;
  width:auto;
  max-width:none;
  grid-column:auto !important;
  grid-row:auto !important;
  flex:none;
}

.privatePensionRow .miniField input,
.privatePensionRow .miniField select{
  display:block;
  width:100%;
  min-width:0;
  box-sizing:border-box;
}

.privatePensionRow .miniField label{
  display:block;
  font-size:9px;
  white-space:nowrap;
}

.privatePensionRow .pensionTaxNote{
  margin-top:5px;
  font-size:9px;
  line-height:1.2;
  color:#7b8492;
}

/* Responsive */
@media(max-width:760px){
  .componentRow.privatePensionRow{
    grid-template-columns:repeat(2,minmax(0,1fr)) !important;
  }
}






/* =========================================
   LIFE CYCLE FAQ — GROUP ACCORDION
========================================= */

.lifeFAQGroups{
  display:flex;
  flex-direction:column;
  gap:10px;
}

.lifeFAQGroup{
  border:1px solid #dce4ee;
  background:#fff;
}

.lifeFAQGroupSummary{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:16px;
  padding:17px 20px;
