function bindMyWealthComparisonToggle(){

  const marketBtn =
    document.getElementById(
      "mywealth-history-method-market"
    );

  const jensenBtn =
    document.getElementById(
      "mywealth-history-jensen"
    );

  /*
    ==========================================
    SYNC BUTTON VISUAL STATE
    ==========================================
  */

  function syncButtons(){

    const isMarket =
      comparisonMethod === "market";

    const isJensen =
      comparisonMethod === "jensen";

    marketBtn?.classList.toggle(
      "active",
      isMarket
    );

    marketBtn?.setAttribute(
      "aria-pressed",
      String(isMarket)
    );

    jensenBtn?.classList.toggle(
      "active",
      isJensen
    );

    jensenBtn?.setAttribute(
      "aria-pressed",
      String(isJensen)
    );

  }

  /*
    ==========================================
    CHANGE METHOD ONLY
    ==========================================
  */

  function changeMethod(method){

    if(
      method === "jensen" &&
      myWealthMode !== "stocks"
    ){
      return;
    }

    comparisonMethod = method;

    syncMyWealthComparisonMode();

    syncButtons();

    // Cinema is NOT started here.
    // User must click Play.

  }

  /*
    ==========================================
    EVENT BINDINGS
    ==========================================
  */

  marketBtn?.addEventListener(
    "click",
    () => changeMethod("market")
  );

  jensenBtn?.addEventListener(
