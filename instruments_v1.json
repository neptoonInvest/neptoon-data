<!DOCTYPE html>

<html lang="en"><head><meta charset="utf-8"/><meta content="width=device-width,initial-scale=1" name="viewport"/><title>Neptoon Life Cycle</title><style>
/* ORIGINAL NEPTOON LIFE CYCLE CSS — PRESERVED */

:root{
  --blue:#4E79BD;
  --ink:#0f1b2c;
  --muted:#667085;
  --line:#d8dee8;
  --soft:#f5f7fa;
  --softBlue:#eef4fb;
  --red:#d64242;
}

*{box-sizing:border-box}

html,body{
  margin:0;
  padding:0;
  background:#f3f5f8;
  color:var(--ink);
  font-family:Arial,Helvetica,sans-serif;
}

body{
  padding:26px 18px 44px;
}

.page{
  width:min(1240px,100%);
  margin:0 auto;
}

.hero,
.panel,
.lifecyclePanel{
  background:#fff;
  border:1px solid var(--line);
  border-radius:0;
}

.hero{
  padding:30px 34px 28px;
  margin-bottom:16px;
}

.heroKicker,
.sectionNo,
.resultKicker,
.riskTitle,
.fireControlTitle{
  font-size:11px;
  font-weight:700;
  letter-spacing:.13em;
  color:var(--blue);
}



.heroTitle{
  margin:7px 0 8px;
  font-family:"Times New Roman",serif;
  font-size:34px;
  line-height:1.05;
  font-weight:400;
}

.heroSub{
  max-width:760px;
  font-family:"Times New Roman",serif;
  font-size:17px;
  line-height:1.45;
  color:#475569;
}

.panel{
  padding:22px 24px;
  margin-bottom:16px;
}

.panelHead,
.resultTop{
  display:flex;
  justify-content:space-between;
  gap:20px;
  align-items:flex-start;
}

.sectionTitle,
.resultTitle{
  margin-top:4px;
  font-family:"Times New Roman",serif;
  font-size:23px;
}

.sectionHint{
  margin-top:4px;
  font-size:12px;
  color:var(--muted);
}

.scenarioGrid{
  display:grid;
  grid-template-columns:repeat(6,minmax(0,1fr));
  gap:12px;
  margin-top:18px;
}

.scenarioField label,
.miniField label,
.assumptionField label{
  display:block;
  min-height:28px;
  margin-bottom:5px;
  font-size:11px;
  line-height:1.25;
  color:#475569;
}

input{
  width:100%;
  height:34px;
  border:1px solid #cfd6df;
  border-radius:0;
  background:#fff;
  color:var(--ink);
  padding:6px 8px;
  outline:none;
}

input:focus{
  border-color:var(--blue);
  box-shadow:0 0 0 1px var(--blue);
}

.componentPicker{
  display:flex;
  flex-wrap:wrap;
  gap:7px;
  margin-top:18px;
}

.componentBtn,
.assumptionToggle,
.chartExportBtn{
  border:1px solid #c8d0da;
  border-radius:0;
  background:#fff;
  color:#334155;
  padding:8px 11px;
  font-size:12px;
  cursor:pointer;
}

.componentBtn.active{
  border-color:var(--blue);
  color:var(--blue);
  background:var(--softBlue);
}

.optionalComponents{
  margin-top:12px;
}

.optionalComponent{
  border-top:1px solid #e4e8ee;
  padding:13px 0 2px;
}

.mortgageOverlay{
  margin:14px 0 4px;
  padding:14px;
  border:1px solid #dbe1e9;
  background:#fafbfd;
}
.mortgageHead{display:flex;justify-content:space-between;gap:18px;align-items:center;margin-bottom:12px}
.mortgageTitle{font-family:"Times New Roman",serif;font-size:16px}
.mortgageHint{margin-top:2px;font-size:10px;color:var(--muted)}
.mortgageToggle{display:flex;align-items:center;gap:7px;font-size:11px;color:#475569}
.mortgageToggle input{width:auto;height:auto}
.mortgageGrid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px}


.mortgageField label{
  display:block;
  min-height:0;
  margin-bottom:3px;
  font-size:10px;
  line-height:1.25;
  color:#475569;
}



.mortgageField select{width:100%;height:34px;border:1px solid #cfd6df;border-radius:0;background:#fff;color:var(--ink);padding:6px 8px;outline:none}
.mortgageStatus{margin-top:9px;font-size:10px;color:#667085}

.componentRow,
.componentRow.future,
.componentRow.pension{
  display:grid;
  grid-template-columns:minmax(260px,1fr) 150px 150px 150px;
  gap:12px;
  align-items:end;
}

.componentIdentity{
  grid-column:auto;
  align-self:center;
}

.componentName{
  font-family:"Times New Roman",serif;
  font-size:17px;
color: #4E79BD;
}

.componentDescription{
  margin-top:2px;
  font-size:11px;
  color:var(--muted);
}

.lifecyclePanel{
  padding:24px;
  margin-bottom:16px;
}

.freedomBox{
  text-align:right;
  min-width:270px;
}

.freedomLabel{
  font-size:11px;
  color:var(--muted);
}

.freedomAge{
  margin-top:2px;
  font-family:"Times New Roman",serif;
  font-size:38px;
  line-height:1;
  color:var(--blue);
}

.freedomRange{
  margin-top:5px;
  font-size:11px;
  color:var(--muted);
}

.riskArea{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:18px;
  margin-top:22px;
  padding:14px 0;
  border-top:1px solid #e3e7ed;
  border-bottom:1px solid #e3e7ed;
}

.riskBlock{
  display:flex;
  justify-content:space-between;
  gap:18px;
  align-items:center;
}

.riskReturn{
  margin-top:3px;
  font-family:"Times New Roman",serif;
  font-size:13px;
  color:#475569;
}

.riskSelector{
  display:flex;
  align-items:center;
  gap:7px;
}

.riskWord{
  font-size:10px;
  color:#7b8798;
}

.riskDots{
  display:flex;
  gap:5px;
}

.riskDot{
  width:12px;
  height:12px;
  padding:0;
  border:1px solid #aab4c2;
  border-radius:50%;
  background:#fff;
  cursor:pointer;
}

.riskDot.active{
  background:var(--red);
  border-color:var(--red);
}


.chartSection{
  margin-top:14px;
}

.fireControlBar{
  display:grid;
  grid-template-columns:minmax(260px,.8fr) minmax(420px,1.2fr);
  gap:26px;
  align-items:center;
  padding:12px 14px;
  border:1px solid #dbe1e9;
  background:#fafbfd;
}

.fireControlSub{
  margin-top:3px;
  font-size:11px;
  color:var(--muted);
}

.fireSliderBox{
  min-width:0;
}

.fireSliderMeta{
  display:grid;
  grid-template-columns:1fr auto 1fr;
  align-items:center;
  gap:10px;
  margin-bottom:6px;
  font-size:10px;
  color:#7b8798;
}

.fireSliderMeta strong{
  font-family:"Times New Roman",serif;
  font-size:18px;
  font-weight:400;
  color:var(--blue);
}

.fireSliderMeta span:last-child{
  text-align:right;
}

.fireSlider{
  width:100%;
  height:18px;
  padding:0;
  border:0;
  box-shadow:none;
  accent-color:var(--blue);
}

.chartWrap{
  position:relative;
  height:530px;
  margin-top:10px;
  border:1px solid #dbe1e9;
  background:#fff;
}

#lifeChart{
  width:100%;
  height:100%;
  display:block;
}

.chartMessage{
  position:absolute;
  inset:0;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:40px;
  text-align:center;
  pointer-events:none;
  font-family:"Times New Roman",serif;
  font-size:18px;
  color:#64748b;
}

.chartExportBar{
  display:flex;
  justify-content:space-between;
  gap:18px;
  align-items:center;
  padding:12px 14px;
  border:1px solid #dbe1e9;
  border-top:0;
}

.chartExportText{
  display:flex;
  flex-direction:column;
  gap:2px;
  font-size:11px;
  color:var(--muted);
}

.chartExportText strong{
  color:#334155;
}

.chartExportBtn{
  border-color:var(--red);
  color:var(--red);
}

.metrics{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  border:1px solid #dbe1e9;
  border-top:0;
}

.metric{
  padding:14px;
  border-right:1px solid #e2e7ed;
}

.metric:last-child{
  border-right:0;
}

.metricLabel{
  font-size:10px;
  text-transform:uppercase;
  letter-spacing:.08em;
  color:#7b8798;
}

.metricValue{
  margin-top:4px;
  font-family:"Times New Roman",serif;
  font-size:24px;
  color:var(--ink);
}

.metricSub{
  margin-top:2px;
  font-size:10px;
  color:#94a0ae;
}

.modelNote{
  margin-top:10px;
  font-family:"Times New Roman",serif;
  font-size:12px;
  line-height:1.4;
  color:#667085;
}

.assumptionToggle{
  min-width:125px;
}

.assumptionGrid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:14px;
  margin-top:18px;
}

.taxField{
  grid-column:span 2;
}

.taxOptions{
  display:flex;
  min-height:34px;
  align-items:center;
  gap:8px;
  flex-wrap:wrap;
}

.taxOption{
  min-height:0 !important;
  display:flex !important;
  align-items:center;
  gap:3px;
  margin:0 !important;
}

.taxOption input{
  width:auto;
  height:auto;
}

.lifeCycleToast{
  position:fixed;
  right:22px;
  bottom:22px;
  z-index:1000;
  width:min(390px,calc(100vw - 44px));
  padding:13px 15px;
  border:1px solid var(--blue);
  background:#fff;
  box-shadow:0 10px 28px rgba(15,27,44,.15);
  opacity:0;
  transform:translateY(8px);
  transition:opacity .18s ease,transform .18s ease;
}

.lifeCycleToast.show{
  opacity:1;
  transform:translateY(0);
}

.lifeCycleToastTitle{
  font-family:"Times New Roman",serif;
  font-size:17px;
  color:var(--blue);
}

.lifeCycleToastText{
  margin-top:3px;
  font-size:11px;
  line-height:1.4;
  color:#596579;
}

@media(max-width:950px){
  .scenarioGrid{
    grid-template-columns:repeat(3,1fr);
  }

  .componentRow,
  .componentRow.future,
  .componentRow.pension{
    grid-template-columns:minmax(220px,1fr) 140px 140px;
  }

  .componentIdentity{
    grid-column:1 / -1;
  }

  .fireControlBar{
    grid-template-columns:1fr;
    gap:10px;
  }

  .mortgageGrid{
    grid-template-columns:repeat(3,1fr);
  }
}

@media(max-width:700px){
  body{
    padding:10px;
  }

  .hero,
  .panel,
  .lifecyclePanel{
    padding:17px;
  }

  .scenarioGrid,
  .riskArea,
  .metrics,
  .assumptionGrid{
    grid-template-columns:1fr 1fr;
  }

  .componentRow,
  .componentRow.future,
  .componentRow.pension{
    grid-template-columns:1fr 1fr;
  }

  .componentIdentity{
    grid-column:1 / -1;
  }

  .resultTop{
    flex-direction:column;
  }

  .freedomBox{
    text-align:left;
    min-width:0;
  }

  .riskBlock{
    align-items:flex-start;
    flex-direction:column;
  }

  .chartWrap{
    height:430px;
  }

  .taxField{
    grid-column:1 / -1;
  }

  .mortgageGrid{
    grid-template-columns:1fr 1fr;
  }
}

@media(max-width:480px){
  .scenarioGrid,
  .metrics,
  .assumptionGrid{
    grid-template-columns:1fr;
  }

  .componentRow,
  .componentRow.future,
  .componentRow.pension{
    grid-template-columns:1fr;
  }

  .miniField,
  .componentIdentity{
    grid-column:1;
  }
}
  
  .scenarioFieldHighlight{
  border:1px solid var(--blue);
  padding:8px;
}
  
  .fireTargetCell{
  width:210px;
  padding:7px;
  border:1px solid var(--blue);
}
  .scenarioField input{
  text-align:right;
}

.fireTargetCell label{
  color:var(--blue);
}
  
.scenarioField label,
.miniField label,
.assumptionField label{
  display:block;
  min-height:28px;
  margin-bottom:-10px;
}
  
  input{
  text-align:right;
}

























.panel{border:1px solid var(--line);background:#fff}
.header{display:grid;grid-template-columns:1fr auto;gap:24px;align-items:start;padding:18px 20px;border-bottom:1px solid var(--line)}
.kicker{font-size:10px;font-weight:700;letter-spacing:.13em;color:var(--blue);margin-bottom:5px}.title{font-family:"Times New Roman",serif;font-size:27px;line-height:1.05}.sub{margin-top:5px;color:var(--muted);font-size:11px}
.example{border:1px solid var(--blue);padding:8px 12px;min-width:260px;text-align:right}.exampleLabel{font-size:9px;font-weight:700;letter-spacing:.12em;color:var(--blue);text-transform:uppercase}.modelLabel{font-family:"Times New Roman",serif;font-size:19px;margin-top:3px}.modelMeta{font-size:10px;color:var(--muted);margin-top:3px}
.riskbar{display:flex;align-items:center;gap:12px;padding:11px 20px;border-bottom:1px solid var(--line);background:var(--soft)}.riskTitle{font-weight:700;font-size:10px;letter-spacing:.08em}.dots{display:flex;gap:5px}.riskDot{width:12px;height:12px;border-radius:50%;border:1px solid #c5ccd6;background:#fff;cursor:pointer;padding:0}.riskDot.on{background:var(--red);border-color:var(--red)}.riskText{margin-left:auto;color:var(--muted);font-size:10px}
.metrics{display:grid;grid-template-columns:repeat(5,1fr);border-bottom:1px solid var(--line)}.metric{padding:11px 14px;border-right:1px solid var(--line)}.metric:last-child{border-right:0}.metricLabel{font-size:10px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}.metricValue{font-family:"Times New Roman",serif;font-weight:700;font-size:19px;margin-top:3px;text-align:right}
.content{display:grid;grid-template-columns:minmax(420px,.9fr) minmax(440px,1.1fr);gap:0}.holdings{border-right:1px solid var(--line)}.blockHead{padding:12px 14px;border-bottom:1px solid var(--line)}.blockTitle{font-family:"Times New Roman",serif;font-size:17px}.blockSub{font-size:10px;color:var(--muted);margin-top:2px}
table{width:100%;border-collapse:collapse}th,td{padding:8px 10px;border-bottom:1px solid #edf0f4;text-align:left}th{font-size:9px;text-transform:uppercase;letter-spacing:.07em;color:var(--muted);font-weight:700;background:#fbfcfe}td.num,th.num{text-align:right}.name{font-weight:600}.ticker{font-size:9px;color:var(--muted);margin-top:2px}.chartWrap{padding:0}.canvasBox{height:300px;padding:12px 14px 4px}canvas{width:100%;height:100%;display:block}.footnote{padding:8px 14px 12px;border-top:1px solid #edf0f4;color:var(--muted);font-size:9px;line-height:1.4}
.empty{padding:25px;color:var(--muted)}
@media(max-width:820px){.header{grid-template-columns:1fr}.example{text-align:left}.metrics{grid-template-columns:repeat(2,1fr)}.metric{border-bottom:1px solid var(--line)}.content{grid-template-columns:1fr}.holdings{border-right:0;border-bottom:1px solid var(--line)}}


#riskDots .riskDot{
  width:8px;
  height:8px;
  padding:0;
  border:0;
  border-radius:50%;
  background:#d1d5db;
}

#riskDots .riskDot.active{
  background:#d64242;
}

#tableHoldings{
  font-size:11px;
  color:#334155;
}

#tableHoldings td{
  font-weight:400;
  line-height:1.15;
}

#tableHoldings .instrumentName{
  font-size:12px;
  font-weight:600;
  color:#1f2937;
}

#tableHoldings .instrumentTicker{
  font-size:8px;
  font-weight:400;
  color:#94a3b8;
}

#tableHoldings th{
  font-size:8px;
  font-weight:600;
  letter-spacing:.08em;
  color:#64748b;
}

.metricValue{
font-size:16px;
  font-weight:540;
  color:#4E79BD;
  
  
  }
  
  .chartWrap{
  border-left:none;
  border-top:none;

