   LIFE CYCLE — UNIFORM INPUT HEIGHT
========================================= */

.optionalComponent .miniField input,
.optionalComponent .miniField select{

  height:34px !important;
  min-height:34px !important;
  max-height:34px !important;

  padding:0 9px !important;

