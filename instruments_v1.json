  // Freedom Amount: always included

  addItem(
    "freedomAmount",
    "banknote",
    L.freedomAmount,
    freedomAmount,
    L.freedomText(money(freedomAmount))
  );


  // Relevant assets: only positive balances

  for(const asset of assets){

    addItem(
      asset.key,
      asset.icon,
      asset.label,
      asset.amount,
      asset.narrative(
        money(asset.amount)
      )
    );

  }


  // Mortgage: only when outstanding

  if(mortgage > 0){

    addItem(
      "mortgage",
      "house-plus",
      L.mortgage,
      mortgage,
      L.mortgageText(money(mortgage))
    );

  }


  // Legacy: always included

  addItem(
    "legacy",
    "heart-handshake",
    L.legacy,
    desiredLegacy,
    L.legacyText(
      money(desiredLegacy),
      money(nominalLegacy)
    )
  );



  /* ================================================
     5. RETURN
  ================================================ */

 return {

  lang:da ? "da" : "en",
  currency,

  title:L.title,
  subtitle:L.subtitle,

  freedomMonth,
  freedomAge:age,
  terminalAge,

  labels:{
    assets:L.assets,
    liabilities:L.liabilities,
    netWealth:L.netWealth,
    realUnit:L.realUnit,
    monthly:L.monthly,
    nominal:L.nominal
  },

  /*
    =========================================
    FOUR ECONOMIC BALANCE SHEET STATES
    =========================================
  */

  balanceSheets:{

    today:buildBalanceSheet(
      balanceSnapshots.today,
      "today"
    ),

    freedom:buildBalanceSheet(
      balanceSnapshots.freedom,
      "freedom"
    ),

    beforeDeath:buildBalanceSheet(
      balanceSnapshots.beforeDeath,
      "beforeDeath"
    ),

    finalEstate:buildBalanceSheet(
