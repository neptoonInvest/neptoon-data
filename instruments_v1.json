function bindFireSlider(){

  const slider =
    byId("fireConsumptionSlider");

  if(!slider){
    return;
  }

  slider.addEventListener(
    "input",
    () => {

      const base =
        Math.max(
          0,
          moneyValue(
            "monthlyConsumption"
          )
        );

      const position =
        clamp(
          Number(slider.value) || 0,
          0,
          100
        );

      STATE.fireBase =
        base;

      STATE.fireTarget =
        base +
        (
          base *
          position / 100
        );

      render();

    }
  );

}



function bindLegacySlider(){

  const slider =
    byId("legacySlider");

  if(!slider){
    return;
  }

  slider.addEventListener("input", () => {

    const base =
      Math.max(
        0,
        moneyValue("legacy")
      );

    const position =
      clamp(
        Number(slider.value) || 0,
        0,
        100
      );

    STATE.legacyBase =
      base;

    STATE.legacyTarget =
      base +
      base * position / 100;

    render();

  });

}


