function resolveLiquidationAge(
  inputId,
  currentAge,
  deathAge
){
  const raw =
    optionalNumberValue(inputId);

  if(raw === null){
    return deathAge;
  }

  return clamp(
    raw,
    currentAge,
    deathAge
  );
}

function readInputs(){

  let currentAge =
    numberValue("currentAge");

  let deathAge =
    numberValue("deathAge");

  currentAge =
    clamp(
      currentAge,
      18,
      100
    );

  deathAge =
    clamp(
      deathAge,
      currentAge + 1,
      120
    );


  /*
    INFLATION
  */

  const inflation =
    clamp(
      percentValue("inflation"),
      -0.20,
      0.50
    );


  /*
    NOMINAL TO REAL RETURN

    User enters NOMINAL returns.

    Returns are after ongoing taxes
    and costs, but before separately
    modeled deferred capital gains tax.

    Private pension return already
    includes annual PAL taxation.
  */

  const toRealReturn = nominalReturn =>
    (1 + nominalReturn) /
    (1 + inflation) - 1;


  /*
    ANNUAL NOMINAL SAVINGS GROWTH
  */

  const savingsGrowthNominal =
    clamp(
      numberValue("savingsGrowthAnnual"),
      0,
      6
    ) / 100;


  /*
    MONTHLY CONSUMPTION
  */

  const baseMonthlyConsumption =
    Math.max(
      0,
      moneyValue("monthlyConsumption")
    );

  let monthlyConsumption =
    baseMonthlyConsumption;

  /*
    Slider only changes the
    temporary FIRE target.
  */

  if(
    Number.isFinite(
      STATE.fireTarget
    )
  ){

    monthlyConsumption =
      clamp(
        STATE.fireTarget,
        baseMonthlyConsumption,
        baseMonthlyConsumption * 2
      );

  }


  /*
    PRIVATE PENSION CONTRIBUTION

    Salary-related pension accrual.

    No deduction from discretionary
    savings.

    Contribution grows nominally with
    savingsGrowthNominal during BUILDING.
  */

  const privatePensionContribution =
    componentEnabled("privatePension")
      ? Math.max(
          0,
          moneyValue("privatePensionContribution")
        )
      : 0;


  /*
    DEFERRED PENSION TAX

    Fixed nominal future liability.

    The simulation handles inflation
    dilution and settlement at
    pension liquidation.
  */

  const pensionTaxEnabled =
    !!byId("pensionTaxEnabled")?.checked;

  const pensionTaxAmount =
    pensionTaxEnabled
      ? Math.max(
          0,
          Number(
            String(
              byId("pensionTaxAmount")?.value || "0"
            )
              .replace(/\./g, "")
              .replace(",", ".")
          ) || 0
        )
      : 0;


  /*
    COMPONENT STATUS
  */

  const houseEnabled =
    componentEnabled("realEstate");

  const enterpriseEnabled =
    componentEnabled("enterprise");

  const privatePensionEnabled =
    componentEnabled("privatePension");

  const publicPensionEnabled =
    componentEnabled("publicPension");









/*
  FUTURE RESOURCE IMPLIED RETURN

  Two NOMINAL valuations:
    - Value today
    - Value at realization

  Derive constant annual NOMINAL growth,
  then convert to REAL return.

  No additional user return assumption.
*/



function impliedFutureResource(
  todayId,
  futureId,
  realizationAge,
  enabled,
  annualTaxRate = 0
){

  const valueToday = enabled
    ? Math.max(0, moneyValue(todayId))
    : 0;

  const futureNominalAmount = enabled
    ? Math.max(0, moneyValue(futureId))
    : 0;

  const impliedRate =
    calculateFutureResourceRate(
      valueToday,
      futureNominalAmount,
      currentAge,
      realizationAge
    );

  const nominalReturn =
    impliedRate ?? 0;

  const nominalReturnAfterTax =
    nominalReturn * (1 - annualTaxRate);

  return {
    valueToday,
    futureNominalAmount,
    nominalReturn,
    realReturn:
      toRealReturn(nominalReturnAfterTax)
  };

}




