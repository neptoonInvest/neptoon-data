function restoreAccountPortfolios(settings){

  ["build","use"].forEach(phase => {

    const issuerSelect = byId(phase + "Issuer");
    const modelSelect  = byId(phase + "ModelNo");

    if(!issuerSelect || !modelSelect) return;

    const issuer = settings.inputs?.[phase + "Issuer"];
    const modelNo = settings.inputs?.[phase + "ModelNo"];

    if(issuer == null || modelNo == null) return;

    // 1. Restore issuer

    issuerSelect.value = issuer;

    if(issuerSelect.value !== issuer){
      console.warn("RESTORE: issuer unavailable",phase,issuer);
      return;
    }

    // 2. Rebuild model dropdown

    issuerSelect.onchange?.();

    // 3. Restore selected model

    modelSelect.value = String(modelNo);

    if(modelSelect.value !== String(modelNo)){
      console.warn("RESTORE: model unavailable",phase,modelNo);
      return;
    }

    // 4. Synchronize portfolio engine

    modelSelect.onchange?.();

  });

}

function restoreUserSettings(settings){

  if(settings?.schemaVersion !== 1){
    throw new Error("Unsupported settings version");
  }

  // RESTORE INPUTS

  Object.entries(settings.inputs || {}).forEach(
    ([id,value]) => {

      const el = byId(id);
      if(!el) return;

      if(el.type === "checkbox"){
        el.checked = value === true;
      }else{
        el.value = value ?? "";
      }

    }
  );

  // RESTORE RADIO GROUPS

  Object.entries(settings.radios || {}).forEach(
    ([name,value]) => {

      const radio = [
        ...document.querySelectorAll(
          `input[name="${name}"]`
        )
      ].find(el => el.value === value);

      if(radio) radio.checked = true;

    }
  );


restoreAccountPortfolios(settings);
restoreOptionalComponents(settings);
  console.log("USER SETTINGS RESTORED",settings);

paintFutureResourceRates();
render();


}

