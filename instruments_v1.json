  letter-spacing:.35px;
  text-transform:uppercase;
  color:var(--lifeBlue);
}


/* =====================================================
   BALANCE SHEET ROWS
===================================================== */

#lifeBalancePanel .lifeBalanceRows {
  display:flex;
  flex-direction:column;
}

#lifeBalancePanel .lifeBalanceRow {
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:12px;
  min-height:40px;
  padding:10px 0;
  border-bottom:1px solid #edf1f5;
