function updateAccountSelectedModel(phase){

  if(
    phase !== "build" &&
    phase !== "use"
  ){
    return;
  }

  const modelSelect =
    byId(phase + "ModelNo");

  const modelNo =
    modelSelect?.value;

  /*
    FIND MODEL — FLAT SOURCE STRUCTURE
  */

  const row =
    ACCOUNT_PORTFOLIOS.find(p =>
      String(p.modelNo) ===
      String(modelNo)
    );

  if(!row){
    return;
  }

  const phaseKey =
    phase === "build"
      ? "phase1"
      : "phase2";


  /*
    UPDATE GLOBAL PORTFOLIO STATE

    Flat source fields are mapped into
    the existing Life Cycle identity
    structure for compatibility.
  */

  selectedModels[phaseKey] = {

    identity: {

      modelNo:
        row.modelNo,

      modelLabel:
        row.modelLabel || row.modelName || "",

      modelName:
        row.modelName || row.modelLabel || "",

      issuer:
        row.issuer || row.issuerName || "",

      issuerName:
        row.issuerName || row.issuer || "",

      ccy:
        row.ccy || (INIT.lang === "da" ? "DKK" : "EUR"),

      modelType:
        row.modelType || "",

      country:
        row.country || "Global"

    },

    objKeyFigures: {
      ...(row.objKeyFigures || {})
    },

    arrayHoldings:
      Array.isArray(row.arrayHoldings)
        ? row.arrayHoldings
        : [],

    arrayHistory:
      Array.isArray(row.arrayHistory)
        ? row.arrayHistory
        : []

  };


  /*
    REFRESH PORTFOLIO DISPLAYS
  */

  renderPhaseLabelSelection(phaseKey);

  renderSelectedModelAllocation(phaseKey);

  renderSelectedModelHoldings(phaseKey);


  /*
    UPDATE MODEL LABEL
  */

  const labelField =
    byId(phase + "ModelLabel");

  if(labelField){

    labelField.textContent =
      selectedModels[phaseKey].identity.modelLabel || "—";

  }


  /*
    DIAGNOSTICS
  */

  console.log(
    "MY ACCOUNT PORTFOLIO SELECTED",
    phaseKey,
    {
      modelNo:
        selectedModels[phaseKey].identity.modelNo,

      modelLabel:
        selectedModels[phaseKey].identity.modelLabel,

      objKeyFigures:
        selectedModels[phaseKey].objKeyFigures
    }
  );


  /*
    AVOID CALCULATION UNTIL
    BOTH PHASE MODELS ARE READY
  */

  const buildReady =
    selectedModels.phase1?.identity?.modelNo != null;

  const useReady =
    selectedModels.phase2?.identity?.modelNo != null;

  if(!buildReady || !useReady){
    return;
  }


  /*
    REFRESH FINANCIAL MODEL
  */

  if(
    typeof render === "function"
  ){

    renderPortfolioRiskDisplays();

    render();

  }

  if(
    typeof renderRiskModel === "function"
  ){

    renderRiskModel();

  }

}

