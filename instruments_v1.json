/* =====================================================
   CANVAS · RESPONSIVE PREPARATION
===================================================== */

function tmPrepareCanvas(){

  const canvas = tmEl("history-canvas");

  if(!canvas) return null;

  const rect =
    canvas.getBoundingClientRect();

  if(rect.width < 10 || rect.height < 10){
    return null;
  }

  const dpr = Math.min(
    window.devicePixelRatio || 1,
    2
  );

  const width = rect.width;
  const height = rect.height;

  const pixelW =
    Math.round(width * dpr);

  const pixelH =
    Math.round(height * dpr);

  if(
    canvas.width !== pixelW ||
    canvas.height !== pixelH
  ){
    canvas.width = pixelW;
    canvas.height = pixelH;
  }

  const ctx = canvas.getContext("2d");

  ctx.setTransform(dpr,0,0,dpr,0,0);

  ctx.clearRect(0,0,width,height);

  return {
    ctx,
    width,
    height
  };

}


/* =====================================================
   CANVAS · NICE Y-AXIS STEP
===================================================== */

function tmNiceStep(raw){

  const power =
    Math.pow(
      10,
      Math.floor(Math.log10(raw))
    );

  const normalized = raw / power;

  let nice;

  if(normalized <= 1) nice = 1;
  else if(normalized <= 2) nice = 2;
  else if(normalized <= 5) nice = 5;
  else nice = 10;

  return nice * power;

}


/* =====================================================
   DRAW TIME MACHINE CHART
===================================================== */

function tmDrawChart(){

  const prepared = tmPrepareCanvas();

  if(!prepared) return;

  const {
    ctx,
    width,
    height
  } = prepared;

  const series = tmCurrentSeries();

  if(!series.length) return;

  const key = tmNAVKey();

  const index = Math.min(
    TIME_MACHINE.monthIndex,
    series.length - 1
  );

  const values = series
    .slice(0,index + 1)
    .map(p => Number(p[key]) * 1000);

  const pad = {
    left:57,
    right:10,
    top:16,
    bottom:29
  };

  const plotW =
    width - pad.left - pad.right;

  const plotH =
    height - pad.top - pad.bottom;

  if(plotW <= 0 || plotH <= 0) return;

  /*
    Y-axis uses observed data only.
    No future lookahead.
  */

  const minObserved =
    Math.min(100000,...values);

  const maxObserved =
    Math.max(100000,...values);

  const range = Math.max(
    maxObserved - minObserved,
    10000
  );

  const margin = range * .15;

  const rawMin =
    Math.max(0,minObserved - margin);

  const rawMax =
    maxObserved + margin;

  const step =
    tmNiceStep((rawMax - rawMin) / 4);

  const yMin =
    Math.floor(rawMin / step) * step;

  const yMax =
    Math.ceil(rawMax / step) * step;

  const yRange =
    Math.max(1,yMax - yMin);

  const x = i =>
    pad.left +
    (i / Math.max(1,series.length - 1)) *
    plotW;

  const y = value =>
    pad.top +
    (1 - (value - yMin) / yRange) *
    plotH;

  /* =====================================
     GRID / Y AXIS
  ===================================== */

  ctx.font = "10px Arial";
  ctx.textAlign = "right";
  ctx.textBaseline = "middle";

  for(
    let tick = yMin;
    tick <= yMax + step * .001;
    tick += step
  ){

    const yy = y(tick);

    ctx.strokeStyle = "rgba(160,190,225,.16)";
    ctx.lineWidth = 1;

    ctx.beginPath();
    ctx.moveTo(pad.left,yy);
    ctx.lineTo(width - pad.right,yy);
    ctx.stroke();

    ctx.fillStyle = "#a9bdd5";

    ctx.fillText(
      tmFormatNumber(tick),
      pad.left - 7,
      yy
    );

  }

  /* =====================================
     BASE WEALTH LINE
  ===================================== */

  const baseY = y(100000);

  ctx.save();

  ctx.setLineDash([4,4]);
  ctx.strokeStyle = "rgba(255,255,255,.65)";

  ctx.beginPath();
  ctx.moveTo(pad.left,baseY);
  ctx.lineTo(width-pad.right,baseY);
  ctx.stroke();

  ctx.restore();

  /* =====================================
     X AXIS · DECADE YEARS
  ===================================== */

  const startYear =
    Number(series[0].date.slice(0,4));

  const endYear =
    Number(series[series.length-1].date.slice(0,4));

  ctx.font = "10px Arial";
  ctx.fillStyle = "#a9bdd5";
  ctx.textBaseline = "top";

  const totalMonths =
    series.length - 1;

  const tickMonths = [
    0,
    Math.round(totalMonths / 2),
    totalMonths
  ];

  tickMonths.forEach((month,i) => {

    const xx = x(month);

    ctx.textAlign =
      i === 0
        ? "left"
        : i === 2
          ? "right"
          : "center";

    ctx.fillText(
      series[month].date.slice(0,4),
      xx,
      height - pad.bottom + 9
    );

  });

  /* =====================================
     NAV LINE
  ===================================== */

  if(values.length < 2){

    ctx.fillStyle = "#69baff";

    ctx.beginPath();
    ctx.arc(x(0),y(values[0]),3,0,Math.PI*2);
    ctx.fill();

    return;
  }

  const line = new Path2D();

  values.forEach((value,i) => {

    const xx = x(i);
    const yy = y(value);

    if(i === 0){
      line.moveTo(xx,yy);
    }else{
      line.lineTo(xx,yy);
    }

  });

  /* =====================================
     SUBTLE AREA FILL
  ===================================== */

  const area = new Path2D();

  area.moveTo(x(0),y(values[0]));

  values.forEach((value,i) => {
    area.lineTo(x(i),y(value));
  });

  area.lineTo(x(index),pad.top+plotH);
  area.lineTo(x(0),pad.top+plotH);
  area.closePath();

  const gradient =
    ctx.createLinearGradient(
      0,pad.top,0,pad.top+plotH
    );

  gradient.addColorStop(
    0,"rgba(78,121,189,.35)"
  );

  gradient.addColorStop(
    1,"rgba(78,121,189,.02)"
  );

  ctx.fillStyle = gradient;
  ctx.fill(area);

  ctx.strokeStyle = "#69baff";
  ctx.lineWidth = 2.5;
  ctx.lineJoin = "round";
  ctx.lineCap = "round";
  ctx.stroke(line);

  /* =====================================
     CURRENT MONTH DOT
  ===================================== */

  const lastValue =
    values[values.length - 1];

  const dotX = x(index);
  const dotY = y(lastValue);

  ctx.fillStyle = "#ffffff";

  ctx.beginPath();
  ctx.arc(dotX,dotY,4,0,Math.PI*2);
  ctx.fill();

  ctx.strokeStyle = "#69baff";
  ctx.lineWidth = 2;

  ctx.beginPath();
  ctx.arc(dotX,dotY,5,0,Math.PI*2);
  ctx.stroke();

}


