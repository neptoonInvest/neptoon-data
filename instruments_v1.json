function showSuggestions(i, q){

  const host =
    document.getElementById(`suggest-${i}`);

  if(!host) return;

  const query =
    String(q || "").trim().toLowerCase();

  if(!query){
    host.innerHTML = "";
    return;
  }

  const instruments =
    INSTRUMENT_STATE.all || [];

  const selected =
    new Set(
      APP.assets.filter((_, j) => j !== i)
    );

  const hits =
    instruments
      .filter(x => {

        const ticker =
          String(x.tickerExchange || "");

        const name =
          String(x.name || "");

        const isin =
          String(x.isin || "");

        return (
          !selected.has(ticker) &&
          (
            ticker.toLowerCase().includes(query) ||
            name.toLowerCase().includes(query) ||
            isin.toLowerCase().includes(query)
          )
        );

      })
      .slice(0, 10);

  host.innerHTML = `
    <div class="suggestions">

      ${
        hits.map(x => `

          <button
            type="button"
            class="suggestion"
            data-choose-asset="${esc(x.tickerExchange)}"
            data-index="${i}"
          >

            <span>
              ${esc(x.name)}
              <span class="row-meta">
                ${esc(x.tickerExchange)}
              </span>
            </span>

            ${icon("plus")}

          </button>

        `).join("")
        ||
        `<div class="small" style="padding:12px">
          ${tr("noData")}
        </div>`
      }

    </div>
  `;

  icons();

}


