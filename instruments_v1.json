function applyStaticBeta(series, beta){

  let nav = 100;

  return series.map((point, i) => {

    if(i === 0){
      return {
        ...point,
        benchmarkNAV: 100
      };
    }

    const previous = series[i - 1];

    const monthlyReturn =
      point.benchmarkNAV /
      previous.benchmarkNAV - 1;

    nav *= 1 + beta * monthlyReturn;

    return {
      ...point,
      benchmarkNAV: nav
    };

  });

}
  
  
/* =========================================
   NW-211 — GBM WEALTH DISTRIBUTION

   Monthly contributions
   Full cashflow covariance structure
   Two-moment lognormal approximation
========================================= */

function calcWealthGBM({

  W0 = 0,
  savingsMonthly = 0,
  horizon = 10,
  expRet = 0.06,
  risk = 0.12

} = {}){

  const t = Math.max(
    0,
    Number(horizon) || 0
  );

  const n = Math.round(t * 12);

  const c0 = Math.max(
    0,
    Number(W0) || 0
  );

  const cV = Math.max(
    0,
    Number(savingsMonthly) || 0
  );

  const annualReturn = Math.max(
    -0.9999,
    Number(expRet) || 0
  );

  const annualRisk = Math.max(
    0,
    Number(risk) || 0
  );


  /*
    =========================
    MONTHLY RETURN PARAMETERS
    =========================
  */

  const monthlyReturn =
    Math.pow(
      1 + annualReturn,
      1 / 12
    ) - 1;

  const monthlyRisk =
    annualRisk / Math.sqrt(12);

  const meanFactor =
    1 + monthlyReturn;

  const sigmaLog = annualRisk === 0
    ? 0
    : Math.sqrt(
        Math.log(
          1 +
          Math.pow(
            monthlyRisk / meanFactor,
            2
          )
        )
      );

  const muLog =
    Math.log(meanFactor) -
    0.5 * sigmaLog * sigmaLog;


  /*
    =========================
    CASHFLOW ARRAY
    =========================
  */

  const cashflows =
    new Array(n + 1).fill(cV);

  cashflows[0] = c0;


  /*
    =========================
    EXPECTED TERMINAL WEALTH
    =========================
  */

  let expectedWealth = 0;

  for(let i = 0; i <= n; i++){

    const remaining = n - i;

    expectedWealth +=
      cashflows[i] *
      Math.exp(
        remaining *
        (
          muLog +
          0.5 * sigmaLog * sigmaLog
        )
      );

  }


  /*
    =========================
    FULL COVARIANCE STRUCTURE
    =========================

    Each contribution shares future
    market returns with other cashflows.

    Cov(Xi,Xj) =
      E(Xi) E(Xj)
      [exp(min(Ti,Tj)*sigmaLog²)-1]

  */

  let varianceWealth = 0;

  if(sigmaLog > 0){

    for(let i = 0; i <= n; i++){

      const remainingI = n - i;

      const expectedI =
        cashflows[i] *
        Math.exp(
          remainingI *
          (
            muLog +
            0.5 * sigmaLog * sigmaLog
          )
        );

      for(let j = 0; j <= n; j++){

        const remainingJ = n - j;

        const expectedJ =
          cashflows[j] *
          Math.exp(
            remainingJ *
            (
              muLog +
              0.5 * sigmaLog * sigmaLog
            )
          );

        const sharedMonths =
          Math.min(
            remainingI,
            remainingJ
          );

        const covariance =
          expectedI *
          expectedJ *
          (
            Math.exp(
              sharedMonths *
              sigmaLog *
              sigmaLog
            ) - 1
          );

        varianceWealth += covariance;

      }

    }

  }

  varianceWealth =
    Math.max(0, varianceWealth);

  const stdWealth =
    Math.sqrt(varianceWealth);


  /*
    =========================
    DEGENERATE DISTRIBUTION
    =========================

    Zero wealth or zero volatility:
    all percentiles equal expected wealth.

  */

  if(
    expectedWealth <= 0 ||
    sigmaLog === 0 ||
    varianceWealth === 0
  ){

    return {

      month:n,
      year:n / 12,

      expectedWealth,
      medianWealth:expectedWealth,

      varianceWealth:0,
      stdWealth:0,

      q10:expectedWealth,
      q50:expectedWealth,
      q90:expectedWealth,

      muLogWealth:
        expectedWealth > 0
          ? Math.log(expectedWealth)
          : null,

      sigmaLogWealth:0,

      deterministic:true

    };

  }


  /*
    =========================
    LOGNORMAL MOMENT MATCHING
    =========================
  */

  const sigmaLogWealth = Math.sqrt(
    Math.log(
      1 +
      varianceWealth /
      (expectedWealth * expectedWealth)
    )
  );

  const muLogWealth =
    Math.log(expectedWealth) -
    0.5 *
    sigmaLogWealth *
    sigmaLogWealth;


  /*
    =========================
    QUANTILES
    =========================
  */

  const quantile = p =>
    Math.exp(
      muLogWealth +
      sigmaLogWealth * normInv(p)
    );

  const medianWealth =
    Math.exp(muLogWealth);

  const q10 = quantile(0.10);
  const q90 = quantile(0.90);


  /*
    =========================
    RETURN
    =========================
  */

  return {

    month:n,
    year:n / 12,

    expectedWealth,
    medianWealth,

    varianceWealth,
    stdWealth,

    q10,
    q50:medianWealth,
    q90,

    muLogWealth,
    sigmaLogWealth,

    deterministic:false,

    // Underlying monthly GBM parameters
    muMonthlyLog:muLog,
    sigmaMonthlyLog:sigmaLog,
    muMonthlyDiscrete:monthlyReturn,
    sigmaMonthlyDiscrete:monthlyRisk

  };

}



 function normInv(p) {
  if (!(p > 0 && p < 1)) {
    throw new Error("normInv requires 0 < p < 1");
  }

  const a = [
    -3.969683028665376e+01,
     2.209460984245205e+02,
    -2.759285104469687e+02,
     1.383577518672690e+02,
    -3.066479806614716e+01,
     2.506628277459239e+00
  ];

  const b = [
    -5.447609879822406e+01,
     1.615858368580409e+02,
    -1.556989798598866e+02,
     6.680131188771972e+01,
    -1.328068155288572e+01
  ];

  const c = [
    -7.784894002430293e-03,
    -3.223964580411365e-01,
    -2.400758277161838e+00,
    -2.549732539343734e+00,
     4.374664141464968e+00,
     2.938163982698783e+00
  ];

  const d = [
     7.784695709041462e-03,
     3.224671290700398e-01,
     2.445134137142996e+00,
     3.754408661907416e+00
  ];

  const plow = 0.02425;
  const phigh = 1 - plow;

  let q, r;

  if (p < plow) {
    q = Math.sqrt(-2 * Math.log(p));
    return (((((c[0] * q + c[1]) * q + c[2]) * q + c[3]) * q + c[4]) * q + c[5]) /
           ((((d[0] * q + d[1]) * q + d[2]) * q + d[3]) * q + 1);
  }

  if (phigh < p) {
    q = Math.sqrt(-2 * Math.log(1 - p));
    return -(((((c[0] * q + c[1]) * q + c[2]) * q + c[3]) * q + c[4]) * q + c[5]) /
             ((((d[0] * q + d[1]) * q + d[2]) * q + d[3]) * q + 1);
  }

  q = p - 0.5;
  r = q * q;

  return (((((a[0] * r + a[1]) * r + a[2]) * r + a[3]) * r + a[4]) * r + a[5]) * q /
         (((((b[0] * r + b[1]) * r + b[2]) * r + b[3]) * r + b[4]) * r + 1);
}


