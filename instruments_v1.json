     Accumulate deferred capital gains tax in NOMINAL currency.
     Nominal value = real asset value * inflation index.
     Revaluation reverses accrued tax when gains decline, but
     cannot create a refundable loss credit (liability floor 0).
   */
   if(state.capitalGainsTax > 0){
     const nominalValue = state.value * inflationIndexAtMonth(month);
     const priorTax = state.deferredTaxNominal;

     state.deferredTaxNominal = Math.max(
       0,
       priorTax + state.capitalGainsTax *
         (nominalValue - state.previousNominalValue)
     );
     state.previousNominalValue = nominalValue;

     const taxAccrual = state.deferredTaxNominal - priorTax;
     if(asset.key === "realEstate"){
       realEstateTaxAccrualNominal = taxAccrual;
     }else if(asset.key === "enterprise"){
       enterpriseTaxAccrualNominal = taxAccrual;
     }else if(asset.key === "privatePension"){
       privatePensionCapitalGainsTaxAccrualNominal = taxAccrual;
     }
   }


  /*
    PRIVATE PENSION CONTRIBUTION

    Salary-related pension accrual.
    No deduction from free portfolio.

    BUILDING only.
    Return is calculated before contribution.

    Nominal contribution growth is adjusted
    for inflation to obtain real contributions.
  */

if(
  asset.key === "privatePension" &&
  month <= freedomMonth
){






  const contributionToday =
    Number(
      inputs.privatePensionContribution
    ) || 0;

  const savingsGrowthNominal =
    Number(
      inputs.savingsGrowthNominal
    ) || 0;

  const inflation =
    Number(
      inputs.inflation
    ) || 0;

  const contributionReal =
    contributionToday *
    Math.pow(
      (1 + savingsGrowthNominal) /
      (1 + inflation),
      month / 12
    );

  /*
    Record contribution for Excel ledger.
  */

  privatePensionContribution =
    contributionReal;

  /*
    Add contribution ONCE to pension wealth.
  */

  state.value +=
    privatePensionContribution;

  /* Contributions increase nominal cost basis, not taxable gains. */
  const contributionNominal =
    privatePensionContribution * inflationIndexAtMonth(month);
  state.taxBasisNominal += contributionNominal;
  state.previousNominalValue += contributionNominal;

}


  /*
    COMPONENT RETURNS
  */

  if(asset.key === "realEstate"){
    realEstateReturn =
      assetReturn;
  }

  if(asset.key === "enterprise"){
    enterpriseReturn =
      assetReturn;
  }

  if(asset.key === "privatePension"){
    privatePensionReturn =
      assetReturn;
  }

}



if(month <= freedomMonth){

  /*
    Monthly savings grow smoothly
    from the annual nominal
    savings-growth assumption.

    S_m =
      S_0 *
      (1 + g)^(m/12)
  */

  const savingsGrowthNominal =
    Number(
      inputs.savingsGrowthNominal
    ) || 0;


