/* =====================================================
   LIFE CYCLE — ASSET ASSUMPTION STATUS
   Read-only mirror of Tax & Economics
===================================================== */

.assetAssumptionStatus{
  margin-top:9px;
  width:100%;
  min-width:0;
}

/* THREE METRICS */

.assetAssumptionMetrics{
  display:flex;
  flex-wrap:wrap;
  align-items:center;
  gap:5px 0;
}

/* INDIVIDUAL METRIC */

.assetAssumptionMetric{
  display:inline-flex;
  align-items:center;
  gap:4px;

  padding:0 9px;

  font-family:Arial,Helvetica,sans-serif;
  font-size:10px;
  line-height:1.5;

  white-space:nowrap;
}

/* FIRST METRIC — NO LEFT PADDING */

.assetAssumptionMetric:first-child{
  padding-left:0;
}

/* SUBTLE SEPARATORS */

.assetAssumptionMetric + .assetAssumptionMetric{
  border-left:1px solid #dce3ec;
}

/* ICONS */

.assetAssumptionIcon{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  flex:0 0 12px;

  width:12px;
  height:12px;

  color:#94a3b8;
}

.assetAssumptionIcon svg{
  display:block;
  width:12px;
  height:12px;

  stroke-linecap:round;
  stroke-linejoin:round;
}

/* LABEL */

.assetAssumptionLabel{
  color:#64748b;
  font-size:10px;
  font-weight:400;
}

/* VALUE */

.assetAssumptionValue{
  color:#4E79BD;
  font-size:10px;
  font-weight:600;
  font-variant-numeric:tabular-nums;
}

/* NARROW SCREENS */

@media(max-width:700px){

  .assetAssumptionMetrics{
    gap:5px 0;
  }

  .assetAssumptionMetric{
    padding:0 7px;
    font-size:9px;
  }

  .assetAssumptionLabel,
  .assetAssumptionValue{
    font-size:9px;
  }

}

