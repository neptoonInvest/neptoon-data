  font-weight:700;
  line-height:1.35;
  color:#243b60;
}

.lifeBalanceStateBtn.is-active
.lifeBalanceStateTitle{
  color:#315e9f;
}

.lifeBalanceStateSub{
  margin-top:4px;
  font-size:11px;
