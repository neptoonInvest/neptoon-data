  list-style:none;
  background:#f7f9fc;
}

.lifeFAQGroupSummary::-webkit-details-marker{
  display:none;
}

.lifeFAQGroupTitle{
  font-size:15px;
  font-weight:525;
  color:#243b5a;
}

.lifeFAQGroupSummary svg{
  width:17px;
  height:17px;
  color:#4E79BD;
  transition:transform .2s ease;
}

