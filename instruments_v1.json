/* ============================================
   MYWEALTH · PORTFOLIO HISTORICAL NAV
============================================ */

function buildMyWealthPortfolioHistorySeries(investment){

  const model =
    (PORTFOLIO_STATE.all || []).find(
      p =>
        Number(p.modelNo) ===
        Number(investment.id)
    );

  if(!model){

    console.warn(
      "MYWEALTH PORTFOLIO MODEL NOT FOUND",
      investment.id
    );

    return [];

  }

  const history =
    Array.isArray(model.arrayHistory)
      ? model.arrayHistory
      : [];

  const valid = history
    .filter(p =>
      p.date &&
      Number.isFinite(Number(p.accPortIndex)) &&
      Number.isFinite(Number(p.accBenchIndex)) &&
      Number(p.accPortIndex) > 0 &&
      Number(p.accBenchIndex) > 0
    )
    .sort((a,b) =>
      a.date.localeCompare(b.date)
    );

  if(valid.length < 2){

    console.warn(
      "MYWEALTH PORTFOLIO HISTORY EMPTY",
      model.modelNo
    );

    return [];

  }

  const baseA =
    Number(valid[0].accPortIndex);

  const baseB =
    Number(valid[0].accBenchIndex);

  const series = valid.map(
    (p,index) => ({

      index,

      date:p.date,

      investmentNAV:
        100 * Number(p.accPortIndex) / baseA,

      benchmarkNAV:
        100 * Number(p.accBenchIndex) / baseB

    })
  );

  console.log(
    "MYWEALTH PORTFOLIO HISTORY READY",
    {
      modelNo:model.modelNo,
      observations:series.length,
      first:series[0],
      last:series.at(-1)
    }
  );

  return series;

}


async function loadInstrumentHistory(){

  /*
    Already loaded
  */

  if(INSTRUMENT_HISTORY_STATE.loaded){
    return INSTRUMENT_HISTORY_STATE;
  }

  /*
    Reuse an existing request.
    Prevent simultaneous downloads.
  */

  if(INSTRUMENT_HISTORY_STATE.promise){
    return INSTRUMENT_HISTORY_STATE.promise;
  }

  INSTRUMENT_HISTORY_STATE.loading = true;
  INSTRUMENT_HISTORY_STATE.error = null;

  INSTRUMENT_HISTORY_STATE.promise = (async () => {

    try{

      const response = await fetch(
        INSTRUMENT_HISTORY_URL
      );

      if(!response.ok){
        throw new Error(
          "Instrument history HTTP " +
          response.status
        );
      }

      const data = await response.json();

      if(!Array.isArray(data.instruments)){
        throw new Error(
          "Invalid instrument history JSON"
        );
      }

      /*
        Build lookup:
        tickerExchange -> arrayHistory
      */

      const byTicker = new Map();

      data.instruments.forEach(item => {

        const ticker =
          String(item.tickerExchange || "")
            .trim()
            .toUpperCase();

        if(!ticker) return;

        const history =
          Array.isArray(item.arrayHistory)
            ? item.arrayHistory
            : [];

        byTicker.set(
          ticker,
          history
        );

      });

      /*
        Commit loaded state
      */

      INSTRUMENT_HISTORY_STATE.all =
        data.instruments;

      INSTRUMENT_HISTORY_STATE.byTicker =
        byTicker;

      INSTRUMENT_HISTORY_STATE.loaded = true;

      console.log(
        "NEPTOON INSTRUMENT HISTORY LOADED",
        {
          version: data.version,
          instruments: data.instruments.length,
          indexed: byTicker.size,
          firstTicker: data.instruments[0]?.tickerExchange,
          firstHistoryLength:
            data.instruments[0]?.arrayHistory?.length
        }
      );

      return INSTRUMENT_HISTORY_STATE;

    }catch(err){

      INSTRUMENT_HISTORY_STATE.error = err;

      console.error(
        "NEPTOON INSTRUMENT HISTORY ERROR",
        err
      );

      throw err;

    }finally{

      INSTRUMENT_HISTORY_STATE.loading = false;

      INSTRUMENT_HISTORY_STATE.promise = null;

    }

  })();

  return INSTRUMENT_HISTORY_STATE.promise;

}


