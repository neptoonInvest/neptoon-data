function bindLifeCycleAuthState(){

  supabaseClient.auth.onAuthStateChange(
    (event,session) => {

      console.log("SUPABASE AUTH EVENT",event);

      const user = session?.user || null;
      const previousUserId = ACCOUNT.user?.id || null;

      ACCOUNT.user = user;
      ACCOUNT.email = user?.email || "";

      /*
        ACCOUNT STATE

        Preserve verified membership when
        the same user receives another auth event.
      */

      if(!user){

        ACCOUNT.plan = "visitor";

      }else if(previousUserId !== user.id){

        ACCOUNT.plan = "free";

      }

      paintAppAccountStatus();
      renderAccountMembership();
      bindLifeCycleStorageButtons();

      /*
        LOGOUT
      */

      if(!user) return;

      /*
        VERIFY MEMBERSHIP

        Execute outside Supabase auth callback.
      */

      if(
        event === "INITIAL_SESSION" ||
        event === "SIGNED_IN" ||
        event === "USER_UPDATED"
      ){

        setTimeout(() => {

          if(ACCOUNT.user?.id !== user.id) return;

          refreshLifeCycleMembership(user)
            .catch(error => {

              console.error(
                "MEMBERSHIP REFRESH FAILED",
                error
              );

            });

        },0);

      }

    }
  );

}

