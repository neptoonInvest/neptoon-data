function guardAllMoneyInputs(){

  const ids = [

    "wealthToday",
    "monthlySavings",
    "monthlyConsumption",
    "legacy",

    "houseValue",
    "mortgageDebt",

    "enterpriseValue",

    "privatePensionValue",
    "privatePensionContribution",
