async function loadLifeCycleSettings(){

  if(!ACCOUNT.user || ACCOUNT.plan !== "premium"){
    console.warn("Premium membership required");
    return null;
  }

  const userId = ACCOUNT.user.id;

  const {data,error} = await supabaseClient
    .from("life_cycle_settings")
    .select("settings,updated_at")
    .eq("user_id",userId)
    .maybeSingle();

  if(error){
    console.error("CLOUD LOAD FAILED",error);
    return null;
  }

  // Ignore results if the account changed
  if(ACCOUNT.user?.id !== userId) return null;

  if(!data){
    console.log("NO CLOUD SETTINGS FOUND");
    return null;
  }

  console.log("CLOUD LOAD SUCCESS",{
    updated_at:data.updated_at,
    schemaVersion:data.settings?.schemaVersion
  });

  return data;

}

