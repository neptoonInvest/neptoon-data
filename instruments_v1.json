function myWealthTerminal30Y(
  W0,
  savingsMonthly,
  expRetNet
){

  return myWealthFV(
    W0,
    savingsMonthly,
    expRetNet,
    30
  );

}


/* =====================================================
   MYWEALTH · DYNAMIC BAR SCALE
   Min = W0
   Max = E(W360)
===================================================== */


function getMyWealthBarScale(){

  const W0 = MYWEALTH_VIEW.w0;
  const savings = MYWEALTH_VIEW.monthlySavings;

  return calculateMyWealthRace()

    .sort((a,b) => b.expRetNet - a.expRetNet)

    .map(p => {

      const terminal30Y = myWealthTerminal30Y(
        W0,
        savings,
        p.expRetNet
      );

      const current = p.net;

      const denominator = terminal30Y - W0;

      const progress =
        Number.isFinite(current) &&
        Number.isFinite(terminal30Y) &&
        denominator > 0
          ? Math.max(
              0,
              Math.min(
                1,
                (current - W0) / denominator
              )
            )
          : 0;

      return {
        ...p,
        barMin:W0,
        barMax:terminal30Y,
        barValue:current,
        progress
      };

    });

}


function getMyWealthTerminal30Y(){

  return getMyWealthInvestments().map(p => ({

    id:p.id,

    terminal30Y:myWealthTerminal30Y(
      MYWEALTH_VIEW.w0,
      MYWEALTH_VIEW.monthlySavings,
      p.expRetNet
    )

  }));

}


