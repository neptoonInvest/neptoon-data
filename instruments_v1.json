function getMyWealthCostBarScale(){

  const W0 = MYWEALTH_VIEW.w0;
  const savings = MYWEALTH_VIEW.monthlySavings;
  const horizon = MYWEALTH_VIEW.horizon;

  return calculateMyWealthRace().map(p => {

    const gross30 = myWealthFV(
      W0,
      savings,
      p.expRetGross,
      30
    );

    const net30 = myWealthFV(
      W0,
      savings,
      p.expRetNet,
      30
    );

    const cost30 = Math.max(
      0,
      gross30 - net30
    );

    const currentCost = Math.max(
      0,
      p.costImpact
    );

    const progress =
      cost30 > 0
        ? Math.max(
            0,
            Math.min(1, currentCost / cost30)
          )
        : 0;

    return {
      ...p,
      costBarMax: cost30,
      costBarValue: currentCost,
      costProgress: progress
    };

  });

}

