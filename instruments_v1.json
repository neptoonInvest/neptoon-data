function bindLifeCycleStorageButtons(){

  const saveBtn = byId("lcSaveCloudButton");
  const restoreBtn = byId("lcRestoreCloudButton");

  const premium =
    ACCOUNT.plan === "premium" && !!ACCOUNT.user;

  if(saveBtn){

    saveBtn.disabled = !premium;

    saveBtn.onclick = async () => {

      if(!confirm(
        "Save your current financial plan to the cloud? " +
        "This will replace your previous saved plan."
      )) return;

      await saveLifeCycleSettings();

    };

  }

  if(restoreBtn){

    restoreBtn.disabled = !premium;

    restoreBtn.onclick = async () => {

      if(!premium) return;

      if(!confirm(
        "Restore your saved financial plan? " +
        "Your current unsaved inputs will be replaced."
      )) return;

      const data = await loadLifeCycleSettings();

      if(!data?.settings){
        alert("No saved financial plan was found.");
        return;
      }

      try{

        restoreUserSettings(data.settings);

        console.log("CLOUD RESTORE SUCCESS",{
          updated_at:data.updated_at
        });

        const status = byId("lcStorageStatus");
        const lastSaved = byId("lcStorageLastSaved");

        if(status) status.textContent = "Restored";

        if(lastSaved){
          lastSaved.textContent =
            "Last saved: " +
            new Date(data.updated_at).toLocaleString();
        }

      }catch(error){

        console.error("CLOUD RESTORE FAILED",error);
        alert("Unable to restore your saved financial plan.");

      }

    };

  }

}

