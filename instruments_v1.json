  /* =========================================
   LIFE CYCLE — FOUR PHASES
========================================= */

.lifePhases {
  border: 1px solid #dce2eb;
  border-radius: 3px;
  padding: 20px 22px 14px;
  background: #fff;
  font-family: "Times New Roman", serif;
}

.lifePhasesGrid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 24px;
}

.lifePhase {
  min-width: 0;
}

.lifePhaseStep {
  font-family: Arial, sans-serif;
  font-size: 9px;
  font-weight: 600;
  letter-spacing: .04em;
  color: #4E79BD;
  margin-bottom: 9px;
}

.lifePhaseIcon {
  color: #4E79BD;
  margin-bottom: 8px;
  height: 17px;
}

.lifePhaseIcon svg {
  width: 15px;
  height: 15px;
  stroke-width: 1.7;
}

.lifePhaseTitle {
  font-size: 17px;
  font-weight: 500;
  color: #111827;
  margin-bottom: 7px;
}

.lifePhaseText {
  font-size: 12px;
  line-height: 1.45;
  color: #526174;
}

.lifePhasesPrinciple {
  margin-top: 20px;
  text-align: center;
  font-size: 19px;
  font-weight: 500;
  color: #4E79BD;
}

.lifePhasesFooter {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 7px;
  border-top: 1px solid #e5e7eb;
  margin-top: 18px;
  padding-top: 15px;
  font-family: Arial, sans-serif;
  font-size: 11px;
  color: #64748b;
}

.lifePhasesFooter > svg {
  width: 13px;
  height: 13px;
  color: #4E79BD;
}

.lifePhasesFooter a {
  color: #4E79BD;
  text-decoration: none;
}

.lifePhasesFooter a:hover {
  text-decoration: underline;
}

.lifePhasesSeparator {
  color: #94a3b8;
}

/* RESPONSIVE */

@media (max-width: 650px) {

  .lifePhases {
    padding: 18px 15px;
  }

  .lifePhasesGrid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px 16px;
  }

