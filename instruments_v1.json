function sendToMyWealth(source){

  if(!["assets", "portfolios"].includes(source)){
    return;
  }

  const ids =
    source === "assets"
      ? [...APP.assets]
      : APP.planSlots
          .map(s => s.modelNo)
          .filter(id => id !== "" && id != null);

  if(!ids.length){
    return;
  }

  myWealthMode =
    source === "assets"
      ? "stocks"
      : "portfolios";

  APP.myWealth.source = source;
  APP.myWealth.ids = ids.slice(0, 5);
  APP.myWealth.selectedIndex = 0;

  // Reset MyWealth to initial state
  MYWEALTH_VIEW.horizon = 0;
  MYWEALTH_VIEW.metric = "wealth";

  // Navigate to MyWealth
MYWEALTH_INTERACTION.hoverIndex = -1;
MYWEALTH_INTERACTION.selectedId = null;
  openTab("mywealth");

  // Synchronize controls, received state and chart
  renderMyWealth();

}


