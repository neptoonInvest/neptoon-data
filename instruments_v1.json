function guardWelcomeAges(){

  const currentEl = byId("currentAge");
  const deathEl = byId("deathAge");

  if(!currentEl || !deathEl) return;

  const normalize = (el, fallback, min, max) => {

    const raw = Number(el.value);

    const value = Number.isFinite(raw) && el.value !== ""
      ? raw
      : fallback;

    const integer = Math.round(value);

    const guarded = Math.min(
      max,
      Math.max(min, integer)
    );

    el.value = String(guarded);

    return guarded;
  };

  const currentAge = normalize(
    currentEl, 50, 18, 99
  );

  normalize(
    deathEl,
    90,
    currentAge + 1,
    120
  );

}



function collectDirectAssetAssumptions(){

  const isDA = INIT.lang === "da";

  const readPercent = id => {
    const el = document.getElementById(id);
    if(!el || !el.value.trim()) return null;

    const n = Number(
      el.value.trim().replace("%", "").replace(",", ".")
    );

    return Number.isFinite(n) ? n / 100 : null;
  };

  return {

    realEstate: {
      nominalReturn: readPercent("assetReturnRealEstate"),
      capitalTax: readPercent("assetTaxRealEstate"),
      annualTax: 0
    },

    enterprise: {
      nominalReturn: readPercent("assetReturnEnterprise"),
      capitalTax: readPercent("assetTaxEnterprise"),
      annualTax: 0
    },

    privatePension: {
      nominalReturn: readPercent("assetReturnPrivatePension"),
      capitalTax: readPercent("assetTaxPrivatePension"),
      annualTax: isDA ? 0.153 : 0
    },

other: Array.from({length:4}, (_,i) => ({
  nominalReturn: null,
  capitalTax: 0,
  annualTax: !isDA
    ? 0
    : i === 0
      ? 0.17
      : i === 1
        ? 0.153
        : 0
}))

  };

}
function readOtherImpliedReturn(index){

  const id =
    index === 0
      ? "otherImpliedReturn"
      : `otherImpliedReturn${index + 1}`;

  const el = byId(id);

  if(!el) return null;

  const raw = String(el.value || "")
    .replace("%", "")
    .replace(/\s/g, "")
    .replace(",", ".");

  if(!raw) return null;

  const value = Number(raw);

  return Number.isFinite(value)
    ? value / 100
    : null;
}

function assetAssumptionStatusHTML(data){

  const isDA = INIT.lang === "da";

  const format = value =>
    value == null
      ? "—"
      : (value * 100).toLocaleString(
          isDA ? "da-DK" : "en-GB",
          {
            minimumFractionDigits:2,
            maximumFractionDigits:2
          }
        ) + "%";

  const labels = isDA
    ? ["Nominelt afkast", "Realisationsskat", "Lagerskat"]
    : ["Nominal return", "Capital gains tax", "Mark-to-market tax"];

  const icons = [
    `<svg viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="1.7">
       <path d="M3 17l6-6 4 4 8-8"/>
       <path d="M15 7h6v6"/>
     </svg>`,

    `<svg viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="1.7">
       <path d="M3 10h18M5 10v9m5-9v9m4-9v9m5-9v9M2 21h20"/>
       <path d="M2 10l10-7 10 7"/>
     </svg>`,

    `<svg viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="1.7">
       <rect x="3" y="5" width="18" height="16"/>
       <path d="M7 3v4M17 3v4M3 10h18"/>
     </svg>`
  ];

  const values = [
    data.nominalReturn,
    data.capitalTax,
    data.annualTax
  ];

  return `
    <div class="assetAssumptionMetrics">
      ${values.map((value,i) => `
        <span class="assetAssumptionMetric">
          <span class="assetAssumptionIcon">
            ${icons[i]}
          </span>
          <span class="assetAssumptionLabel">
            ${labels[i]}
          </span>
          <strong class="assetAssumptionValue">
            ${format(value)}
          </strong>
        </span>
      `).join("")}
    </div>
  `;

}


function paintAssetAssumptionStatus(){

  const assumptions = collectDirectAssetAssumptions();

  function paint(identity, data){

    if(!identity || !data) return;

const row = identity.closest(".componentRow");

let status = row.querySelector(
  ".assetAssumptionStatus"
);

    if(!status){
      status = document.createElement("div");
      status.className = "assetAssumptionStatus";
identity.closest(".componentRow").appendChild(status);
    }

    status.innerHTML = assetAssumptionStatusHTML(data);
  }

  const assetPanels = [
    ["realEstate", assumptions.realEstate],
    ["enterprise", assumptions.enterprise],
    ["privatePension", assumptions.privatePension]
  ];

  assetPanels.forEach(([panel,data]) => {

    const identity = document.querySelector(
      `[data-panel="${panel}"] .componentIdentity`
    );

    paint(identity, data);

  });


document.querySelectorAll(
  '[data-panel="other"] .otherAssetRow'
).forEach((row,index) => {

  const data = {
    ...assumptions.other[index],

    // Display-only mirror of the implied return
    nominalReturn: readOtherImpliedReturn(index)
  };

  paint(
    row.querySelector(".componentIdentity"),
    data
  );

});
}

