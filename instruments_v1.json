    margin:7px 0 10px;
  }

  .lifecyclePanel .freedomSubtext{
    font-size:12px;
    line-height:1.65;
  }


  /* FINANCIAL FREEDOM RESULT */

  .lifecyclePanel .freedomBox{
    width:100%;
    min-width:0;
    max-width:100%;
    box-sizing:border-box;
    padding:16px 12px;
    margin:0;
