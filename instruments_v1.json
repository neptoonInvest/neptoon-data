   MY ACCOUNT — HOLDINGS TABLE
========================================== */
/* ==========================================
   MY ACCOUNT — HOLDINGS TABLE
========================================== */

.accountHoldingsPanel {
  margin-top: 12px;
  overflow-x: auto;
}

.accountHoldingsTable {
  width: 100%;
  border-collapse: collapse;
  font-family: Arial, sans-serif;
  font-size: 11px;
  table-layout: auto;
}

.accountHoldingsTable th {
  padding: 9px 6px;
  text-align: left;
  font-size: 10px;
  font-weight: 600;
  color: #64748b;
  border-bottom: 1px solid #dbe3ef;
  white-space: nowrap;
}

.accountHoldingsTable td {
  padding: 10px 6px;
  vertical-align: middle;
  border-bottom: 1px solid #edf1f6;
  color: #26364c;
}

.accountHoldingsTable tbody tr:last-child td {
  border-bottom: none;
}

/* Instrument column */

.accountHoldingsTable th:first-child,
.accountHoldingsTable td:first-child {
  width: 46%;
  min-width: 150px;
