/* MY SETTINGS · accordion controller. Call initAccountNavigator() once after HTML exists. */
function initAccountNavigator(){
  const root=document.getElementById('tabAccount');
  if(!root || root.dataset.navigatorBound==='1') return;
  root.dataset.navigatorBound='1';
  const buttons=[...root.querySelectorAll('.accountNavRow[data-account-section]')];
  function openSection(section){
    buttons.forEach(button=>{
      const selected=button.dataset.accountSection===section;
      const body=document.getElementById(button.getAttribute('aria-controls'));
      button.setAttribute('aria-expanded',String(selected));
      if(body) body.hidden=!selected;
    });
    // The existing assumptions body has its own toggle; leave that state unchanged.
  }
  buttons.forEach(button=>button.addEventListener('click',()=>{
    const section=button.dataset.accountSection;
    const isOpen=button.getAttribute('aria-expanded')==='true';
    openSection(isOpen?null:section);
  }));
  openSection(null);
}

function paintFutureResourceRates(){

  const currentAge =
    clamp(
      numberValue("currentAge"),
      18,
      99
    );

  const resources = [

    {
      today:"heritageValueToday",
      future:"heritageAmount",
      age:"heritageAge",
      output:"heritageImpliedReturn"
    },

    ...["", "2", "3", "4"].map(suffix => ({
      today:`otherValueToday${suffix}`,
      future:`otherAmount${suffix}`,
      age:`otherAge${suffix}`,
      output:`otherImpliedReturn${suffix}`
    }))

  ];



  for(const resource of resources){

    const todayEl = byId(resource.today);
    const futureEl = byId(resource.future);
    const ageEl = byId(resource.age);
    const output = byId(resource.output);

    const today = moneyValue(resource.today);
    const future = moneyValue(resource.future);
    const age = numberValue(resource.age);

    const rate =
      calculateFutureResourceRate(
        today,
        future,
        currentAge,
        age
      );



    if(!output){
      console.warn(
        "MISSING OUTPUT ELEMENT:",
        resource.output
      );
      continue;
    }

    output.value =
      rate === null
        ? "—"
        : (rate * 100).toLocaleString(
            INIT?.lang === "da"
              ? "da-DK"
              : "en-US",
            {
              minimumFractionDigits:2,
              maximumFractionDigits:2
            }
          ) + " %";

  }



}

   
