  }

  #page-mywealth .mywealth-history-heading h3{
    font-size:19px;
  }

  #page-mywealth .mywealth-history-period{
    font-size:9px;
    padding:7px;
  }

  #page-mywealth .mywealth-history-controls{
    grid-template-columns:1fr;
    gap:12px;
    padding:13px 0;
  }

  #page-mywealth .mywealth-history-control-label{
    grid-column:auto;
  }

  #page-mywealth .mywealth-history-method{
    justify-self:stretch;
    width:100%;
  }

  #page-mywealth .mywealth-history-method-btn{
    flex:1;
    padding:11px 8px;
    font-size:10px;
  }

  #page-mywealth .mywealth-history-play{
    justify-self:stretch;
    width:100%;
  }

  #page-mywealth .mywealth-history-nav-grid{
    gap:8px;
  }

  #page-mywealth .mywealth-history-nav-card{
    padding:12px;
  }

  #page-mywealth .mywealth-history-nav-label{
    font-size:10px;
  }

  #page-mywealth .mywealth-history-nav-card strong{
    font-size:22px;
  }

  #page-mywealth .mywealth-history-chart{
    height:230px;
  }

  #page-mywealth .mywealth-history-verdict{
    padding:12px;
  }

  #page-mywealth .mywealth-history-verdict-grid{
    grid-template-columns:1fr;
    gap:10px;
  }

  #page-mywealth .mywealth-history-verdict-card{
    padding:14px;
  }

}


/* ================================================
   MARKET RACE · FIVE LIVE METRICS
================================================ */

.mywealth-history-nav-grid{
  display:grid;
  grid-template-columns:repeat(5,minmax(0,1fr));
  gap:8px;
  width:100%;
  margin:12px 0;
}

.mywealth-history-nav-card{
  min-width:0;
  padding:12px 10px;
  border:1px solid #DCE4F0;
  background:#FFFFFF;
  border-radius:0;
  display:flex;
  flex-direction:column;
  justify-content:center;
  gap:7px;
}

.mywealth-history-nav-card > span{
  display:block;
  color:#64748B;
  font-size:10px;
  font-weight:700;
  letter-spacing:.04em;
  white-space:nowrap;
}

.mywealth-history-nav-card > strong{
  display:block;
  color:#081735;
  font-size:clamp(13px,2vw,23px);
  font-weight:800;
  line-height:1.15;
  font-variant-numeric:tabular-nums;
  white-space:nowrap;
}

/* MOBILE · KEEP FIVE COLUMNS */

@media(max-width:600px){

  .mywealth-history-nav-grid{
    grid-template-columns:repeat(5,minmax(0,1fr));
    gap:4px;
  }

  .mywealth-history-nav-card{
    padding:9px 4px;
    gap:6px;
  }

  .mywealth-history-nav-card > span{
    font-size:8px;
    letter-spacing:0;
  }

  .mywealth-history-nav-card > strong{
    font-size:clamp(11px,2.8vw,15px);
  }

}


/* ================================================
   MYWEALTH · FIVE HORIZONTAL LIVE METRICS
================================================ */

#page-mywealth .mywealth-history-nav-grid{
  display:grid;
  grid-template-columns:repeat(5,minmax(0,1fr));
  gap:6px;
  width:100%;
  margin:12px 0;
}

#page-mywealth .mywealth-history-nav-card{
  display:flex;
  flex-direction:column;
  justify-content:center;
  min-width:0;
  padding:12px 10px;
  gap:7px;
  background:#FFFFFF;
  border:1px solid #DCE4F0;
  border-radius:0;
}

#page-mywealth .mywealth-history-nav-card > span{
  display:block;
  color:#64748B;
  font-size:10px;
  font-weight:700;
  letter-spacing:.03em;
  white-space:nowrap;
}

#page-mywealth .mywealth-history-nav-card > strong{
  display:block;
  color:#081735;
  font-size:clamp(13px,1.8vw,22px);
  font-weight:800;
  line-height:1.2;
  font-variant-numeric:tabular-nums;
  white-space:nowrap;
}

/* ================================================
   MOBILE · STILL FIVE COLUMNS
================================================ */

@media(max-width:600px){

  #page-mywealth .mywealth-history-nav-grid{
    grid-template-columns:repeat(5,minmax(0,1fr));
    gap:4px;
  }

  #page-mywealth .mywealth-history-nav-card{
    padding:9px 4px;
    gap:5px;
  }

  #page-mywealth .mywealth-history-nav-card > span{
    font-size:8px;
    letter-spacing:0;
  }

  #page-mywealth .mywealth-history-nav-card > strong{
    font-size:clamp(10px,2.7vw,15px);
  }

}


/* =====================================================
   NEPTOON · TIME MACHINE
   MOBILE FIRST · NW-211
===================================================== */

#page-history{
  --tm-blue:#4E79BD;
  --tm-navy:#081735;
  --tm-panel:#102747;
  --tm-panel-light:#173354;
  --tm-border:#294461;
  --tm-text:#ffffff;
  --tm-muted:#a9bdd5;
  --tm-red:#f07882;
  --tm-green:#69c9a4;

  color:var(--tm-text);
  padding-bottom:90px;
}

/* =========================================
   INTRODUCTION
========================================= */

#page-history .tm-intro{
  text-align:center;
  padding:10px 4px 14px;
}

#page-history .tm-title{
  margin:0;
  font-size:clamp(25px,6vw,34px);
  font-weight:750;
  line-height:1.15;
  letter-spacing:-.7px;
  color:var(--tm-text);
}

#page-history .tm-subtitle{
  margin:10px auto 0;
  max-width:340px;
  font-size:13px;
  line-height:1.5;
  color:var(--tm-muted);
}

/* =========================================
   MAIN CINEMA PANEL
========================================= */

#page-history .tm-cinema{
  background:var(--tm-navy);
  border:1px solid var(--tm-border);
  border-radius:0;
  padding:14px 10px 12px;
  overflow:hidden;
}

/* =========================================
   CHAPTER PAGINATION
========================================= */

#page-history .tm-chapter-nav{
  display:grid;
  grid-template-columns:42px minmax(0,1fr) 42px;
  align-items:center;
  gap:6px;
  margin-bottom:16px;
}

#page-history .tm-chapter-arrow{
  width:42px;
  height:46px;
  display:flex;
  align-items:center;
  justify-content:center;

  background:var(--tm-panel-light);
  border:1px solid var(--tm-border);
  border-radius:0;

  color:#fff;
  font-size:24px;
  cursor:pointer;
  touch-action:manipulation;
}

#page-history .tm-chapter-arrow:disabled{
  opacity:.3;
  cursor:default;
}

#page-history .tm-chapter-arrow:active:not(:disabled){
  background:var(--tm-blue);
}

#page-history .tm-chapter-center{
  min-width:0;
  text-align:center;
}

#page-history .tm-chapter-kicker{
  font-size:10px;
  font-weight:700;
  letter-spacing:2px;
  color:var(--tm-muted);
}

#page-history .tm-chapter-period{
  margin:4px 0;
  font-size:clamp(23px,6vw,30px);
  font-weight:750;
  line-height:1.15;
  letter-spacing:-.6px;
  color:#fff;
}

#page-history .tm-chapter-label{
  font-size:12px;
  line-height:1.35;
  font-weight:600;
  color:#9fc5ff;
  min-height:16px;
}

/* =========================================
   LIVE METRICS
========================================= */

#page-history .tm-metrics{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:7px;
  margin-bottom:15px;
}

#page-history .tm-metric{
  min-width:0;
  padding:12px 5px;
  text-align:center;

  background:var(--tm-panel);
  border:1px solid var(--tm-border);
  border-radius:0;
}

#page-history .tm-metric-label{
  margin-bottom:7px;
  font-size:10px;
  font-weight:700;
  letter-spacing:.6px;
  color:var(--tm-muted);
}

#page-history .tm-metric-value{
  font-size:clamp(15px,4.5vw,21px);
  font-weight:750;
  letter-spacing:-.5px;
  font-variant-numeric:tabular-nums;
  white-space:nowrap;
  color:#fff;
}

#page-history .tm-metric-value.negative{
  color:var(--tm-red);
}

#page-history .tm-metric-value.positive{
  color:var(--tm-green);
}

/* =========================================
   HISTORICAL DATE
========================================= */

#page-history .tm-date-row{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:10px;
  padding:0 5px 10px;
}

#page-history .tm-date-label{
  font-size:10px;
  letter-spacing:1px;
  font-weight:650;
  color:var(--tm-muted);
}

#page-history .tm-current-date{
  font-size:12px;
  font-weight:750;
  letter-spacing:.5px;
  color:#fff;
  font-variant-numeric:tabular-nums;
}

/* =========================================
   CHART
========================================= */

#page-history .tm-chart-wrap{
  position:relative;
  width:100%;
  height:clamp(205px,65vw,290px);
  min-height:205px;
  overflow:hidden;
}

#page-history #history-canvas{
  display:block;
  width:100%;
  height:100%;
  border:0;
  border-radius:0;
  background:transparent;
}

/* =========================================
   MONTH SCRUBBER
========================================= */

#page-history .tm-progress-wrap{
  padding:7px 5px 0;
}

#page-history .tm-progress{
  display:block;
  width:100%;
  height:22px;
  margin:0;
  padding:0;
  background:transparent;
  accent-color:var(--tm-blue);
  cursor:pointer;
  touch-action:pan-y;
}

#page-history .tm-progress::-webkit-slider-runnable-track{
  height:3px;
  background:#365575;
  border-radius:0;
}

#page-history .tm-progress::-webkit-slider-thumb{
  -webkit-appearance:none;
  appearance:none;
  width:15px;
  height:15px;
  margin-top:-6px;
  background:#72baff;
  border:2px solid #fff;
  border-radius:0;
}

#page-history .tm-progress::-moz-range-track{
  height:3px;
  background:#365575;
  border-radius:0;
}

#page-history .tm-progress::-moz-range-thumb{
  width:13px;
  height:13px;
  background:#72baff;
  border:2px solid #fff;
  border-radius:0;
}

#page-history .tm-progress-labels{
  display:flex;
  justify-content:space-between;
  gap:10px;
  margin-top:1px;

  font-size:10px;
  font-weight:600;
  color:var(--tm-muted);
  letter-spacing:.3px;
}

/* =========================================
   CINEMA CONTROLS
========================================= */

#page-history .tm-controls{
  margin-top:12px;
}

#page-history .tm-playback-row{
  display:grid;
  grid-template-columns:46px minmax(95px,1fr) minmax(145px,1.25fr);
  align-items:stretch;
  gap:7px;
}

#page-history .tm-replay-btn,
#page-history .tm-play-btn,
#page-history .tm-speed,
#page-history .tm-mode-btn{
  font-family:inherit;
  border-radius:0;
  cursor:pointer;
  touch-action:manipulation;
}

#page-history .tm-replay-btn{
  min-height:48px;
  background:var(--tm-panel);
  border:1px solid var(--tm-border);
  color:#fff;
  font-size:28px;
}

#page-history .tm-play-btn{
  min-height:48px;
  display:flex;
  align-items:center;
  justify-content:center;
  gap:9px;

  background:var(--tm-blue);
  border:1px solid #7aabec;
  color:#fff;

  font-size:14px;
  font-weight:750;
  letter-spacing:.3px;
}

#page-history #tm-play-icon{
  font-size:17px;
  line-height:1;
}

#page-history .tm-speed-controls{
  display:grid;
  grid-template-columns:repeat(4,minmax(0,1fr));
  align-items:stretch;
  padding:3px;

  background:var(--tm-panel);
  border:1px solid var(--tm-border);
  min-width:0;
}

#page-history .tm-speed{
  min-width:0;
  padding:0 2px;
  background:transparent;
  border:0;
  color:var(--tm-muted);
  font-size:12px;
  font-weight:700;
}

#page-history .tm-speed.active{
  background:var(--tm-blue);
  color:#fff;
}

/* =========================================
   NOMINAL / REAL
========================================= */

#page-history .tm-return-mode{
  margin-top:12px;
}

#page-history .tm-mode-controls{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:0;
  width:100%;
  border:1px solid var(--tm-border);
  background:var(--tm-panel);
}

#page-history .tm-mode-btn{
  min-height:42px;
  background:transparent;
  border:0;
  color:var(--tm-muted);
  font-size:12px;
  font-weight:750;
  letter-spacing:1px;
}

#page-history .tm-mode-btn + .tm-mode-btn{
  border-left:1px solid var(--tm-border);
}

#page-history .tm-mode-btn.active{
  background:var(--tm-blue);
  color:#fff;
}

/* =========================================
   EDUCATIONAL MESSAGE
========================================= */

#page-history .tm-message{
  display:flex;
  align-items:center;
  gap:13px;
  margin-top:14px;
  padding:15px;

  background:var(--tm-panel);
  border:1px solid var(--tm-border);
  border-radius:0;
}

#page-history .tm-message-icon{
  flex:0 0 auto;
  display:flex;
  justify-content:center;
  align-items:center;

  width:28px;
  height:28px;
  border:1px solid #9fc5ff;
  border-radius:0;

  color:#9fc5ff;
  font-size:17px;
  font-weight:700;
}

#page-history .tm-message p{
  margin:0;
  font-size:13px;
  font-weight:600;
  line-height:1.55;
  color:#fff;
}

/* =========================================
   DATA SOURCE
========================================= */

#page-history .tm-footnote{
  padding:6px 4px 12px;
}

#page-history .tm-footnote p{
  margin:0;
  font-size:10px;
  line-height:1.6;
  color:var(--tm-muted);
}

/* =========================================
   TOUCH / FOCUS
========================================= */

#page-history button:focus-visible,
#page-history input:focus-visible{
  outline:2px solid #9fc5ff;
  outline-offset:2px;
}

#page-history button{
  -webkit-tap-highlight-color:transparent;
}

/* =========================================
   VERY SMALL MOBILE SCREENS
========================================= */

@media(max-width:360px){

  #page-history .tm-cinema{
    padding:12px 7px;
  }

  #page-history .tm-metrics{
    gap:4px;
  }

  #page-history .tm-metric{
    padding:10px 3px;
  }

  #page-history .tm-metric-value{
    font-size:14px;
  }

  #page-history .tm-playback-row{
    grid-template-columns:42px minmax(80px,1fr) minmax(130px,1.3fr);
    gap:5px;
  }

  #page-history .tm-speed{
    font-size:11px;
  }

}

/* =========================================
   TABLET / DESKTOP
========================================= */

@media(min-width:700px){

  #page-history .tm-intro,
  #page-history .tm-cinema,
  #page-history .tm-controls,
  #page-history .tm-return-mode,
  #page-history .tm-message,
  #page-history .tm-footnote{
    max-width:650px;
    margin-left:auto;
    margin-right:auto;
  }

  #page-history .tm-chart-wrap{
    height:320px;
  }

  #page-history .tm-metric-value{
    font-size:24px;
  }

  #page-history .tm-playback-row{
    grid-template-columns:60px 1fr 1.2fr;
    gap:12px;
  }

}

#page-history .tm-chart-wrap{
  height:260px;
}

#page-history #history-canvas{
  display:block;
  width:100%;
  height:100%;
}



/* =========================================
   TIME MACHINE · MATCH APP PAGE WIDTH
========================================= */

#page-history .tm-intro,
#page-history .tm-cinema,
#page-history .tm-controls,
#page-history .tm-return-mode,
#page-history .tm-message,
#page-history .tm-footnote {
  width: 100%;
  max-width: none !important;
  margin-left: 0;
  margin-right: 0;
  box-sizing: border-box;
}

#page-history .tm-chart-wrap {
  width: 100%;
  max-width: none;
}






/* =========================================
   TIME MACHINE · HISTORICAL STATISTICS
========================================= */

#page-history .tm-statistics{
  width:100%;
  max-width:none;
  box-sizing:border-box;
  border-radius:0;
}

#page-history .tm-statistics-head{
  margin-bottom:20px;
}

#page-history .tm-statistics-kicker{
  font-size:10px;
  font-weight:700;
  letter-spacing:1.2px;
  color:#75d7ec;
  margin-bottom:8px;
}

#page-history .tm-statistics-title{
  margin:0 0 5px;
  font-size:22px;
  font-weight:750;
  color:#fff;
}

#page-history .tm-statistics-subtitle{
  margin:0;
  font-size:12px;
  color:#a9bdd5;
}

#page-history .tm-statistics-scroll{
  width:100%;
  overflow-x:auto;
}

#page-history .tm-statistics-table{
  width:100%;
  border-collapse:collapse;
  table-layout:fixed;
}

#page-history .tm-statistics-table th{
  padding:12px 8px;
  border-bottom:1px solid #355174;
  text-align:left;
  font-size:10px;
  font-weight:700;
  letter-spacing:.35px;
  color:#a9bdd5;
}

#page-history .tm-statistics-table td{
  padding:12px 8px;
  border-bottom:1px solid #294461;
  font-size:12px;
  color:#fff;
  vertical-align:middle;
}

#page-history .tm-statistics-table th:nth-child(1){
  width:21%;
}

#page-history .tm-statistics-table th:nth-child(2){
  width:35%;
}

#page-history .tm-statistics-table th:nth-child(3),
#page-history .tm-statistics-table th:nth-child(4){
  width:22%;
}

#page-history .tm-statistics-table .tm-stats-number{
  text-align:right;
  font-variant-numeric:tabular-nums;
  white-space:nowrap;
}

#page-history .tm-statistics-table .tm-stats-era{
  color:#a9bdd5;
  font-size:11px;
}

#page-history .tm-statistics-table .positive{
  color:#69c9a4;
}

#page-history .tm-statistics-table .negative{
  color:#f07882;
}

#page-history .tm-statistics-table tbody tr{
  cursor:pointer;
}

#page-history .tm-statistics-table tbody tr:hover{
  background:rgba(78,121,189,.13);
}

#page-history .tm-statistics-table tbody tr.active{
  background:rgba(78,121,189,.22);
}

#page-history .tm-statistics-total td{
  padding-top:17px;
  padding-bottom:17px;
  font-weight:750;
  background:#173354;
  border-top:2px solid #4e79bd;
  border-bottom:0;
}

#page-history .tm-statistics-note{
  margin:15px 0 0;
  font-size:11px;
  line-height:1.6;
  color:#a9bdd5;
}

/* Mobile adjustments */

@media(max-width:480px){

  #page-history .tm-statistics-table th,
  #page-history .tm-statistics-table td{
    padding:11px 5px;
  }

  #page-history .tm-statistics-table th{
    font-size:9px;
  }

  #page-history .tm-statistics-table td{
    font-size:11px;
  }

  #page-history .tm-statistics-table .tm-stats-era{
    font-size:10px;
  }

}



