.lcCloudPrice strong {
  font-size: 27px;
  font-weight: 700;
}

.lcCloudPrice span {
  font-size: 12px;
  color: #64748b;
}

.lcAccountFeatures {
  display: grid;
  gap: 11px;
  margin: 0 0 24px;
  padding-top: 17px;
  border-top: 1px solid #e2e8f0;
}

.lcAccountFeatures > div {
  display: flex;
  gap: 10px;
  align-items: flex-start;
  font-size: 13px;
  line-height: 1.5;
}

.lcAccountFeatures > div > span:first-child {
  flex: 0 0 auto;
  color: #4E79BD;
  font-weight: 700;
}

.lcAccountCardFooter {
  margin-top: auto;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.lcAccountButton {
  display: block;
  width: 100%;
  padding: 13px 15px;
  border: 1px solid #4E79BD;
  border-radius: 0;
  font: inherit;
  font-size: 13px;
  font-weight: 700;
  text-align: center;
  cursor: pointer;
}

.lcAccountButtonPrimary {
  color: #fff;
  background: #4E79BD;
}

.lcAccountButtonSecondary {
  color: #64748b;
  background: #f1f5f9;
  border-color: #cbd5e1;
}

.lcAccountButton:disabled {
  cursor: not-allowed;
}

#liveDashboardDot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #16a34a;
}

#liveDashboardDot.pulse {
  animation: dashboardPulse 600ms ease-out;
}

@keyframes dashboardPulse {
  0%   { box-shadow: 0 0 0 0 rgba(22,163,74,.5); }
  100% { box-shadow: 0 0 0 9px rgba(22,163,74,0); }
}

.lcAccountButtonPrimary:disabled {
  opacity: .7;
}

.lcAccountButtonSecondary:disabled {
  opacity: .65;
}

.lcAccountCardFooter small {
  color: #64748b;
  font-size: 11px;
  line-height: 1.5;
  text-align: center;
}

/* ACCOUNT STATUS */

.lcAccountStatus {
  margin-top: 18px;
  padding: 20px 24px;
  border: 1px solid #dbe3ee;
  background: #fff;
}

.lcAccountStatusHeader {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 16px;
}

.lcAccountStatusHeader h3 {
  margin: 0;
  font-size: 17px;
}

.lcAccountStatusGrid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20px;
}

.lcAccountStatusGrid > div {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.lcAccountStatusGrid > div > span {
  font-size: 11px;
  color: #64748b;
}

.lcAccountStatusGrid strong {
  font-size: 13px;
}

/* PREFERENCES */

.lcAccountPreferences {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-top: 18px;
  padding: 16px 0;
  border-top: 1px solid #e2e8f0;
}

.lcAccountPreferences label {
  font-size: 13px;
  font-weight: 700;
}

.lcAccountPreferences select {
  padding: 8px 12px;
  border: 1px solid #cbd5e1;
  border-radius: 0;
  background: #fff;
}

.lcAccountPrivacy {
  margin-left: auto;
  color: #64748b;
  font-size: 11px;
}

/* RESPONSIVE */

@media (max-width: 760px) {

  .lcAccountGrid {
    grid-template-columns: 1fr;
  }

  .lcAccountStatusGrid {
    grid-template-columns: 1fr;
    gap: 14px;
  }

  .lcAccountPreferences {
    flex-wrap: wrap;
  }

  .lcAccountPrivacy {
    margin-left: 0;
    width: 100%;
  }

}

  
