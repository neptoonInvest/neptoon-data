function drawMyWealthRace(){

  const canvas =
    document.getElementById("mywealth-race-canvas");

  const received =
    document.getElementById("mywealth-received");

  if(
    !canvas ||
    !received ||
    received.hidden ||
    !received.getClientRects().length
  ){
    return;
  }

  const ctx = canvas.getContext("2d");
  if(!ctx) return;

  const isCosts =
    myWealthMode === "portfolios" &&
    MYWEALTH_VIEW.metric === "costs";

  /*
    Wealth:
      Individual 30Y wealth scale.

    Costs:
      Individual 30Y cost impact scale.
  */

  const investments =
    (
      isCosts
        ? getMyWealthCostBarScale()
        : getMyWealthBarScale()
    ).slice(0,5);

  if(!investments.length) return;

  const rect = canvas.getBoundingClientRect();
  const width = rect.width;

  if(width <= 0) return;

  const compact = width < 500;

  const rowH = compact ? 66 : 70;
  const topPad = 16;
  const bottomPad = 18;

  const height =
    topPad +
    investments.length * rowH +
    bottomPad;

  const dpr =
    Math.min(window.devicePixelRatio || 1,2);

  canvas.style.height = `${height}px`;

  canvas.width = Math.round(width*dpr);
  canvas.height = Math.round(height*dpr);

  ctx.setTransform(dpr,0,0,dpr,0,0);
  ctx.clearRect(0,0,width,height);

  const colors = [
    "#4E79BD",
    "#8B62C9",
    "#16A6C7",
    "#218C70",
    "#D39A43"
  ];

  const locale =
    APP.lang === "da" ? "da-DK" : "en-US";

  const money = value =>
    Number.isFinite(value)
      ? Math.round(value).toLocaleString(locale)
      : "—";

  const compactMoney = value => {

    if(!Number.isFinite(value)) return "—";

    if(Math.abs(value) >= 1000000){
      return (
        (value/1000000).toLocaleString(
          locale,
          {maximumFractionDigits:2}
        ) + "M"
      );
    }

    if(Math.abs(value) >= 1000){
      return (
        (value/1000).toLocaleString(
          locale,
          {maximumFractionDigits:0}
        ) + "K"
      );
    }

    return money(value);
  };

  const left = compact ? 38 : 52;
  const right = compact ? 12 : 20;

  const barX = left;
  const barW = width-left-right;
  const barH = compact ? 9 : 11;

  investments.forEach((p,i) => {

    const y = topPad + i*rowH;

/* Hover and selected row background */

const isHovered =
  MYWEALTH_INTERACTION.hoverIndex === i;

const isSelected =
  MYWEALTH_INTERACTION.selectedId != null &&
  String(MYWEALTH_INTERACTION.selectedId) === String(p.id);

if(isHovered || isSelected){

  ctx.fillStyle =
    isHovered
      ? "#EAF1FB"
      : "#F1F5FA";

  ctx.fillRect(
    0,
    y - 2,
    width,
    rowH - 2
  );

}

if(isSelected){

  ctx.fillStyle = "#4E79BD";

  ctx.fillRect(
    0,
    y - 2,
    3,
    rowH - 2
  );

}

    /* Ranking */

    ctx.fillStyle = "#64748b";
    ctx.font = "11px Arial";
    ctx.textAlign = "center";
    ctx.textBaseline = "middle";

    ctx.fillText(
      String(i+1),
      left/2,
      y+12
    );

    /* Investment name */

    ctx.fillStyle = "#173B70";
    ctx.font = "bold 12px Arial";
    ctx.textAlign = "left";

    const name = p.name;

    const maxNameWidth =
      compact ? width*0.48 : width*0.60;

    let displayName = String(name || p.id);

    while(
      displayName.length > 3 &&
      ctx.measureText(displayName).width > maxNameWidth
    ){
      displayName = displayName.slice(0,-1);
    }

    if(displayName !== name){
      displayName =
        displayName.slice(0,-1) + "…";
    }

    ctx.fillText(
      displayName,
      barX,
      y+12
    );

    /* Right side: monetary value */

    ctx.textAlign = "right";

    ctx.fillStyle = "#173B70";
    ctx.font = "bold 12px Arial";

    const value =
      isCosts
        ? p.costBarValue
        : p.barValue;

    ctx.fillText(
      compactMoney(value),
      width-right,
      y+9
    );

    ctx.fillStyle = "#64748b";
    ctx.font = "10px Arial";

    ctx.fillText(
      isCosts
        ? "Cost impact"
        : (p.expRetNet*100).toFixed(2)+"%",
      width-right,
      y+24
    );

    /* Background track */

    const trackY = y+37;

    ctx.fillStyle = "#eef0f3";

    ctx.fillRect(
      barX,
      trackY,
      barW,
      barH
    );

    /* Individual 30Y progress */

    const progress =
      isCosts
        ? p.costProgress
        : p.progress;

    ctx.fillStyle = colors[i];

    ctx.fillRect(
      barX,
      trackY,
      barW*progress,
      barH
    );

  });

}




