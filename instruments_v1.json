function dotsCountConverter(risk){
  const r = Number(risk);
  if(!Number.isFinite(r)) return 0;

  if(r <= 0.05) return 1;
  if(r <= 0.12) return 2;
  if(r <= 0.15) return 3;
  if(r <= 0.20) return 4;
  if(r <= 0.25) return 5;
  if(r <= 0.35) return 6;
  return 7;
}

/* =====================================================
   29 · MARKET PULSE · FORMATTING
===================================================== */

function marketFormatPrice(value, currency) {
  if (!Number.isFinite(value)) return '—';
  return new Intl.NumberFormat(APP.lang === 'da' ? 'da-DK' : 'en-GB', {
    style: 'currency',
    currency,
    maximumFractionDigits: 2
  }).format(value);
}

function marketFormatReturn(value) {
  if (!Number.isFinite(value)) return '—';
  return `${value > 0 ? '+' : ''}${(value * 100).toFixed(2)}%`;
}

/* =====================================================
   30 · MARKET PULSE · RENDER STOCK CAROUSEL
===================================================== */

function renderMarketPulse() {
  const track = $('market-stock-track');
  if (!track) return;

  const instruments = MARKET_STATE.instruments;
  const perPage = window.innerWidth <= 760 ? 2 : 5;
  const totalPages = Math.max(1, Math.ceil(instruments.length / perPage));
  MARKET_STATE.page = Math.max(0, Math.min(MARKET_STATE.page, totalPages - 1));

  const start = MARKET_STATE.page * perPage;
  const visible = instruments.slice(start, start + perPage);

  track.innerHTML = visible.map(item => {
    const direction = item.return == null
      ? 'unknown'
      : item.return >= 0 ? 'up' : 'down';

    return `
      <article class="market-stock-card">
        <div class="market-name">${esc(item.name)}</div>
        <div class="market-symbol">${esc(item.tickerExchange)}</div>
        <div class="market-price">${marketFormatPrice(item.realtimePrice, item.currency)}</div>
        <div class="market-change ${direction}">${marketFormatReturn(item.return)}</div>
      </article>
    `;
  }).join('');

  $('market-stock-count').textContent =
    `${start + 1}–${Math.min(start + perPage, instruments.length)} / ${instruments.length}`;
  $('market-page-label').textContent = `${MARKET_STATE.page + 1} / ${totalPages}`;
  $('market-prev').disabled = MARKET_STATE.page === 0;
  $('market-next').disabled = MARKET_STATE.page >= totalPages - 1;

  const stamp = $('market-timestamp');
  if (MARKET_STATE.updatedAt) {
    const date = new Date(MARKET_STATE.updatedAt);
    stamp.textContent = Number.isNaN(date.getTime())
      ? 'Latest available quotes'
      : `${APP.lang === 'da' ? 'Opdateret' : 'Updated'}: ${date.toLocaleString(APP.lang === 'da' ? 'da-DK' : 'en-GB')}`;
  } else {
    stamp.textContent = MARKET_STATE.error
      ? (APP.lang === 'da' ? 'Kurser ikke tilgængelige' : 'Quotes unavailable')
      : (APP.lang === 'da' ? 'Seneste tilgængelige kurser' : 'Latest available quotes');
  }

  $('market-kicker').textContent = APP.lang === 'da' ? 'MARKEDSOVERBLIK' : 'MARKET OVERVIEW';
  $('market-title').textContent = APP.lang === 'da' ? 'Markederne i dag' : 'Markets Today';
  $('market-stock-title').textContent = APP.lang === 'da' ? 'Aktier i fokus' : 'Stocks in focus';
  $('market-foot').textContent = APP.lang === 'da'
    ? 'Kurser kan være forsinkede. Dagens kursændring i forhold til forrige handelsdags slutkurs. Udbytter indgår ikke.'
    : 'Prices may be delayed. Daily price change versus previous trading close; dividends excluded.';
}

/* =====================================================
   31 · MARKET PULSE · PAGINATION + REFRESH
===================================================== */

$('market-prev').addEventListener('click', () => {
  MARKET_STATE.page -= 1;
  renderMarketPulse();
});

$('market-next').addEventListener('click', () => {
  MARKET_STATE.page += 1;
  renderMarketPulse();
});

window.addEventListener('resize', renderMarketPulse);


/* =====================================================
   32 · APPLICATION STARTUP
===================================================== */

async function initializeApp(){

  renderLanguage();
  openTab("welcome");

  /* ================================================
     MARKET DATA
  ================================================ */

  loadMarketPulse();

  // Start loading instruments independently.
  loadInstrumentDatabase();


  /* ================================================
     LOAD LIVE WEALTH PLANS
  ================================================ */

  // Wait for all 38 portfolio models and histories.
  await loadPortfolioDatabase();


  /* ================================================
     INITIALIZE WEALTHPLANS HISTORY
  ================================================ */

  // Install history listeners and resize observer.
  initPlanHistoryViewer();


  /* ================================================
     RENDER LIVE PORTFOLIOS
  ================================================ */

  // Includes portfolio basket, metrics,
  // expected wealth and historical chart.
  renderPortfolios();


  /* ================================================
     PORTFOLIO EVENT LISTENERS
  ================================================ */

  bindPortfolioSelectors();
  bindPortfolioModelSelection();
  bindPortfolioMetrics();
initMyWealthControls();
initMyWealthRaceInteraction();
initMyWealthCinema();
bindMyWealthComparisonToggle();

document
  .getElementById("mw-plan-download")
  ?.addEventListener("click", generateWealthPlanPDF);


  /* ================================================
     MARKET PULSE REFRESH
  ================================================ */

  setInterval(
    loadMarketPulse,
    15 * 60 * 1000
  );

}

initializeApp();

</script>
