const TIME_MACHINE_URL =
  "https://neptooninvest.github.io/neptoon-data/schiller_timeseries";

const TIME_MACHINE = {

  data:null,
  chapters:[],

  chapterIndex:0,
  monthIndex:0,

  mode:"nominal",
  speed:1,

  playing:false,
  completed:false,

  raf:null,
  lastFrame:null,
  elapsed:0,

  initialized:false,
  loading:null

};


/* =====================================================
   HELPERS
===================================================== */

function tmEl(id){
  return document.getElementById(id);
}

function tmLang(){
  return INIT.lang === "da" ? "da" : "en";
}

function tmText(da,en){
  return tmLang() === "da" ? da : en;
}

function tmCurrentChapter(){
  return TIME_MACHINE.chapters[
    TIME_MACHINE.chapterIndex
  ] || null;
}

function tmCurrentSeries(){
  return tmCurrentChapter()?.series || [];
}

function tmNAVKey(){
  return TIME_MACHINE.mode === "real"
    ? "sp500_real"
    : "sp500_nom";
}

function tmFormatNumber(value){

  return Number(value).toLocaleString(
    tmLang() === "da" ? "da-DK" : "en-US",
    {
      maximumFractionDigits:0
    }
  );

}

function tmFormatPercent(value){

  const sign = value > 0 ? "+" : "";

  return sign + Number(value).toLocaleString(
    tmLang() === "da" ? "da-DK" : "en-US",
    {
      minimumFractionDigits:1,
      maximumFractionDigits:1
    }
  ) + "%";

}

function tmFormatDate(month){

  if(!month) return "—";

  const [year,m] = month.split("-").map(Number);

  const date = new Date(
    Date.UTC(year,m-1,1)
  );

  return new Intl.DateTimeFormat(
    tmLang() === "da" ? "da-DK" : "en-US",
    {
      month:"short",
      year:"numeric",
      timeZone:"UTC"
    }
  ).format(date).toUpperCase();

}


/* =====================================================
   LOAD GITHUB DATA
===================================================== */

async function loadTimeMachineData(){

  if(TIME_MACHINE.data){
    return TIME_MACHINE.data;
  }

  if(TIME_MACHINE.loading){
    return TIME_MACHINE.loading;
  }

  TIME_MACHINE.loading = (async () => {

    const response = await fetch(
      TIME_MACHINE_URL,
      {cache:"no-cache"}
    );

    if(!response.ok){
      throw new Error(
        "Time Machine JSON HTTP " + response.status
      );
    }

    const data = await response.json();

    if(
      !Array.isArray(data.chapters) ||
      !Array.isArray(data.nav)
    ){
      throw new Error(
        "Invalid Time Machine JSON structure"
      );
    }

    TIME_MACHINE.data = data;
    TIME_MACHINE.chapters = data.chapters;

    console.log(
      "TIME MACHINE DATA LOADED",
      {
        navCount:data.nav.length,
        chapters:data.chapters.length
      }
    );

    return data;

  })();

  try{
    return await TIME_MACHINE.loading;
  }finally{
    TIME_MACHINE.loading = null;
  }

}


/* =====================================================
   PLAYBACK STATE
===================================================== */

function tmPause(){

  TIME_MACHINE.playing = false;
  TIME_MACHINE.lastFrame = null;
  TIME_MACHINE.elapsed = 0;

  if(TIME_MACHINE.raf !== null){

    cancelAnimationFrame(TIME_MACHINE.raf);
    TIME_MACHINE.raf = null;

  }

  tmUpdatePlayButton();

}

function tmReplay(){

  tmPause();

  TIME_MACHINE.monthIndex = 0;
  TIME_MACHINE.completed = false;

  tmRender();

}

function tmPlay(){

  const series = tmCurrentSeries();

  if(series.length < 2) return;

  if(TIME_MACHINE.playing){
    tmPause();
    return;
  }

  if(
    TIME_MACHINE.monthIndex >=
    series.length - 1
  ){
    TIME_MACHINE.monthIndex = 0;
  }

  TIME_MACHINE.completed = false;
  TIME_MACHINE.playing = true;

  TIME_MACHINE.lastFrame = null;
  TIME_MACHINE.elapsed = 0;

  tmUpdatePlayButton();

  TIME_MACHINE.raf =
    requestAnimationFrame(tmFrame);

}

function tmFrame(timestamp){

  if(!TIME_MACHINE.playing) return;

  if(TIME_MACHINE.lastFrame === null){
    TIME_MACHINE.lastFrame = timestamp;
  }

  const delta = Math.min(
    timestamp - TIME_MACHINE.lastFrame,
    250
  );

  TIME_MACHINE.lastFrame = timestamp;

  TIME_MACHINE.elapsed += delta;

  /*
    1x = one historical month per second.
  */

const interval =
  1000 / (TIME_MACHINE.speed * 2);

  let changed = false;

  while(TIME_MACHINE.elapsed >= interval){

    TIME_MACHINE.elapsed -= interval;

    const series = tmCurrentSeries();

    if(
      TIME_MACHINE.monthIndex <
      series.length - 1
    ){

      TIME_MACHINE.monthIndex++;
      changed = true;

    }else{

      TIME_MACHINE.completed = true;
      tmPause();
      break;

    }

  }

  if(changed){

    tmRender();

    const series = tmCurrentSeries();

    if(
      TIME_MACHINE.monthIndex >=
      series.length - 1
    ){
      TIME_MACHINE.completed = true;
      tmPause();
    }

  }

  if(TIME_MACHINE.playing){

    TIME_MACHINE.raf =
      requestAnimationFrame(tmFrame);

  }

}


/* =====================================================
   CHAPTER NAVIGATION
===================================================== */

function tmSelectChapter(index){

  if(
    index < 0 ||
    index >= TIME_MACHINE.chapters.length
  ){
    return;
  }

  tmPause();

  TIME_MACHINE.chapterIndex = index;
  TIME_MACHINE.monthIndex = 0;
  TIME_MACHINE.completed = false;

  tmRender();

}

function tmNextChapter(){

  tmSelectChapter(
    TIME_MACHINE.chapterIndex + 1
  );

}

function tmPreviousChapter(){

  tmSelectChapter(
    TIME_MACHINE.chapterIndex - 1
  );

}


/* =====================================================
   MODE / SPEED
===================================================== */

function tmSetMode(mode){

  if(
    mode !== "nominal" &&
    mode !== "real"
  ){
    return;
  }

  TIME_MACHINE.mode = mode;

  tmRender();

}

function tmSetSpeed(speed){

  const value = Number(speed);

  if(
    !Number.isFinite(value) ||
    value <= 0
  ){
    return;
  }

  TIME_MACHINE.speed = value;
  TIME_MACHINE.elapsed = 0;

  tmRenderControls();

}


/* =====================================================
   METRICS
===================================================== */

function tmCalculateMetrics(){

  const series = tmCurrentSeries();
  const key = tmNAVKey();

  if(!series.length){
    return null;
  }

  const index = Math.min(
    TIME_MACHINE.monthIndex,
    series.length - 1
  );

  const current =
    Number(series[index][key]);

  const start =
    Number(series[0][key]);

  let peak = start;

  for(let i = 1; i <= index; i++){

    peak = Math.max(
      peak,
      Number(series[i][key])
    );

  }

  return {

    wealth:current * 1000,

    returnPct:
      (current / start - 1) * 100,

    drawdownPct:
      (current / peak - 1) * 100,

    date:series[index].date

  };

}


