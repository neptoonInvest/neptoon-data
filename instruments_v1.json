    document.getElementById("modelLabel");

  if(modelLabel){
    modelLabel.textContent = modelName;
  }

  const modelMeta =
    document.getElementById("modelMeta");

  if(modelMeta){

    modelMeta.textContent =
      [
        identity.issuer,
        identity.modelNo,
        identity.modelType,
        identity.ccy
      ]
        .filter(Boolean)
        .join(" · ") || "—";

  }


  /*
    =========================
    RISK CLASSIFICATION

    Exogenous 1–7 indicator.
    Read-only display.

