  border:1px solid #d7e0ec;
  border-radius:0;

  background:#fff;
  color:#172b4d;

  text-align:left;
  font-family:inherit;
  cursor:pointer;

  transition:
    border-color .15s ease,
    background .15s ease;
}

.lifeBalanceStateBtn:hover{
