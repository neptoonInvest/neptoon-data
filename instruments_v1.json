function calculateWelcomeInstrument(tickerExchange){

  const instrument =
    INSTRUMENT_STATE.all.find(
      x => x.tickerExchange === tickerExchange
    );

  if(!instrument) return null;

  const result = calcWealthGBM({
    W0: 100000,
    savingsMonthly: 0,
    horizon: 10,
    expRet: Number(instrument.expRetNet),
    risk: Number(instrument.risk)
  });

  return {
    instrument,
    ...result
  };

}


