}

.componentRow.future .miniField input:disabled{
  background:#f3f4f6;
  color:#4b5563;
}

.mortgageField{
margin-bottom:5px;
}

  
/* FIVE-TAB APP SHELL OVERRIDES */
body{padding:12px 12px 30px}

.neptoon-app{width:min(1260px,100%)}
.app-tab .page{width:100%;max-width:none}
.app-tab:not(.active){display:none!important}
[hidden]{display:none!important}


:root{--np-blue:#4E79BD;--np-ink:#14243a;--np-border:#dce3ed;--np-muted:#617186;--np-bg:#f5f7fb}
.neptoon-app{max-width:1260px;margin:0 auto;color:var(--np-ink);font-family:Georgia,'Times New Roman',serif;padding:0 16px 28px}
.app-header{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:23px 4px 16px;border-bottom:1px solid var(--np-border)}
.app-kicker{font:700 11px/1.5 Arial,sans-serif;letter-spacing:.13em;color:var(--np-blue)}.app-name{font-size:28px;font-weight:700}.app-header-actions{display:flex;gap:18px;align-items:center}
.app-account-label{font:12px Arial,sans-serif;color:var(--np-muted)}.lang-switch{display:flex;gap:4px}.lang-switch button,.mode-switch button,.app-nav button{cursor:pointer;border:1px solid transparent;background:transparent;color:var(--np-ink);font-family:Arial,sans-serif}
.lang-switch button{padding:7px 10px;font-size:12px}.lang-switch button.active{border-color:var(--np-blue);color:var(--np-blue)}
.app-nav{display:flex;gap:2px;flex-wrap:wrap;border-bottom:1px solid var(--np-border);margin-bottom:22px}.app-nav button{padding:15px 19px;font-size:13px;border-bottom:3px solid transparent}.app-nav button.active{border-bottom-color:var(--np-blue);color:var(--np-blue);font-weight:700}
.app-tab{display:none}.app-tab.active{display:block}.app-tab > *{margin-bottom:18px}
.mode-header{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:16px 20px;background:var(--np-bg);border:1px solid var(--np-border)}.mode-header h2{margin:3px 0;font-size:24px}.mode-header p{margin:4px 0 0;font-size:13px;color:var(--np-muted)}.mode-switch{display:flex;border:1px solid var(--np-border);background:white}.mode-switch button{min-width:90px;padding:11px 15px;font-weight:700;font-size:12px}.mode-switch button.active{background:var(--np-blue);color:white}
#scenarioInputsPanel{margin-bottom:16px}#scenarioInputsPanel .scenarioGrid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}#scenarioInputsPanel .scenarioField:has(#legacy),#scenarioInputsPanel .fireTargetCell{transition:box-shadow .2s,border-color .2s}
.app-config-panel{padding:22px;border:1px solid var(--np-border);background:white;margin-bottom:18px}.app-config-panel h2{margin:5px 0 10px}.app-config-panel p{color:var(--np-muted);line-height:1.5}.app-config-panel label{display:block;font:700 12px Arial,sans-serif;margin:15px 0 6px}.app-config-panel select{padding:10px;min-width:230px;max-width:100%;border:1px solid var(--np-border);background:white}.app-note{margin-top:10px;font:12px/1.5 Arial,sans-serif;color:var(--np-muted)}.anchor-config{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px;margin-top:18px}.anchor-config>div{background:var(--np-bg);padding:14px 10px;text-align:center;font:12px Arial,sans-serif}.anchor-config span{display:block;font-weight:700;margin-top:6px}
.model-footer{position:sticky;bottom:0;z-index:40;background:#fff;border:1px solid var(--np-border);box-shadow:0 -3px 14px rgba(20,36,58,.06);margin-top:25px}.model-footer>button{display:flex;justify-content:space-between;align-items:center;width:100%;background:var(--np-bg);border:0;border-bottom:1px solid var(--np-border);padding:9px 15px;cursor:pointer}.footer-title{font:700 11px Arial,sans-serif;letter-spacing:.1em}.model-footer-body{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;padding:14px 16px}.model-footer-body>div{display:flex;flex-direction:column;gap:6px}.model-footer-body small{font:11px Arial,sans-serif;color:var(--np-muted)}.model-footer-body strong{font:700 15px Arial,sans-serif}.app-legal{display:flex;justify-content:space-between;gap:20px;padding:24px 4px;color:var(--np-muted);font:11px/1.6 Arial,sans-serif}
@media(max-width:720px){.app-header{align-items:flex-start}.app-name{font-size:23px}.app-nav button{padding:12px 9px;font-size:13px}.mode-header{flex-direction:column;align-items:stretch}.mode-switch button{flex:1}#scenarioInputsPanel .scenarioGrid{grid-template-columns:repeat(2,minmax(0,1fr))}.anchor-config{grid-template-columns:repeat(2,minmax(0,1fr))}.model-footer-body{grid-template-columns:repeat(2,minmax(0,1fr))}.app-legal{flex-direction:column}}

