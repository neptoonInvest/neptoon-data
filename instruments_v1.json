      ){

         const proceeds = state.value;
         const deferredCapitalGainsTaxReal =
           state.deferredTaxNominal / inflationIndexAtMonth(month);

         /* Transfer gross asset, settle tax as a separate cash debit. */
         portfolio += proceeds;
         portfolio -= deferredCapitalGainsTaxReal;

         state.value = 0;
         state.deferredTaxNominal = 0;
         state.liquidated = true;

         if(asset.key === "realEstate"){
           const debtAtSale = mortgageState.enabled
             ? mortgageRealDebt(mortgageState.nominalDebt,month,inputs)
             : 0;

           /* Debt is also settled from the sale proceeds. */
           portfolio -= debtAtSale;
           realEstateLiquidation =
