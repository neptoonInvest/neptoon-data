/* =========================================
   MYWEALTH · WEALTH PLAN EMAIL
========================================= */

#mw-wealth-plan{
  width:100%;
  max-width:none;
  box-sizing:border-box;
  margin:14px 0;
  padding:0;
}

#mw-wealth-plan[hidden],
#mw-plan-status[hidden]{
  display:none !important;
}

.mw-plan-content{
  background:#fff;
  border:1px solid #d5e0ee;
  border-radius:0;
  padding:16px;
}

.mw-plan-heading{
  display:flex;
  align-items:center;
  gap:12px;
  margin-bottom:14px;
}

.mw-plan-icon{
  width:38px;
  height:38px;
  flex:0 0 38px;
  display:flex;
  align-items:center;
  justify-content:center;
  background:#eaf1fb;
  color:#4e79bd;
}

.mw-plan-icon svg{
  width:19px;
  height:19px;
}

.mw-plan-heading-text{
  min-width:0;
}

.mw-plan-heading-text h3{
  margin:0 0 4px;
  font-size:15px;
  font-weight:750;
  color:#102747;
}

.mw-plan-heading-text p{
  margin:0;
  font-size:12px;
  line-height:1.5;
  color:#64748b;
}

.mw-plan-form{
  display:flex;
  gap:8px;
}

#mw-plan-email{
  flex:1;
  min-width:0;
  height:40px;
  padding:0 12px;
  border:1px solid #cbd8e8;
  border-radius:0;
  background:#fff;
  color:#102747;
  font:inherit;
  font-size:13px;
}

#mw-plan-email:focus{
  outline:2px solid #4e79bd;
  outline-offset:1px;
}

.mw-plan-send{
  display:flex;
  align-items:center;
  justify-content:center;
  gap:7px;
  height:40px;
  padding:0 17px;
  border:1px solid #4e79bd;
  border-radius:0;
  background:#4e79bd;
  color:#fff;
  font:inherit;
  font-size:12px;
  font-weight:700;
  white-space:nowrap;
  cursor:pointer;
}

.mw-plan-send svg,
.mw-plan-download svg{
  width:15px;
  height:15px;
}

.mw-plan-footer{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
  margin-top:11px;
}

.mw-plan-footer > span{
  font-size:11px;
  line-height:1.4;
  color:#64748b;
}

.mw-plan-download{
  display:flex;
  align-items:center;
  gap:6px;
  border:0;
  border-radius:0;
  background:transparent;
  color:#4e79bd;
  font:inherit;
  font-size:11px;
  font-weight:700;
  white-space:nowrap;
  cursor:pointer;
}

.mw-plan-status{
  margin-top:12px;
  font-size:12px;
  color:#102747;
}

@media(max-width:480px){

  .mw-plan-content{
    padding:13px;
  }

  .mw-plan-heading{
    align-items:flex-start;
  }

  .mw-plan-form{
    flex-direction:column;
  }

  #mw-plan-email,
  .mw-plan-send{
    width:100%;
  }

  .mw-plan-footer{
    align-items:flex-start;
  }

}
.nav-inner{
  height:100%;
  width:100%;
  max-width:none;
  margin:0;
  display:grid;
  grid-template-columns:repeat(5,minmax(0,1fr));
}
.bottom-nav{
  position:fixed;
  top:0;
  left:0;
  right:0;
  height:var(--navh);
  background:rgba(7,22,49,.94);
  border-bottom:1px solid rgba(110,198,237,.25);
  z-index:100;
  box-shadow:0 12px 45px rgba(0,8,30,.4);
  backdrop-filter:blur(22px);
}
  body{
  padding-top:var(--navh);
  padding-bottom:36px;
}

.mywealth-history-method-btn.active{
  background:#4E79BD;
  color:#FFFFFF;
  border-color:#4E79BD;
}
</style>
