function getUserSettings(){

  const inputs = {};
  const radios = {};
  const components = {};

  // INPUT CELLS + SELECTS + CHECKBOXES

  LIFE_CYCLE_SETTING_IDS.forEach(id => {

    const el = byId(id);

    if(!el){
      console.warn("SETTINGS INPUT MISSING:",id);
      return;
    }

    inputs[id] =
      el.type === "checkbox"
        ? el.checked
        : el.value;

  });


  // RADIO GROUPS

  LIFE_CYCLE_SETTING_RADIOS.forEach(name => {

    radios[name] =
      document.querySelector(
        `input[name="${name}"]:checked`
      )?.value ?? null;

  });


  // OPTIONAL COMPONENTS

  LIFE_CYCLE_SETTING_COMPONENTS.forEach(name => {

    components[name] =
      componentEnabled(name);

  });


  // RETURN CLOUD-READY OBJECT

  return {
    schemaVersion:1,
    savedAt:new Date().toISOString(),
    inputs,
    radios,
    components
  };

}



function renderSelectedModelRiskDots(phase){

  const model =
    selectedModels[phase];

  const rawRisk =
    model?.objKeyFigures?.risk;

  const risk =
    rawRisk == null || rawRisk === ""
      ? NaN
      : Number(rawRisk);

  const riskID =
    Number.isFinite(risk) && risk >= 0
      ? Math.max(
          1,
          Math.min(7, riskDotFromRisk(risk))
        )
      : 0;

  const prefix =
    phase === "phase1"
      ? "build"
      : "use";

  const container =
    document.getElementById(
      `${prefix}RiskIndicator`
    );

  const label =
    document.getElementById(
      `${prefix}RiskLevel`
    );

  if(container){

    container.querySelectorAll("i").forEach(
      (dot,index) => {

        dot.classList.toggle(
          "on",
          index < riskID
        );

      }
    );

    container.setAttribute(
      "aria-label",
      riskID > 0
        ? `Risk level ${riskID} of 7`
        : "Risk level pending"
    );

  }

  if(label){

    label.textContent =
      riskID > 0
        ? `${riskID} / 7`
        : "— / 7";

  }

}


