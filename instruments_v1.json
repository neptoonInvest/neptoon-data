    "heritageValueToday",
    "heritageAmount",

    ...["", "2", "3", "4"].flatMap(suffix => [
      `otherValueToday${suffix}`,
      `otherAmount${suffix}`
    ]),

    "publicPension",
    "supplementaryPensionAnnual"

  ];

  let corrected = 0;

  ids.forEach(id => {

    if(guardMoneyInput(id)){
      corrected++;
    }

  });

  if(corrected > 0){

    const message =
      INIT?.lang === "da"
        ? corrected === 1
          ? "Et ugyldigt beløb er sat til 0."
          : `${corrected} ugyldige beløb er sat til 0.`
        : corrected === 1
          ? "An invalid amount has been reset to 0."
          : `${corrected} invalid amounts have been reset to 0.`;

    showToast(message);

  }

  return corrected;

}


function guardLifeAges(){

  const currentEl =
    byId("currentAge");

  const deathEl =
    byId("deathAge");


  if(
    !currentEl ||
    !deathEl
  ){
    return;
  }


  let currentAge =
    Number(
      currentEl.value
    );

  let deathAge =
    Number(
      deathEl.value
    );


  /*
    FALLBACKS

    Do NOT use numberValue() here because
    blank input is converted to zero.
  */

  if(
    currentEl.value.trim() === "" ||
    !Number.isFinite(currentAge)
  ){
    currentAge = 50;
  }


  if(
    deathEl.value.trim() === "" ||
    !Number.isFinite(deathAge)
  ){
    deathAge = 90;
  }


  /*
    HARD DOMAIN LIMITS
  */

  currentAge =
    clamp(
      currentAge,
      INPUT_BOUNDS.currentAge.min,
      INPUT_BOUNDS.currentAge.max
    );


  deathAge =
    clamp(
      deathAge,
      INPUT_BOUNDS.deathAge.min,
      INPUT_BOUNDS.deathAge.max
    );


  /*
    EXPECTED LIFETIME MUST BE
    GREATER THAN CURRENT AGE
  */

  if(
    deathAge <= currentAge
  ){

    deathAge =
      Math.min(
        INPUT_BOUNDS.deathAge.max,
        currentAge + 1
      );

  }


  currentEl.value =
    String(currentAge);

  deathEl.value =
    String(deathAge);


  guardDependentAges(
    currentAge,
    deathAge
  );

}


function guardDependentAges(
  currentAge,
  deathAge
){

  /*
    ASSET LIQUIDATION AND
    FUTURE RESOURCE AGES
  */

  const ids = [

    "houseLiquidationAge",
    "enterpriseLiquidationAge",
    "privatePensionLiquidationAge",

    "heritageAge",
    "otherAge"

  ];


  for(const id of ids){

    const el =
      byId(id);

    if(
      !el ||
      el.value.trim() === ""
    ){
      continue;
    }

    let value =
      Number(el.value);

    if(
      !Number.isFinite(value)
    ){
      continue;
    }

    value =
      clamp(
        value,
        currentAge,
        deathAge
      );

    el.value =
      String(value);

  }




}


