function riskDotFromRisk(risk){
  const r = Number(risk);
  if(!Number.isFinite(r)) return 0;

  if(r <= 0.05) return 1;
  if(r <= 0.12) return 2;
  if(r <= 0.15) return 3;
  if(r <= 0.20) return 4;
  if(r <= 0.25) return 5;
  if(r <= 0.35) return 6;
  return 7;
}

function renderRiskDots(el, dot){
  if(!el) return;

  el.innerHTML = Array.from({length:7}, (_,i) => `
    <span class="dot ${i < dot ? "on" : ""}"></span>
  `).join("");
}


function renderSelectedModelAllocation(phase){

  const model =
    selectedModels[phase];

  const metrics =
    model?.objKeyFigures || {};

  const prefix =
    phase === "phase1"
      ? "build"
      : "use";

  const bar =
    byId(`${prefix}AllocationBar`);

  const equityField =
    byId(`${prefix}EquityPct`);

  const bondsField =
    byId(`${prefix}BondsPct`);

  const alternativesField =
    byId(`${prefix}AlternativesPct`);

  if(!bar) return;

  const equity =
    Math.max(0, Number(metrics.equityWeight) || 0);

  const bonds =
    Math.max(0, Number(metrics.bondsWeight) || 0);

  const alternatives =
    Math.max(0, Number(metrics.alternativesWeight) || 0);

  const total =
    equity + bonds + alternatives;

  if(total <= 0){

    bar.innerHTML =
      '<span class="accountAllocationEmpty">Awaiting portfolio</span>';

    if(equityField) equityField.textContent = "—";
    if(bondsField) bondsField.textContent = "—";
    if(alternativesField) alternativesField.textContent = "—";

    return;

  }

  const pct = value =>
    `${(value * 100).toFixed(0)}%`;

  if(equityField)
    equityField.textContent = pct(equity);

  if(bondsField)
    bondsField.textContent = pct(bonds);

  if(alternativesField)
    alternativesField.textContent = pct(alternatives);

  bar.innerHTML = "";

  [
    ["accountEquity", equity],
    ["accountBonds", bonds],
    ["accountAlternatives", alternatives]
  ].forEach(([className, weight]) => {

    if(weight <= 0) return;

    const segment =
      document.createElement("span");

    segment.className = className;

    segment.style.width =
      `${weight / total * 100}%`;

    bar.appendChild(segment);

  });

  bar.setAttribute(
    "aria-label",
    `Equity ${pct(equity)}, Bonds ${pct(bonds)}, Alternatives ${pct(alternatives)}`
  );

}




