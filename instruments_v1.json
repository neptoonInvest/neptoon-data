    =========================
  */

  document
    .getElementById("btnPortfolioBuild")
    ?.classList.toggle(
      "active",
      phase === "phase1"
    );

  document
    .getElementById("btnPortfolioUse")
    ?.classList.toggle(
      "active",
      phase === "phase2"
    );


  /*
    =========================
    MODEL DATA
    =========================
  */

  const identity =
    model.identity || {};

  const metrics =
    model.objKeyFigures || {};

  const holdings =
    Array.isArray(model.arrayHoldings)
      ? model.arrayHoldings
      : [];

  const history =
    Array.isArray(model.arrayHistory)
      ? model.arrayHistory
      : [];


  /*
    =========================
    MODEL HEADER
    =========================
  */

  const modelName =
    identity.modelLabel ||
