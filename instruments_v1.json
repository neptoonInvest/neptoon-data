function prepareAssetHistorySeries(){

  const selected = APP.assets.filter(Boolean);

  const periods = {
    "1Y": 12,
    "3Y": 36,
    "5Y": 60,
    "10Y": 120
  };

  const raw = selected.map((ticker, i) => {

    const instrument =
      INSTRUMENT_STATE.all.find(
        x => x.tickerExchange === ticker
      );

    const history = getInstrumentHistory(ticker)
      .filter(h =>
        h &&
        h.date &&
        Number.isFinite(Number(h.accIndexTotal)) &&
