function detectLang(){

  const saved =
    localStorage.getItem("neptoon_lang");

  if(["da","en"].includes(saved)){
    return saved;
  }

  const browser =
    (
      navigator.languages?.[0] ||
      navigator.language ||
      "en"
    ).toLowerCase();

  return browser.startsWith("da")
    ? "da"
    : "en";

}


