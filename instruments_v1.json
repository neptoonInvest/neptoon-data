function renderRiskModel(){

  /*
    =========================
    SELECT VIEWING PHASE

    UI state only.
    Does not change engine portfolios.
    =========================
  */

  const phase =
    portfolioViewPhase === "use"
      ? "phase2"
      : "phase1";

