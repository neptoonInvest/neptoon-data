}

.lifeFAQGroup .lifeFAQItem{
  margin-top:8px;
}




/* =========================================
   NEPTOON LIFE CYCLE — TOAST
========================================= */

#lifeCycleToast{

  position:fixed;
  bottom:28px;
  left:50%;
  transform:translateX(-50%);

  background:#ffffff;
  color:#243b5a;

  border:1px solid #dce4ee;
  border-left:4px solid #4E79BD;

  padding:13px 22px;

  font-family:Arial,sans-serif;
  font-size:13px;
  font-weight:500;
  line-height:1.5;

  box-shadow:
    0 8px 28px rgba(15,27,44,.14);

  z-index:99999;

  max-width:calc(100% - 32px);
  box-sizing:border-box;

  text-align:center;
  pointer-events:none;

  display:none;

  animation:lifeCycleToastIn .25s ease-out;

}

@keyframes lifeCycleToastIn{

  from{
    opacity:0;
    transform:translate(-50%,12px);
  }

  to{
    opacity:1;
    transform:translate(-50%,0);
  }

}

@media(max-width:600px){

  #lifeCycleToast{
    bottom:18px;
    width:calc(100% - 32px);
    padding:12px 16px;
    font-size:12px;
  }

}



