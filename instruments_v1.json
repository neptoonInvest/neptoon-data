/* =====================================================
   05 FINANCIAL FREEDOM DAY
   NEPTOON BALANCE SHEET & INFORMATION
===================================================== */

#lifeBalancePanel {
  --lifeBlue:#4E79BD;
  --lifeNavy:#172b4d;
  --lifeText:#243247;
  --lifeMuted:#64748b;
  --lifeBorder:#dce3ed;
  --lifeSoftBlue:#f3f7fc;
}


/* =====================================================
   EXPANDABLE BODY
===================================================== */

#lifeBalancePanel .lifeBalanceBody {
  padding-top:18px;
}

#lifeBalancePanel .lifeBalanceBody[hidden] {
  display:none !important;
}


/* =====================================================
   META INFORMATION
===================================================== */

#lifeBalancePanel .lifeBalanceMeta {
  display:flex;
  flex-wrap:wrap;
  align-items:center;
  gap:10px 18px;
  margin-bottom:22px;
  font-size:11px;
  color:var(--lifeMuted);
}

#lifeBalancePanel #lifeBalanceDate {
  font-weight:700;
  color:var(--lifeBlue);
}

#lifeBalancePanel #lifeBalanceCurrency {
  font-weight:700;
  color:var(--lifeNavy);
}


/* =====================================================
   FREEDOM DAY INTRODUCTION
===================================================== */

#lifeBalancePanel .freedomDayIntro {
  margin-bottom:28px;
}

#lifeBalancePanel .freedomDayKicker {
  margin-bottom:8px;
  font-size:10px;
  font-weight:700;
  letter-spacing:1.1px;
  text-transform:uppercase;
  color:var(--lifeBlue);
}

#lifeBalancePanel .freedomDayHeadline {
  margin-bottom:10px;
  font-size:21px;
  line-height:1.3;
  font-weight:700;
  color:var(--lifeNavy);
}

#lifeBalancePanel .freedomDayIntroduction {
  max-width:850px;
  font-size:13px;
  line-height:1.75;
  color:var(--lifeText);
}


/* =====================================================
   SECTION HEADINGS
===================================================== */

#lifeBalancePanel .freedomDaySectionHead {
  margin:22px 0 15px;
}

#lifeBalancePanel .freedomDaySectionTitle {
  margin-bottom:5px;
  font-size:15px;
  line-height:1.4;
  font-weight:700;
  color:var(--lifeBlue);
}

#lifeBalancePanel .freedomDaySectionHint {
  font-size:12px;
  line-height:1.6;
  color:var(--lifeMuted);
}


/* =====================================================
   COMMON BALANCE SHEET GRID
===================================================== */

