<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#081735">
<title>Neptoon Wealth | MyWealth</title>
<link rel="preconnect" href="https://unpkg.com">
<style>
/* =========================================================
   NW-111 · CONSUMER BLUE · DESIGN SYSTEM · 11 NOV 2026
   Presentation layer only. Existing IDs and JS are preserved.
========================================================= */
:root {
  --blue:#4E79BD; --navy:#081735; --ink:#eef8ff; --muted:#a5bbd4;
  --line:rgba(165,214,255,.17); --pale:rgba(24,57,105,.62);
  --white:#fff; --red:#ff7896; --green:#5ce2bc; --cyan:#55e8ef;
  --navh:78px; --radius:22px; --radius-sm:14px;
  --shadow:0 18px 48px rgba(0,5,28,.24);
}
*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth;min-height:100%;background:#07152e}
body{margin:0;min-height:100vh;color:var(--ink);font:15px/1.5 system-ui,-apple-system,"Segoe UI",sans-serif;
  background:radial-gradient(ellipse 70% 38% at 96% 3%,rgba(76,171,255,.24),transparent 75%),
  radial-gradient(ellipse 58% 42% at 0% 31%,rgba(27,110,190,.18),transparent 72%),
  linear-gradient(165deg,#07132d 0%,#0c2350 49%,#08162f 100%);
  padding-bottom:calc(var(--navh) + 36px)}
button,input,select{font:inherit}button{cursor:pointer}button:disabled{cursor:not-allowed;opacity:.42}
button:focus-visible,input:focus-visible,select:focus-visible{outline:2px solid var(--cyan);outline-offset:3px}
.shell{width:min(1150px,calc(100% - 40px));margin-inline:auto}
.masthead{height:76px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line)}
.brand{font-size:18px;font-weight:850;letter-spacing:.085em;color:white}.brand span{color:#6de6ef}
.lang{display:flex;gap:5px;padding:4px;border-radius:100px;border:1px solid var(--line);background:rgba(12,35,75,.6)}
.lang button{border:0;border-radius:100px;background:transparent;color:var(--muted);padding:6px 13px;font-size:12px;font-weight:750}
.lang button.active{background:linear-gradient(115deg,#3a82dc,#45d6e8);color:#061c39}
.page{display:none;animation:pageIn .3s ease both}.page.active{display:block}
@keyframes pageIn{from{opacity:.45;transform:translateY(7px)}to{opacity:1;transform:none}}
.hero{position:relative;isolation:isolate;overflow:hidden;display:grid;grid-template-columns:minmax(0,1fr) 170px;
  align-items:center;gap:20px;min-height:242px;padding:36px 42px;margin:26px 0 28px;
  background:radial-gradient(ellipse 70% 90% at 93% 54%,rgba(206,246,255,.34),transparent 64%),
  radial-gradient(ellipse 64% 105% at 76% 90%,rgba(27,208,231,.28),transparent 73%),
  linear-gradient(118deg,#0d2450,#184f95 65%,#177ba6);
  border:1px solid rgba(175,230,255,.3);border-radius:28px;box-shadow:0 20px 60px rgba(0,12,44,.35),inset 0 1px rgba(255,255,255,.14)}
.hero::after{content:"";position:absolute;pointer-events:none;z-index:-1;right:-80px;top:-100px;width:390px;height:380px;border-radius:50%;filter:blur(36px);background:radial-gradient(circle,rgba(233,251,255,.27),rgba(39,205,232,.1) 45%,transparent 72%)}
.kicker{color:#73e7f0;font-size:11px;letter-spacing:.16em;font-weight:800;text-transform:uppercase}
.hero h1{font-size:clamp(31px,4.1vw,52px);line-height:1.08;letter-spacing:-.045em;margin:13px 0 14px;color:white;max-width:720px}
.hero p{color:#d4e7f8;max-width:630px;margin:0;font-size:15px;line-height:1.65}
.hero-icon{justify-self:center;color:#d5ffff;opacity:.9;filter:drop-shadow(0 0 25px rgba(87,243,248,.65))}.hero-icon i{width:104px;height:104px;stroke-width:1.1}
.section{margin:26px 0 32px}.section-heading{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:15px}
.section-heading h2{font-size:21px;letter-spacing:-.02em;color:white;margin:0}
.hint,.small{font-size:12px;color:var(--muted)}
.panel,.welcome-choice,.preview article,.canvas-box,.market-pulse,.details{border:1px solid var(--line);background:linear-gradient(140deg,rgba(30,66,119,.72),rgba(10,31,70,.82));border-radius:var(--radius);box-shadow:var(--shadow)}
.panel-pad{padding:25px}.muted-panel{background:var(--pale)}
.btn{background:linear-gradient(110deg,#3d91e6,#42d5e6);color:#061b39;border:1px solid rgba(146,241,255,.35);border-radius:100px;padding:12px 22px;font-weight:800;box-shadow:0 7px 25px rgba(34,173,220,.19);transition:transform .16s,filter .16s}
.btn:hover:not(:disabled){transform:translateY(-2px);filter:brightness(1.12)}
.btn.secondary{background:rgba(57,129,198,.17);color:#8deff6;border-color:rgba(105,218,239,.4);box-shadow:none}
.btn.ghost{background:rgba(12,37,79,.8);color:white;border-color:var(--line);box-shadow:none}
.btn.full{width:100%}.btnrow{display:flex;gap:12px;flex-wrap:wrap}
.field label{display:block;font-size:12px;color:#c5d9ee;font-weight:650;margin-bottom:8px}
.field input,.field select,.searchbox{width:100%;height:48px;padding:0 14px;border:1px solid rgba(157,210,250,.27);border-radius:13px;background:#102e59;color:#f0faff;min-width:0}
.field input::placeholder,.row-search input::placeholder{color:#819dbf}
.field-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
.notice{padding:15px 18px;border-left:3px solid #5ce3ec;background:rgba(29,104,153,.18);border-radius:0 13px 13px 0;font-size:13px;color:#b8d3e8}
.basket{border:1px solid var(--line);border-radius:var(--radius);overflow:visible;background:linear-gradient(140deg,rgba(26,57,107,.8),rgba(11,29,66,.85));box-shadow:var(--shadow)}
.basket-head{display:flex;justify-content:space-between;align-items:center;background:rgba(57,123,185,.16);padding:15px 18px;border-bottom:1px solid var(--line);border-radius:var(--radius) var(--radius) 0 0}.basket-head strong{color:white}
.basket-row{display:grid;grid-template-columns:36px minmax(150px,1.25fr) minmax(105px,.6fr) minmax(170px,1.35fr) 32px;align-items:center;gap:12px;padding:15px 18px;border-bottom:1px solid var(--line);min-height:81px;transition:background .18s}
.basket-row:hover{background:rgba(74,144,207,.1)}.basket-row:last-child{border-bottom:0}.basket-row.selected{background:rgba(48,171,208,.17);border-left:3px solid var(--cyan);padding-left:15px}
.row-icon{color:#6ce8f0;display:flex;align-items:center;justify-content:center}.row-icon i{width:22px;height:22px}
.row-name{font-weight:750;color:#f4fbff;overflow-wrap:anywhere}.row-meta{font-size:12px;color:var(--muted)}.row-middle{font-size:12px;color:var(--muted)}
.row-middle select,.row-search input{height:44px;width:100%;border:1px solid rgba(157,210,250,.27);border-radius:12px;background:#102d57;color:#effaff;padding:0 12px}
.row-search{position:relative;min-width:0}.suggestions{position:absolute;top:calc(100% + 5px);left:0;right:0;z-index:30;background:#10264a;border:1px solid rgba(120,209,241,.35);border-radius:14px;box-shadow:0 14px 35px #0008;max-height:280px;overflow:auto}
.suggestion{display:flex;justify-content:space-between;gap:10px;align-items:center;width:100%;padding:12px;background:transparent;color:white;border:0;border-bottom:1px solid var(--line);text-align:left;font-size:13px}.suggestion:hover{background:rgba(72,159,221,.2)}.suggestion.locked{color:#92a9c6}
.icon-btn{border:0;background:transparent;color:#9fc4dc;padding:7px;display:grid;place-items:center;border-radius:10px}.icon-btn:hover{background:rgba(255,255,255,.08)}.icon-btn i{width:18px;height:18px}
.basket-foot{display:flex;justify-content:space-between;align-items:center;gap:14px;background:rgba(39,97,153,.13);padding:17px 18px;border-radius:0 0 var(--radius) var(--radius)}.basket-foot p{font-size:12px;color:var(--muted);margin:0}
.row-open{border:0;background:transparent;color:#6fe5ed;padding:0;display:inline-flex;align-items:center;gap:4px;font-size:12px}.row-open i{width:14px;height:14px}
.details{border-top:1px solid var(--line);margin-top:14px;padding:24px}.detail-top{display:flex;justify-content:space-between;gap:16px;align-items:center}.detail-meta{display:flex;gap:25px;flex-wrap:wrap;margin:15px 0;font-size:13px;color:var(--muted)}.detail-meta b{color:white}
.allocation{height:11px;display:flex;gap:2px;margin:13px 0;border-radius:100px;overflow:hidden}.allocation span{display:block}.legend{display:flex;gap:16px;flex-wrap:wrap;font-size:12px;color:var(--muted)}.legend em{display:inline-block;width:9px;height:9px;margin-right:5px;border-radius:50%}
.risk{display:inline-flex;gap:4px;align-items:center}.dot{width:9px;height:9px;border-radius:50%;background:#3b5475}.dot.on{background:#ff7595;box-shadow:0 0 7px rgba(255,117,149,.28)}
.holdings{width:100%;border-collapse:collapse;margin-top:14px}.holdings td{padding:11px 2px;border-bottom:1px solid var(--line);font-size:13px}.holdings td:last-child{text-align:right;font-weight:750}
.welcome-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}.welcome-choice{padding:26px;transition:transform .2s,border-color .2s}.welcome-choice:hover{transform:translateY(-3px);border-color:rgba(100,231,240,.5)}.welcome-choice i{color:#62e3ef;width:32px;height:32px}.welcome-choice h2{margin:13px 0 8px;font-size:23px;color:white}.welcome-choice p{color:#bbcee4;font-size:14px;min-height:46px}
.preview{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:18px}.preview article{padding:20px}.preview strong{display:block;margin-bottom:5px}.preview .placeholder{color:#68e7ee;font-size:27px;font-weight:800}
.metrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.metric{background:linear-gradient(150deg,rgba(40,88,147,.65),rgba(13,36,77,.75));border:1px solid var(--line);border-radius:17px;padding:18px}.metric .value{font-size:clamp(20px,2.4vw,30px);font-weight:800;color:#f5fdff;font-variant-numeric:tabular-nums;margin-top:7px}
.results-grid{display:grid;grid-template-columns:275px minmax(0,1fr);gap:17px}.results-grid .metrics{grid-template-columns:1fr 1fr}.canvas-box{padding:23px;min-width:0}.canvas-box canvas{display:block;width:100%;height:300px}.active-investment{display:flex;gap:12px;align-items:center;justify-content:space-between}.history-chart{height:320px!important}.footnote{font-size:12px;color:#9bb5d2;margin-top:13px}
.bottom-nav{position:fixed;bottom:0;left:0;right:0;height:var(--navh);background:rgba(7,22,49,.94);border-top:1px solid rgba(110,198,237,.25);z-index:100;box-shadow:0 -12px 45px rgba(0,8,30,.4);backdrop-filter:blur(22px)}
.nav-inner{height:100%;max-width:900px;margin:auto;display:grid;grid-template-columns:repeat(5,1fr)}.nav-tab{background:transparent;border:0;border-top:2px solid transparent;color:#8ca9c8;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;padding:5px 2px;font-size:12px;transition:color .15s,background .15s}.nav-tab i{width:22px;height:22px}.nav-tab.active{color:#6fe6f1;border-top-color:#65e9ee;background:linear-gradient(180deg,rgba(37,157,206,.18),transparent);font-weight:800}
/* MARKET PULSE */
.market-pulse{padding:25px;margin:0 0 27px;background:radial-gradient(ellipse at 100% 0%,rgba(67,153,207,.16),transparent 60%),linear-gradient(140deg,rgba(26,62,117,.8),rgba(10,29,65,.86))}
.market-head{display:flex;justify-content:space-between;align-items:center;gap:14px;margin-bottom:18px}.market-head h2{margin:4px 0 0;color:white;font-size:23px;letter-spacing:-.02em}.market-head .market-stamp{font-size:12px;color:var(--muted);text-align:right}
.market-index-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:13px}
.market-index-card,.market-stock-card{min-width:0;background:linear-gradient(145deg,rgba(49,107,170,.34),rgba(13,39,81,.83));border:1px solid rgba(128,198,237,.2);border-radius:17px;padding:18px;transition:transform .18s,border-color .18s}
.market-index-card:hover,.market-stock-card:hover{transform:translateY(-2px);border-color:rgba(95,226,242,.5)}
.market-index-top{display:flex;justify-content:space-between;gap:8px;align-items:start}.market-index-top i{width:22px;height:22px;color:#6ce6ef;stroke-width:1.7}
.market-name{font-size:15px;font-weight:800;color:#f4fcff}.market-symbol{font-size:11px;color:#91aecf;margin-top:3px}.market-quote{display:flex;align-items:baseline;justify-content:space-between;gap:10px;margin-top:18px}
.market-price{font-size:clamp(21px,2.5vw,31px);font-weight:850;color:white;font-variant-numeric:tabular-nums;letter-spacing:-.025em}.market-change{font-size:14px;font-weight:800;font-variant-numeric:tabular-nums;white-space:nowrap}.market-change.up{color:var(--green)}.market-change.down{color:var(--red)}.market-change.unknown{color:var(--muted)}
.market-divider{height:1px;background:var(--line);margin:25px 0 19px}.market-stock-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:13px}.market-stock-head h3{margin:0;font-size:18px;color:white}
.market-stock-track{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px}.market-stock-card{padding:15px;display:flex;flex-direction:column;gap:5px}.market-stock-card .market-name{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:13px}.market-stock-card .market-price{font-size:20px;margin-top:10px}.market-stock-card .market-change{font-size:12px}
.market-pagination{display:flex;align-items:center;justify-content:center;gap:13px;margin-top:18px}.market-page-btn{display:inline-flex;align-items:center;justify-content:center;background:rgba(50,123,186,.25);color:#78e9f2;border:1px solid rgba(118,211,239,.32);border-radius:50%;width:36px;height:36px;cursor:pointer}.market-page-btn:disabled{opacity:.35;cursor:default}.market-page-btn i{width:16px;height:16px}.market-page-indicator{font-size:12px;color:#c4d7ed;min-width:55px;text-align:center}.market-foot{margin-top:15px;font-size:11px;color:var(--muted)}
/* HISTORY INTERACTION: only affects display state, not unconnected financial series */
.history-controls{display:flex;justify-content:space-between;align-items:center;gap:14px;flex-wrap:wrap;margin:0 0 20px}.history-periods{display:flex;gap:7px;flex-wrap:wrap}.history-period{border:1px solid rgba(135,208,240,.25);border-radius:100px;background:rgba(34,81,137,.34);color:#bdd6ee;font-weight:750;font-size:12px;padding:9px 15px}.history-period.active{background:linear-gradient(110deg,#3d92e4,#45d9e7);color:#061c3b;border-color:transparent;box-shadow:0 5px 22px rgba(41,197,224,.2)}.history-period:hover:not(.active){border-color:#70dce9;color:white}.history-period:disabled{opacity:.4}.history-status{color:#9bb9d7;font-size:12px}
/* Responsiveness */
@media(max-width:850px){.results-grid{grid-template-columns:1fr}.results-grid .metrics{grid-template-columns:repeat(4,minmax(0,1fr))}}
@media(max-width:760px){
.shell{width:calc(100% - 24px)}.masthead{height:62px}.brand{font-size:15px}.hero{grid-template-columns:minmax(0,1fr) 54px;padding:27px 20px;min-height:195px;margin:14px 0 23px;gap:8px;border-radius:23px}.hero h1{font-size:clamp(27px,7vw,38px)}.hero p{font-size:13px}.hero-icon i{width:48px;height:48px}
.basket-row{grid-template-columns:27px minmax(0,1fr) 31px;gap:8px;padding:14px;min-height:0}.basket-row.selected{padding-left:11px}.row-middle{grid-column:2;grid-row:2}.row-search{grid-column:2;grid-row:3}.basket-row>.icon-btn{grid-column:3;grid-row:1}.basket-foot{align-items:stretch;flex-direction:column}.basket-foot .btn{width:100%}
.results-grid .metrics{grid-template-columns:repeat(2,minmax(0,1fr))}.metric .value{font-size:22px}.canvas-box{padding:16px}.canvas-box canvas{height:255px}.welcome-grid{grid-template-columns:1fr}.preview{grid-template-columns:1fr 1fr}.panel-pad{padding:19px}.nav-tab{font-size:10px}.nav-tab i{width:20px;height:20px}.detail-meta{gap:12px}.field-grid{gap:10px}.section-heading h2{font-size:19px}
.market-pulse{padding:16px}.market-index-grid{gap:9px}.market-index-card{padding:13px}.market-name{font-size:12px}.market-price{font-size:19px}.market-change{font-size:11px}.market-quote{flex-wrap:wrap;gap:5px}.market-stock-track{grid-template-columns:repeat(2,minmax(0,1fr))}.market-head h2{font-size:20px}.market-stamp{max-width:120px}.market-stock-card .market-price{font-size:20px}
}
@media(max-width:390px){.preview{grid-template-columns:1fr}.field-grid{grid-template-columns:1fr}.nav-tab{font-size:9px}.hero-icon{display:none}.hero{grid-template-columns:1fr}.market-index-card{padding:11px}.market-price{font-size:17px}}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;transition-duration:.01ms!important;scroll-behavior:auto!important}}

/* =====================================================
   WELCOME · GBM INVESTMENT PREVIEW
===================================================== */

.preview{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:16px;
  margin-bottom:22px;
}

.welcome-investment-card{
  min-width:0;
  padding:22px;

  background:linear-gradient(
    145deg,
    #172f58 0%,
    #0c1c3f 100%
  );

  border:1px solid rgba(123,172,226,.20);
  border-radius:18px;

  color:#fff;
}

.welcome-investment-name{
  font-size:17px;
  font-weight:750;
  color:#fff;
}

.welcome-investment-sub{
  margin-top:8px;
  font-size:12px;
  color:#9fb8da;
}

.welcome-investment-kicker{
  margin-top:22px;
  font-size:10px;
  font-weight:800;
  letter-spacing:.08em;
  color:#57dce8;
}

.welcome-investment-value{
  margin-top:5px;
  font-size:clamp(27px,3vw,36px);
  font-weight:800;
  letter-spacing:-.035em;
  font-variant-numeric:tabular-nums;
  color:#fff;
}

.welcome-range-head{
  display:flex;
  justify-content:space-between;
  gap:12px;

  margin-top:22px;
  margin-bottom:12px;

  font-size:12px;
  color:#9fb8da;
}

.welcome-range-track{
  width:100%;
  height:7px;

  background:#304a71;
  border-radius:20px;

  overflow:hidden;
}

.welcome-range-fill{
  height:100%;

  background:linear-gradient(
    90deg,
    #24bfd1,
    #43e1eb
  );

  border-radius:20px;
  transition:width .4s ease;
}

.welcome-statistics{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:8px;
  margin-top:12px;
}

.welcome-statistics > div{
  display:flex;
  flex-direction:column;
  gap:5px;
  min-width:0;
}

.welcome-statistics > div:nth-child(2){
  text-align:center;
}

.welcome-statistics > div:nth-child(3){
  text-align:right;
}

.welcome-statistics span{
  font-size:11px;
  color:#9fb8da;
}

.welcome-statistics strong{
  font-size:clamp(13px,1.6vw,17px);
  font-weight:750;
  font-variant-numeric:tabular-nums;
  color:#fff;
}

@media(max-width:760px){

  .preview{
    grid-template-columns:1fr;
    gap:12px;
  }

  .welcome-investment-card{
    padding:18px;
  }

}

/* =====================================================
   NEPTOON · 5-ASSET HISTORY VIEWER
===================================================== */

.asset-history-section{
  margin-top:28px;
  min-width:0;
}

/* =====================================================
   HEADER
===================================================== */

.asset-history-header{
  display:flex;
  justify-content:space-between;
  align-items:flex-start;
  gap:20px;
  margin-bottom:24px;
}

.asset-history-kicker{
  font-size:11px;
  font-weight:800;
  letter-spacing:1.2px;
  color:#4E79BD;
  margin-bottom:8px;
}

.asset-history-header h2{
  margin:0;
  font-size:27px;
  font-weight:800;
  line-height:1.2;
  letter-spacing:-.6px;
  color:#101d3a;
}

.asset-history-subtitle{
  margin:8px 0 0;
  font-size:14px;
  line-height:1.55;
  color:#64748b;
}

/* =====================================================
   PERIOD TOOLBAR
===================================================== */

.asset-history-toolbar{
  display:flex;
  align-items:center;
  justify-content:space-between;
  flex-wrap:wrap;
  gap:16px;
  margin-bottom:22px;
}

.asset-history-periods{
  display:flex;
  align-items:stretch;
  overflow:hidden;
  border:1px solid #dce3ee;
  border-radius:7px;
  background:#f4f6fa;
}

.asset-history-periods button{
  appearance:none;
  border:0;
  border-right:1px solid #dce3ee;
  border-radius:0;
  background:transparent;
  color:#101d3a;
  font-family:inherit;
  font-size:13px;
  font-weight:750;
  min-width:66px;
  padding:11px 15px;
  cursor:pointer;
  transition:background .15s,color .15s;
}

.asset-history-periods button:last-child{
  border-right:0;
}

.asset-history-periods button:hover{
  background:#e7edf7;
}

.asset-history-periods button.active,
.asset-history-periods button.active:hover{
  background:#124b9b;
  color:#fff;
}

.asset-history-period-label{
  color:#64748b;
  font-size:12px;
  font-weight:500;
  text-align:right;
  font-variant-numeric:tabular-nums;
}

/* =====================================================
   DESKTOP LAYOUT
===================================================== */

.asset-history-layout{
  display:grid;
  grid-template-columns:minmax(0,1.8fr) minmax(0,1fr);
  gap:24px;
  align-items:start;
}

.asset-history-chart-panel{
  position:relative;
  min-width:0;
}

.asset-history-chart{
  position:relative;
  width:100%;
  height:390px;
  min-width:0;
}

#assetHistoryCanvas{
  display:block;
  width:100%;
  height:100%;
  touch-action:pan-y;
}

/* =====================================================
   TOOLTIP
===================================================== */

.asset-history-chart-tooltip{
  position:absolute;
  z-index:5;
  pointer-events:none;
  background:#101d3a;
  color:#fff;
  border-radius:6px;
  padding:10px 12px;
  font-size:12px;
  line-height:1.6;
  box-shadow:0 8px 24px rgba(15,23,42,.18);
  max-width:220px;
}

.asset-history-chart-tooltip[hidden]{
  display:none;
}

/* =====================================================
   PERFORMANCE TABLE
===================================================== */

.asset-history-results{
  min-width:0;
  overflow:hidden;
  border:1px solid #e1e7f0;
  border-radius:8px;
  background:#fff;
}

.asset-history-results-head{
  display:grid;
  grid-template-columns:minmax(0,1.5fr) minmax(0,.85fr) minmax(0,.85fr);
  align-items:center;
  gap:8px;
  padding:16px 14px;
  background:#f4f6fa;
  border-bottom:1px solid #dce3ee;
  color:#172b4d;
  font-size:12px;
  font-weight:700;
}

.asset-history-results-head span:nth-child(n+2){
  text-align:right;
}

.asset-history-results-body{
  min-height:90px;
}

/*
  Rows will be generated by JavaScript
  in Step 4.
*/

.asset-history-result-row{
  display:grid;
  grid-template-columns:minmax(0,1.5fr) minmax(0,.85fr) minmax(0,.85fr);
  align-items:center;
  gap:8px;
  padding:16px 14px;
  border-bottom:1px solid #e1e7f0;
  transition:background .15s,opacity .15s;
  font-variant-numeric:tabular-nums;
}

.asset-history-result-row:last-child{
  border-bottom:0;
}

.asset-history-result-row:hover{
  background:#f8faff;
}

.asset-history-result-row.is-muted{
  opacity:.28;
}

.asset-history-result-row.is-highlighted{
  background:#eef4ff;
}

.asset-history-result-instrument{
  display:flex;
  align-items:center;
  gap:10px;
  min-width:0;
}

.asset-history-color{
  width:12px;
  height:12px;
  border-radius:3px;
  flex:0 0 auto;
}

.asset-history-result-identity{
  min-width:0;
}

.asset-history-result-ticker{
  color:#101d3a;
  font-size:13px;
  font-weight:800;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
}

.asset-history-result-name{
  color:#64748b;
  font-size:11px;
  line-height:1.4;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
}

.asset-history-result-total{
  text-align:right;
  color:#101d3a;
  font-size:16px;
  font-weight:800;
  white-space:nowrap;
}

.asset-history-result-annual{
  text-align:right;
  color:#334155;
  font-size:12px;
  white-space:nowrap;
}

/* =====================================================
   METHODOLOGY NOTE
===================================================== */

.asset-history-note{
  display:flex;
  align-items:flex-start;
  gap:12px;
  margin-top:24px;
  padding-top:18px;
  border-top:1px solid #e1e7f0;
  color:#64748b;
  font-size:12px;
  line-height:1.6;
}

.asset-history-note-icon{
  flex:0 0 auto;
  color:#172b4d;
  font-size:19px;
  line-height:1;
}

/* =====================================================
   TABLET
===================================================== */

@media(max-width:1000px){

  .asset-history-layout{
    grid-template-columns:minmax(0,1fr);
    gap:20px;
  }

  .asset-history-chart{
    height:340px;
  }

}

/* =====================================================
   MOBILE
===================================================== */

@media(max-width:600px){

  .asset-history-section{
    margin-top:22px;
  }

  .asset-history-header{
    margin-bottom:18px;
  }

  .asset-history-header h2{
    font-size:22px;
    letter-spacing:-.4px;
  }

  .asset-history-kicker{
    font-size:10px;
    margin-bottom:6px;
  }

  .asset-history-subtitle{
    font-size:12px;
    line-height:1.5;
  }

  .asset-history-toolbar{
    display:flex;
    flex-direction:column;
    align-items:stretch;
    gap:12px;
    margin-bottom:16px;
  }

  .asset-history-periods{
    display:grid;
    grid-template-columns:repeat(5,minmax(0,1fr));
    width:100%;
  }

  .asset-history-periods button{
    min-width:0;
    padding:10px 0;
    font-size:12px;
  }

  .asset-history-period-label{
    text-align:center;
    font-size:11px;
  }

  .asset-history-layout{
    grid-template-columns:minmax(0,1fr);
    gap:18px;
  }

  .asset-history-chart{
    height:290px;
  }

  .asset-history-results-head,
  .asset-history-result-row{
    grid-template-columns:minmax(0,1.3fr) minmax(0,.85fr) minmax(0,.8fr);
    gap:5px;
    padding-left:10px;
    padding-right:10px;
  }

  .asset-history-results-head{
    font-size:10px;
    padding-top:13px;
    padding-bottom:13px;
  }

  .asset-history-result-row{
    padding-top:13px;
    padding-bottom:13px;
  }

  .asset-history-result-instrument{
    gap:7px;
  }

  .asset-history-color{
    width:9px;
    height:9px;
  }

  .asset-history-result-ticker{
    font-size:11px;
  }

  .asset-history-result-name{
    font-size:10px;
  }

  .asset-history-result-total{
    font-size:13px;
  }

  .asset-history-result-annual{
    font-size:11px;
  }

  .asset-history-note{
    margin-top:18px;
    font-size:11px;
    gap:9px;
  }

}
/* ==========================================
   HISTORY VIEWER · WHITE DASHBOARD PANEL
========================================== */

.asset-history-section{
  background:#ffffff;
  border:1px solid #dce3ee;
  border-radius:14px;
  padding:28px;
  box-shadow:0 8px 28px rgba(0,0,0,.08);
}

@media(max-width:600px){

  .asset-history-section{
    padding:16px 12px;
    border-radius:12px;
  }

}

/* =====================================================
   WEALTHPLANS · BASKET ROWS
===================================================== */

.wealthplan-row{
  display:grid;
  grid-template-columns:
    minmax(155px,1.15fr)
    minmax(110px,.65fr)
    minmax(170px,1.2fr)
    auto
    24px;

  align-items:center;
  gap:12px;
  padding:14px 16px;
  min-width:0;
}

.wealthplan-identity{
  display:flex;
  align-items:center;
  gap:12px;
  min-width:0;
}

.wealthplan-identity .row-icon{
  flex:0 0 auto;
  color:#38d6e8;
}

.wealthplan-name{
  min-width:0;
}

.wealthplan-name .row-name,
.wealthplan-name .row-meta{
  overflow:hidden;
  white-space:nowrap;
  text-overflow:ellipsis;
}

.wealthplan-field-label{
  display:block;
  margin-bottom:5px;
  color:#9bb5d5;
  font-size:10px;
  font-weight:600;
}

.wealthplan-risk,
.wealthplan-model{
  min-width:0;
}

.wealthplan-risk select,
.wealthplan-model select{
  display:block;
  width:100%;
  min-width:0;
  height:36px;
  padding:0 10px;
  background:#102b50;
  color:#f1f7ff;
  border:1px solid #31547e;
  border-radius:8px;
  font-size:11px;
  cursor:pointer;
}

.wealthplan-risk select:focus,
.wealthplan-model select:focus{
  outline:1px solid #38d6e8;
  border-color:#38d6e8;
}

/* =====================================================
   BORDERLESS VIEW ACTIONS
===================================================== */

.wealthplan-actions{
  display:flex;
  align-items:center;
  justify-content:flex-end;
  gap:14px;
  white-space:nowrap;
}

.wealthplan-action{
  display:inline-flex;
  align-items:center;
  gap:5px;

  padding:5px 0;
  border:0;
  background:transparent;

  color:#38d6e8;
  font-size:11px;
  font-weight:600;
  cursor:pointer;
}

.wealthplan-action svg{
  width:14px;
  height:14px;
}

.wealthplan-action:hover,
.wealthplan-action.active{
  color:#ffffff;
}

.wealthplan-remove{
  justify-self:end;
}

/* =====================================================
   HOLDINGS EXPANSION
===================================================== */

.wealthplan-holdings{
  padding:14px 16px 18px;
  background:#10284c;
  border-top:1px solid #29476c;
}

.wealthplan-holdings-title{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
  margin-bottom:12px;
  color:#f1f7ff;
  font-size:12px;
  font-weight:700;
}

.wealthplan-holdings-summary{
  color:#9bb5d5;
  font-size:10px;
  font-weight:400;
}

/* =====================================================
   HOLDINGS TABLE · SIX COLUMNS
===================================================== */

.wealthplan-holdings-header,
.wealthplan-holding-row{
  display:grid;

  grid-template-columns:
    minmax(180px,2.5fr)
    minmax(90px,1fr)
    minmax(65px,.65fr)
    minmax(125px,1fr)
    48px
    65px;

  align-items:center;
  column-gap:12px;
}

.wealthplan-holdings-header{
  padding:10px 12px;
  background:#1b3a65;
  color:#c3d5eb;
  font-size:10px;
  font-weight:600;
}

.wealthplan-holding-row{
  padding:11px 12px;
  border-bottom:1px solid #29476c;
  color:#e8f1ff;
  font-size:11px;
}

.wealthplan-holding-row:last-child{
  border-bottom:0;
}

.wealthplan-holding-name{
  min-width:0;
  font-weight:600;
  overflow-wrap:anywhere;
}

.wealthplan-holding-meta{
  margin-top:4px;
  color:#9bb5d5;
  font-size:10px;
  font-weight:400;
  line-height:1.5;
}

.wealthplan-holding-class,
.wealthplan-holding-type,
.wealthplan-holding-isin{
  color:#c3d5eb;
  overflow-wrap:anywhere;
}

.wealthplan-holding-ccy{
  color:#9bb5d5;
  font-size:10px;
  font-weight:600;
  white-space:nowrap;
}

.wealthplan-holding-weight{
  text-align:right;
  color:#ffffff;
  font-size:12px;
  font-weight:700;
  font-variant-numeric:tabular-nums;
  white-space:nowrap;
}

.wealthplan-holdings-header
.wealthplan-holding-weight{
  color:#c3d5eb;
  font-size:10px;
}

/* =====================================================
   TABLET
===================================================== */

@media(max-width:1100px){

  .wealthplan-row{
    grid-template-columns:
      minmax(150px,1fr)
      minmax(100px,.7fr)
      minmax(170px,1.2fr)
      24px;
  }

  .wealthplan-actions{
    grid-column:1 / 4;
    justify-content:flex-start;
    padding-left:36px;
  }

  .wealthplan-remove{
    grid-column:4;
    grid-row:1;
  }

}

/* =====================================================
   MOBILE
===================================================== */

@media(max-width:650px){

  .wealthplan-row{
    grid-template-columns:minmax(0,1fr) 24px;
    gap:10px;
    padding:14px 12px;
  }

  .wealthplan-identity{
    grid-column:1;
    grid-row:1;
  }

  .wealthplan-remove{
    grid-column:2;
    grid-row:1;
  }

  .wealthplan-risk{
    grid-column:1 / -1;
    grid-row:2;
  }

  .wealthplan-model{
    grid-column:1 / -1;
    grid-row:3;
  }

  .wealthplan-actions{
    grid-column:1 / -1;
    grid-row:4;
    padding-left:0;
    justify-content:space-between;
    gap:10px;
  }

  .wealthplan-action{
    font-size:11px;
  }

  .wealthplan-holdings{
    padding:12px;
  }

  .wealthplan-holdings-title{
    align-items:flex-start;
    flex-direction:column;
  }

  /* Compact mobile holding layout */

  .wealthplan-holdings-header{
    display:none;
  }

  .wealthplan-holding-row{
    grid-template-columns:minmax(0,1fr) 65px;
    gap:5px 10px;
    padding:12px 4px;
  }

  .wealthplan-holding-name{
    grid-column:1;
    grid-row:1;
  }

  .wealthplan-holding-weight{
    grid-column:2;
    grid-row:1;
    align-self:start;
  }

  .wealthplan-holding-class,
  .wealthplan-holding-type,
  .wealthplan-holding-isin,
  .wealthplan-holding-ccy{
    grid-column:1 / -1;
    font-size:10px;
  }

}

.wealthplan-row + .wealthplan-holdings{
  border-top:1px solid #29476c;
}


/* =====================================================
   WEALTHPLANS · RISK INDICATOR
===================================================== */

.wealthplan-risk-indicator{
  display:inline-flex;
  align-items:center;
  gap:8px;
}

.wealthplan-risk-dots{
  display:inline-flex;
  align-items:center;
  gap:4px;
}

.wealthplan-risk-dots .dot{
  width:8px;
  height:8px;
  border-radius:50%;
  background:#d1d5db;
  flex:0 0 auto;
}

.wealthplan-risk-dots .dot.on{
  background:#dc2626;
}

/* =====================================================
   WEALTHPLANS · DETAIL SECTIONS
===================================================== */

.wealthplan-overview-section:empty,
.wealthplan-expected-section:empty{
  display:none;
}

.wealthplan-overview-section:not(:empty){
  margin-top:24px;
}

.wealthplan-expected-section:not(:empty){
  margin-top:16px;
}

/* Keep both sections aligned with the basket */

.wealthplan-overview-section,
.wealthplan-expected-section{
  width:100%;
  min-width:0;
}

/* =====================================================
   WEALTHPLANS · PORTFOLIO OVERVIEW
===================================================== */

.wealthplan-overview{
  padding:20px;
}

.wealthplan-overview .detail-top h3{
  margin:6px 0 0;
  color:var(--ink);
}

.wealthplan-overview-metrics{
  display:grid;
  grid-template-columns:repeat(4,minmax(0,1fr));
  gap:20px;
  margin:22px 0;
}

.wealthplan-overview-metric{
  min-width:0;
}

.wealthplan-overview-label{
  color:#9bb5d5;
  font-size:11px;
  margin-bottom:7px;
}

.wealthplan-overview-value{
  color:#ffffff;
  font-size:21px;
  font-weight:700;
  font-variant-numeric:tabular-nums;
}

.wealthplan-allocation-heading{
  margin-bottom:10px;
  color:#c3d5eb;
  font-size:11px;
  font-weight:600;
}

.wealthplan-allocation{
  display:flex;
  overflow:hidden;
  height:8px;
  border-radius:8px;
  background:#29476c;
}

.wealthplan-allocation-legend{
  margin-top:10px;
}

.wealthplan-description{
  margin-top:20px;
  padding-top:16px;
  border-top:1px solid #29476c;
  color:#9bb5d5;
  font-size:12px;
  line-height:1.65;
}


/* =====================================================
   WEALTHPLANS · EXPECTED WEALTH
===================================================== */

.wealthplan-expected-wealth{
  padding:22px;
}

.wealthplan-expected-header h3{
  margin:6px 0;
  color:var(--ink);
  font-size:17px;
}

.wealthplan-expected-subtitle{
  color:#9bb5d5;
  font-size:12px;
}

.wealthplan-expected-main{
  margin:24px 0;
}

.wealthplan-expected-label{
  color:#38d6e8;
  font-size:11px;
  font-weight:700;
  text-transform:uppercase;
  letter-spacing:.05em;
}

.wealthplan-expected-number{
  margin-top:8px;
  color:#ffffff;
  font-size:34px;
  font-weight:800;
  font-variant-numeric:tabular-nums;
}

.wealthplan-range-heading{
  display:flex;
  justify-content:space-between;
  gap:12px;
  margin-bottom:12px;
  color:#9bb5d5;
  font-size:11px;
}

.wealthplan-range-track{
  height:7px;
  overflow:hidden;
  background:#29476c;
  border-radius:8px;
}

.wealthplan-range-fill{
  height:100%;
  background:#38d6e8;
  border-radius:8px;
}

.wealthplan-range-values{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:12px;
  margin-top:14px;
}

.wealthplan-range-values > div{
  display:flex;
  flex-direction:column;
  gap:5px;
}

.wealthplan-range-values > div:nth-child(2){
  text-align:center;
}

.wealthplan-range-values > div:last-child{
  text-align:right;
}

.wealthplan-range-values span{
  color:#9bb5d5;
  font-size:11px;
}

.wealthplan-range-values strong{
  color:#ffffff;
  font-size:15px;
  font-weight:700;
  font-variant-numeric:tabular-nums;
}


/* =====================================================
   RESPONSIVE
===================================================== */

@media(max-width:650px){

  .wealthplan-overview-metrics{
    grid-template-columns:repeat(2,minmax(0,1fr));
    gap:18px;
  }

  .wealthplan-overview-value{
    font-size:19px;
  }

  .wealthplan-expected-number{
    font-size:29px;
  }

  .wealthplan-range-values strong{
    font-size:13px;
  }

}

/* =====================================================
   WEALTHPLAN DESCRIPTION · COLLAPSIBLE
===================================================== */

.wealthplan-description-toggle{
  display:inline-flex;
  align-items:center;
  gap:7px;
  padding:8px 0;
  border:0;
  background:transparent;
  color:#8fbaff;
  font:inherit;
  font-weight:600;
  cursor:pointer;
}

.wealthplan-description-toggle:hover{
  color:#ffffff;
}

.wealthplan-description-toggle .toggle-chevron{
  display:inline-block;
  font-size:18px;
  line-height:1;
  transition:transform .2s ease;
}

.wealthplan-description-toggle[aria-expanded="true"]
.toggle-chevron{
  transform:rotate(180deg);
}

.wealthplan-description-content{
  margin-top:8px;
  line-height:1.65;
}

.wealthplan-description-content[hidden]{
  display:none;
}




/* =====================================================
   ASSETS + WEALTHPLANS · HISTORY CANVAS
===================================================== */

#assetHistoryCanvas,
#planHistoryCanvas{
  display:block;
  width:100%;
  height:100%;
  touch-action:pan-y;
}


/* ================================================
   MYWEALTH · MODE PILL
================================================ */

.mywealth-mode-pill{
  display:inline-flex;
  align-items:center;
  padding:7px 12px;

  background:#4E79BD;
  color:#fff;

  font-size:11px;
  font-weight:700;
  letter-spacing:.08em;

  border-radius:0;
  white-space:nowrap;
}


/* ================================================
   MYWEALTH · WAITING STATE
================================================ */

.mywealth-waiting{
  text-align:center;
  padding:64px 16px;
}

.mywealth-waiting-symbol{
  display:flex;
  align-items:center;
  justify-content:center;

  width:64px;
  height:64px;

  margin:0 auto 22px;

  border:1px dashed #4E79BD;
  color:#4E79BD;

  font-size:32px;
  font-weight:300;
}

.mywealth-waiting h3{
  margin:0 0 10px;
  font-size:20px;
}

.mywealth-waiting p{
  margin:0;
  color:#64748b;
  font-size:14px;
  line-height:1.6;
}

.mywealth-received{
  padding-top:12px;
}

/* Respect native hidden state */

#mywealth-waiting[hidden],
#mywealth-received[hidden],
#mywealth-race-section[hidden]{
  display:none !important;
}

/* ================================================
   MYWEALTH · WHITE WAITING PANEL
================================================ */

#page-mywealth .panel:has(#mywealth-waiting:not([hidden])){
  background:#ffffff;
  color:#4E79BD;
  border:1px solid #dbe5f2;
}

/* Header */

#page-mywealth .panel:has(#mywealth-waiting:not([hidden]))
.section-kicker{
  color:#4E79BD;
}

#page-mywealth .panel:has(#mywealth-waiting:not([hidden]))
.section-heading h2{
  color:#173B70;
}

/* Placeholder */

#mywealth-waiting{
  color:#173B70;
}

#mywealth-waiting h3{
  color:#173B70;
}

#mywealth-waiting p{
  color:#64748b;
}

#mywealth-waiting .mywealth-waiting-symbol{
  color:#4E79BD;
  border-color:#4E79BD;
}

#page-mywealth .panel:has(#mywealth-waiting){
  background:#fff;
  color:#4E79BD;
  border:1px solid #dbe5f2;
}


/* =====================================================
   MYWEALTH · SECTION 1
   WEALTH INPUTS + WEALTH RACE
===================================================== */

#page-mywealth{
  --mw-blue:#4E79BD;
  --mw-navy:#173B70;
  --mw-muted:#64748b;
  --mw-border:#dbe5f2;
  --mw-soft:#f3f7fc;
}


/* =====================================================
   01 · COMMON CONTAINERS
===================================================== */

#page-mywealth #mywealth-inputs,
#page-mywealth #mywealth-engine{
  background:#ffffff;
  color:var(--mw-navy);

  border:1px solid var(--mw-border);
  border-radius:0;

  padding:22px 24px;
  box-shadow:none;
}

#page-mywealth #mywealth-inputs{
  margin-bottom:16px;
}

#page-mywealth .section-heading{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:16px;
  margin-bottom:20px;
}

#page-mywealth .section-kicker{
  color:var(--mw-blue);
  font-size:10px;
  font-weight:700;
  letter-spacing:.09em;
  text-transform:uppercase;
}

#page-mywealth .section-heading h2{
  margin:4px 0 0;
  color:var(--mw-navy);
  font-size:20px;
  font-weight:750;
  line-height:1.2;
}


/* =====================================================
   02 · STARTING WEALTH + MONTHLY SAVINGS
===================================================== */

#page-mywealth .mywealth-input-row{
  margin-bottom:20px;
}

#page-mywealth .mywealth-input-row:last-child{
  margin-bottom:0;
}

#page-mywealth .mywealth-input-header,
#page-mywealth .mywealth-horizon-header{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
  margin-bottom:12px;
}

#page-mywealth .mywealth-input-header label{
  color:var(--mw-navy);
  font-size:13px;
  font-weight:600;
}

#page-mywealth .mywealth-input-header strong{
  color:var(--mw-blue);
  font-size:18px;
  font-weight:750;
  font-variant-numeric:tabular-nums;
  white-space:nowrap;
}


/* =====================================================
   03 · RANGE SLIDERS
===================================================== */

#page-mywealth input[type="range"]{
  display:block;
  width:100%;
  height:6px;

  margin:0;
  padding:0;

  border:0;
  border-radius:0;

  background:#dce6f2;

  appearance:none;
  -webkit-appearance:none;

  cursor:pointer;
  touch-action:pan-y;
}

#page-mywealth input[type="range"]::-webkit-slider-thumb{
  appearance:none;
  -webkit-appearance:none;

  width:19px;
  height:19px;

  background:var(--mw-blue);
  border:3px solid #ffffff;
  border-radius:50%;

  box-shadow:0 0 0 1px var(--mw-blue);
  cursor:grab;
}

#page-mywealth input[type="range"]::-moz-range-thumb{
  width:14px;
  height:14px;

  background:var(--mw-blue);
  border:3px solid #ffffff;
  border-radius:50%;

  box-shadow:0 0 0 1px var(--mw-blue);
  cursor:grab;
}

#page-mywealth input[type="range"]:active::-webkit-slider-thumb{
  cursor:grabbing;
}

#page-mywealth .mywealth-range-labels{
  display:flex;
  justify-content:space-between;
  align-items:center;

  margin-top:10px;

  color:var(--mw-muted);
  font-size:10px;
  font-weight:500;
}


/* =====================================================
   04 · MODE PILL
===================================================== */

#page-mywealth .mywealth-mode-pill{
  display:inline-flex;
  align-items:center;
  justify-content:center;

  flex:0 0 auto;

  padding:7px 11px;

  background:var(--mw-blue);
  color:#ffffff;

  border:0;
  border-radius:0;

  font-size:10px;
  font-weight:750;
  letter-spacing:.06em;
  white-space:nowrap;
}


/* =====================================================
   05 · HORIZON CONTROL
===================================================== */

#page-mywealth .mywealth-horizon{
  padding:16px 18px;
  margin-bottom:20px;

  background:var(--mw-soft);
  border:1px solid var(--mw-border);
  border-radius:0;
}

#page-mywealth .mywealth-horizon-header{
  margin-bottom:15px;
}

#page-mywealth .mywealth-horizon-header span{
  color:var(--mw-navy);
  font-size:13px;
  font-weight:650;
}

#page-mywealth .mywealth-horizon-header strong{
  color:var(--mw-blue);
  font-size:23px;
  font-weight:800;
  font-variant-numeric:tabular-nums;
  white-space:nowrap;
}

/* Larger engagement slider */

#page-mywealth #mywealth-horizon-slider{
  height:8px;
  background:#d5e2f1;
}

#page-mywealth #mywealth-horizon-slider::-webkit-slider-thumb{
  width:25px;
  height:25px;
  background:var(--mw-blue);
  border:4px solid #ffffff;
}

#page-mywealth #mywealth-horizon-slider::-moz-range-thumb{
  width:17px;
  height:17px;
  background:var(--mw-blue);
  border:4px solid #ffffff;
}


/* =====================================================
   06 · WEALTH / COSTS TOGGLE
===================================================== */

#page-mywealth .mywealth-view-toggle{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:0;

  width:100%;
  margin-bottom:22px;

  border:1px solid var(--mw-border);
  border-radius:0;
  overflow:hidden;
}

#page-mywealth .mywealth-view-btn{
  display:flex;
  align-items:center;
  justify-content:center;

  min-height:42px;
  padding:10px 12px;

  background:#ffffff;
  color:var(--mw-navy);

  border:0;
  border-radius:0;

  font:inherit;
  font-size:11px;
  font-weight:750;
  letter-spacing:.04em;

  cursor:pointer;
  transition:background .18s ease,color .18s ease;
}

#page-mywealth .mywealth-view-btn + .mywealth-view-btn{
  border-left:1px solid var(--mw-border);
}

#page-mywealth .mywealth-view-btn.active{
  background:var(--mw-blue);
  color:#ffffff;
}

#page-mywealth .mywealth-view-btn:disabled{
  background:#e5e7eb;
  color:#9ca3af;

  opacity:1;
  cursor:not-allowed;
}

#page-mywealth .mywealth-view-btn:focus-visible{
  outline:2px solid var(--mw-navy);
  outline-offset:-3px;
}


/* =====================================================
   07 · WAITING STATE
===================================================== */

#page-mywealth .mywealth-waiting{
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;

  min-height:190px;
  padding:34px 16px;

  text-align:center;
  color:var(--mw-navy);
}

#page-mywealth .mywealth-waiting-symbol{
  display:flex;
  align-items:center;
  justify-content:center;

  width:48px;
  height:48px;
  margin:0 0 18px;

  border:1px dashed var(--mw-blue);
  border-radius:0;

  color:var(--mw-blue);
  font-size:27px;
  font-weight:300;
}

#page-mywealth .mywealth-waiting h3{
  margin:0 0 8px;

  color:var(--mw-navy);
  font-size:17px;
  font-weight:700;
}

#page-mywealth .mywealth-waiting p{
  max-width:320px;
  margin:0;

  color:var(--mw-muted);
  font-size:12px;
  line-height:1.6;
}


/* =====================================================
   08 · RECEIVED STATE / HISTOGRAM
===================================================== */

#page-mywealth .mywealth-received{
  padding:0;
}

#page-mywealth .mywealth-race-section{
  width:100%;
  min-width:0;
}

#page-mywealth .mywealth-chart-heading{
  display:flex;
  justify-content:space-between;
  align-items:center;
  flex-wrap:wrap;
  gap:10px;

  margin-bottom:16px;
}

#page-mywealth .mywealth-chart-heading h3{
  margin:0;

  color:var(--mw-navy);
  font-size:16px;
  font-weight:700;
}

#page-mywealth #mywealth-chart-caption{
  color:var(--mw-muted);
  font-size:11px;
}

#page-mywealth .mywealth-race{
  position:relative;

  width:100%;
  height:310px;
  min-width:0;

  background:#ffffff;
  border:1px solid var(--mw-border);
  border-radius:0;

  overflow:hidden;
}

#page-mywealth #mywealth-race-canvas{
  display:block;

  width:100%;
  height:100%;

  touch-action:pan-y;
}


/* =====================================================
   09 · NATIVE HIDDEN STATE
===================================================== */

#page-mywealth #mywealth-waiting[hidden],
#page-mywealth #mywealth-received[hidden],
#page-mywealth #mywealth-race-section[hidden],
#page-mywealth #mywealth-basket[hidden]{
  display:none !important;
}


/* =====================================================
   10 · MOBILE
===================================================== */

@media(max-width:600px){

  #page-mywealth #mywealth-inputs,
  #page-mywealth #mywealth-engine{
