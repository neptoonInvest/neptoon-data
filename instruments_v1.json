  /* =====================================================
   LIFE CYCLE INTRO
===================================================== */

.lifeIntro{
  margin:22px 0 28px;
  padding:30px 32px 26px;
  background:#fff;
  border-top:1px solid #d9dee7;
  border-bottom:1px solid #d9dee7;
}


/* TOP */

.lifeIntroTop{
  display:grid;
  grid-template-columns:minmax(0,0.9fr) minmax(420px,1.1fr);
  gap:48px;
  align-items:center;
}


.lifeIntroKicker{
  margin-bottom:8px;

  font-size:11px;
  font-weight:700;
  letter-spacing:.11em;

  color:#4E79BD;
}


.lifeIntroTitle{
  margin:0 0 13px;

  max-width:580px;

  font-family:"Times New Roman", serif;
  font-size:29px;
  line-height:1.08;
  font-weight:400;

  color:#0f1b2c;
}


.lifeIntroText{
  max-width:650px;

  font-size:13px;
  line-height:1.65;

  color:#536070;
}



/* =====================================================
   VISUAL
===================================================== */

.lifeIntroVisual{
  display:grid;
  grid-template-columns:1fr 44px 1.35fr;
  align-items:center;
  gap:12px;
}


.introVisualBlock{
  min-width:0;
}


.introVisualLabel{
  margin-bottom:8px;

  font-size:9px;
  font-weight:700;
  letter-spacing:.11em;

  color:#7a8492;
}


.introVisualCaption{
  margin-top:7px;

  font-size:10px;
  line-height:1.3;

  color:#7a8492;
}



/* LEDGER */

.ledgerSheet{
  height:106px;

  padding:16px 14px;

  border:1px solid #cfd5dd;
  background:#fafbfc;

  box-sizing:border-box;
}


.ledgerLine{
  display:grid;
  grid-template-columns:1fr 36%;
  gap:12px;

  margin-bottom:10px;
}


.ledgerLine span,
.ledgerLine strong{
  display:block;
  height:4px;

  background:#d9dee5;
}


.ledgerLine strong{
  background:#bfc7d1;
}


.ledgerTotal{
  width:52%;
  height:5px;

  margin-left:auto;
  margin-top:13px;

  background:#8e99a7;
}



/* ARROW */

.introVisualArrow{
  display:flex;
  align-items:center;
}


.introArrowLine{
  height:1px;
  flex:1;

  background:#aeb7c3;
}


.introArrowHead{
  position:relative;
  top:-1px;

  font-family:"Times New Roman", serif;
  font-size:25px;
  line-height:1;

  color:#4E79BD;
}



/* MOUNTAIN */

.miniMountain{
  height:106px;

  padding:5px 8px 0;

  border-bottom:1px solid #d5dae1;

  box-sizing:border-box;
}


.miniMountain svg{
  display:block;

  width:100%;
  height:78px;
}


.miniMountainFill{
  fill:rgba(78,121,189,.10);
}


.miniMountainLine{
  fill:none;

  stroke:#4E79BD;
  stroke-width:2;
}


.miniFreedomLine{
  stroke:#9da7b4;
  stroke-width:1;
  stroke-dasharray:3 3;
}


.miniFreedomDot{
  fill:#4E79BD;
}


.miniMountainLabels{
  display:grid;
  grid-template-columns:1fr 1fr 1fr;

  margin-top:3px;

  font-size:8px;
  font-weight:700;
  letter-spacing:.06em;

  color:#7b8490;
}


.miniMountainLabels span:nth-child(2){
  text-align:center;
  color:#4E79BD;
}


.miniMountainLabels span:last-child{
  text-align:right;
}



/* =====================================================
   COMPARISON
===================================================== */

.lifeIntroCompare{
  margin-top:28px;

  border-top:1px solid #e0e4e9;
  border-bottom:1px solid #e0e4e9;
}


.compareHead,
.compareRow{
  display:grid;
  grid-template-columns:1fr 50px 1fr;
  align-items:center;
}


.compareHead{
  padding:10px 12px;

  font-size:9px;
  font-weight:700;
  letter-spacing:.10em;

  color:#6f7987;

  background:#f7f8fa;
}


.compareHead div:last-child{
  color:#4E79BD;
}


.compareRow{
  min-height:38px;
  padding:0 12px;

  border-top:1px solid #edf0f3;

  font-size:11px;
  color:#4f5967;
}


.compareRow > div:last-child{
  color:#162235;
  font-weight:600;
}


.compareArrow{
  text-align:center;

  font-size:15px;
  color:#4E79BD;
}



/* =====================================================
   DECISION
===================================================== */

.lifeIntroDecision{
  display:grid;
  grid-template-columns:190px 190px 1fr;
  gap:22px;
  align-items:center;

  padding-top:22px;
}


.decisionTag{
  font-size:9px;
  line-height:1.5;
  font-weight:700;
  letter-spacing:.08em;

  color:#4E79BD;
}


.decisionDot{
  padding:0 4px;
  color:#a4acb7;
}


.decisionTitle{
  font-family:"Times New Roman", serif;
  font-size:19px;

