}else{

        /*
          These are illustrative component bookings only.

          Public pension transfers value from its shadow
          entitlement into the investable portfolio.

          FIRE consumption is NOT deducted from the asset
          side here. It is represented by Funding Portfolio.
        */

publicPensionCashflow =
  publicPensionAtMonth(
    inputs,
    month
  );

supplementaryPensionCashflow =
  supplementaryPensionAtMonth(
    inputs,
    month
  );

portfolio +=
  publicPensionCashflow +
  supplementaryPensionCashflow;

        consumption =
          inputs.monthlyConsumption;

      }

    }


    /*
      ASSET SUBSTITUTION

      Liquidation dates govern only the illustrative booking
      of the asset value.

      After n*, source asset and destination portfolio use
      the same return. Deferred capital gains tax can still
      make liquidation timing economically relevant.
    */

    for(const asset of inputs.assets){

