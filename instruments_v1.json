/* =====================================================
   17 · CANVAS PLACEHOLDERS
===================================================== */

function paintEmptyCanvas(id) {
    const c = $(id);
    if (!c)
        return;
    const r = c.getBoundingClientRect();
    if (r.width < 1)
        return;
    const dpr = window.devicePixelRatio || 1;
    c.width = Math.round(r.width * dpr);
    c.height = Math.round(r.height * dpr);
    const ctx = c.getContext('2d');
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    const w = r.width, h = r.height;
    ctx.clearRect(0, 0, w, h);
    ctx.strokeStyle = 'rgba(152,208,240,.18)';
    ctx.lineWidth = 1;
    for (let i = 1; i < 5; i++) {
        const y = 15 + (h - 35) * i / 5;
        ctx.beginPath();
        ctx.moveTo(38, y);
        ctx.lineTo(w - 10, y);
        ctx.stroke();
    }
    ctx.fillStyle = '#a5bbd4';
    ctx.font = '13px system-ui';
    ctx.textAlign = 'center';
    ctx.fillText('Awaiting financial data', w / 2, h / 2);
    ctx.textAlign = 'start';
}



/* =====================================================
   WEALTH PLAN · REUSABLE MODEL DATA
===================================================== */

function getWealthPlanData(modelNo, lang = APP.lang){

  const p =
    (PORTFOLIO_STATE.all || []).find(
      x =>
        Number(x.modelNo) === Number(modelNo)
    );

  if(!p) return null;

  const da = lang === "da";

  const boolText = (value, yes, no) => {
    if(value === true) return yes;
    if(value === false) return no;
    return null;
  };

  const holdings =
    (Array.isArray(p.arrayHoldings)
      ? p.arrayHoldings
      : []
    ).map(h => {

      const meta = [];

      const accumulation = boolText(
        h.isAcc,
        da ? "Akkumulerende" : "Accumulating",
        da ? "Udbyttebetalende" : "Distributing"
      );

      if(accumulation){
        meta.push(accumulation);
      }

      const management = boolText(
        h.isActive,
        da ? "Aktivt forvaltet" : "Actively managed",
        da ? "Passivt forvaltet" : "Passively managed"
      );

      if(management){
        meta.push(management);
      }

      if(da){

        const positiveList = boolText(
          h.isPositivListe,
          "På positivlisten",
          "Ikke på positivlisten"
        );

        if(positiveList){
          meta.push(positiveList);
        }

      }

      return {

        name:
          h.instrumentName ||
          h.name ||
          h.tickerExchange ||
          "—",

        assetClass:
          (da
            ? h.classMajorTop || h.class_major_top_eng
            : h.class_major_top_eng || h.classMajorTop
          ) || "—",

        type:
          (da
            ? h.type_label_dk || h.type_label_eng
            : h.type_label_eng || h.type_label_dk
          ) || "—",

        isin:h.isin || "—",

        ccy:h.ccy || "—",

        weight:h.weight,

        meta

      };

    });

const k = p.objKeyFigures || {};

return {

  modelNo: p.modelNo,
  name: p.modelLabel || "—",
  issuer: p.issuerName || "—",

  description:
    lang === "da"
      ? p.descriptionLong_da
      : p.descriptionLong_en,

  metrics: {
    expRetGross: k.expRetGross,
    expRetNet: k.expRetNet,
    risk: k.risk,
    costs: k.costs,
    sharpeRatioNet: k.sharpeRatioNet,
    equityWeight: k.equityWeight,
    bondWeight: k.bondWeight
  },

  holdings,

  holdingsCount: holdings.length,

  totalWeight: holdings.reduce(
    (sum, h) => sum + (Number(h.weight) || 0),
    0
  )

};

}

