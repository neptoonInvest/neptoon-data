	function bindFooterInfo(){

  const panel = document.getElementById("lcFooterInfo");

  if(!panel) return;

  const links = document.querySelectorAll("[data-footer-open]");
  const tabs = panel.querySelectorAll("[data-footer-panel]");
  const sections = panel.querySelectorAll("[data-footer-content]");

  let active = null;

  function openFooter(name){

    if(active === name && !panel.hidden){
      panel.hidden = true;
      active = null;
      return;
    }

    active = name;
    panel.hidden = false;

    const lang =
      document.documentElement.lang === "da"
        ? "da"
        : "en";

    const L = footerTranslations[lang] || footerTranslations.en;

    [
      "lcFooterAboutText",
      "lcFooterPrivacyText",
      "lcFooterTermsText"
    ].forEach(key => {

      const el = document.getElementById(key);

      if(el){
        el.textContent = L[key] || "";
      }

    });

    sections.forEach(section => {
      section.hidden =
        section.dataset.footerContent !== name;
    });

    tabs.forEach(tab => {

      const selected =
        tab.dataset.footerPanel === name;

      tab.classList.toggle("active", selected);
      tab.setAttribute("aria-selected", String(selected));

    });

  }

  links.forEach(link => {

    link.addEventListener("click", event => {

      event.preventDefault();

      openFooter(link.dataset.footerOpen);

    });

  });

  tabs.forEach(tab => {

    tab.addEventListener("click", () => {

      active = null;
      openFooter(tab.dataset.footerPanel);

    });

  });

  document.getElementById("lcFooterInfoClose")
    ?.addEventListener("click", () => {

      panel.hidden = true;
      active = null;

    });

}


function formatMoneyPlain(value){

  const n = Number(value);

  if(!Number.isFinite(n)){
    return "—";
  }

  return Math.round(n)
    .toLocaleString("da-DK",{
      maximumFractionDigits:0
    });

}
function buildSupplementaryPensionPV(
  inputs,
  annualUseRealRate
){

  const totalMonths =
    totalMonthsFor(inputs);

  const monthlyRate =
    annualToMonthly(
      annualUseRealRate
    );

  const pv =
    new Array(totalMonths + 1).fill(0);

  if(inputs.supplementaryPension <= 0){
    return pv;
  }

  /*
    BACKWARD RECURSION
  */

  for(
    let month = totalMonths - 1;
    month >= 0;
    month--
  ){

    const nextPension =
      supplementaryPensionAtMonth(
        inputs,
        month + 1
      );

    pv[month] =
      (
        nextPension +
        pv[month + 1]
      ) /
      (1 + monthlyRate);

  }

  return pv;

}

