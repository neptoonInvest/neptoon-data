/* =====================================================
   CANVAS
===================================================== */


function prepareCanvas(){

  const canvas =
    byId("lifeChart");

  const rect =
    canvas.getBoundingClientRect();

  /*
    Hidden tab:
    Do not resize or initialize canvas.
  */

  if(
    rect.width <= 0 ||
    rect.height <= 0
  ){

    return null;

  }

  const dpr =
    window.devicePixelRatio || 1;

  canvas.width =
    Math.max(
      1,
      Math.round(rect.width * dpr)
    );

  canvas.height =
    Math.max(
      1,
      Math.round(rect.height * dpr)
    );

  const ctx =
    canvas.getContext("2d");

  ctx.setTransform(
    dpr,
    0,
    0,
    dpr,
    0,
    0
  );

  return {
    ctx,
    width: rect.width,
    height: rect.height
  };

}


function niceStep(raw){

  if(
    !Number.isFinite(raw) ||
    raw <= 0
  ){
    return 1;
  }

  const power =
    Math.pow(
      10,
      Math.floor(
        Math.log10(raw)
      )
    );

  const fraction =
    raw/power;

  let niceFraction;

  if(fraction <= 1){
    niceFraction = 1;
  }else if(fraction <= 2){
    niceFraction = 2;
  }else if(fraction <= 5){
    niceFraction = 5;
  }else{
    niceFraction = 10;
  }

  return niceFraction*power;
}


