function getScenarioRates(
  riskClass,
  expectedRate
){

  const uncertainty =
    RISK_UNCERTAINTY[riskClass] ?? 0;

  return {

    expected:expectedRate,

    favorable:
      expectedRate + uncertainty,

    adverse:
      Math.max(
        -0.95,
        expectedRate - uncertainty
      )

  };

}





