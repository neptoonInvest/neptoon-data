function hidePremiumOverlay(){

  const overlay =
    document.getElementById("accountPremiumOverlay");

  const trigger =
    document.getElementById("accountExplorePremium");

  if(overlay){
    overlay.hidden = true;
  }

  if(trigger){
    trigger.focus();
  }

}


function initializePremiumOverlay(){

  const trigger =
    document.getElementById("accountExplorePremium");

  const overlay =
    document.getElementById("accountPremiumOverlay");

  const close =
    document.getElementById("accountPremiumClose");

  if(!trigger || !overlay || !close){
    return;
  }

  trigger.addEventListener("click", () => {

    overlay.hidden = false;
    close.focus();

  });

  close.addEventListener(
    "click",
    hidePremiumOverlay
  );

  overlay.addEventListener("click", event => {

    if(event.target === overlay){
      hidePremiumOverlay();
    }

  });

  document.addEventListener("keydown", event => {

    if(
      event.key === "Escape" &&
      !overlay.hidden
    ){
      hidePremiumOverlay();
    }

  });

}

