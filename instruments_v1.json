function renderPlanDetails(){

  /*
    ==========================================
    REMOVE PREVIOUS HOLDINGS EXPANSIONS
    ==========================================
  */

  const basket =
    document.getElementById("portfolios-basket");

  if(!basket) return;

  basket
    .querySelectorAll(".wealthplan-holdings")
    .forEach(el => el.remove());


  /*
    ==========================================
    SELECTED PLAN
    ==========================================
  */

  const index = APP.expandedPlan;

  if(
    !Number.isInteger(index) ||
    index < 0 ||
    index >= APP.planSlots.length
  ){
    return;
  }

  const slot =
    APP.planSlots[index];

  const modelNo =
    slot?.modelNo;

  if(
    modelNo === null ||
    modelNo === undefined ||
    modelNo === ""
  ){
    return;
  }


  /*
    ==========================================
    LIVE PORTFOLIO LOOKUP
    ==========================================
  */

  const p =
    (PORTFOLIO_STATE.all || []).find(
      x =>
        Number(x.modelNo) ===
        Number(modelNo)
    );

  if(!p) return;

  const rows =
    basket.querySelectorAll(".wealthplan-row");

  const row = rows[index];

  if(!row) return;


  /*
    ==========================================
    LANGUAGE
    ==========================================
  */

  const da =
    APP.lang === "da";

  const lang =
    da ? "da" : "en";


  /*
    ==========================================
    FORMATTERS
    ==========================================
  */

  const boolText = (value, yes, no) => {

    if(value === true) return yes;

    if(value === false) return no;

    return null;

  };


  const formatWeight = value => {

    if(
      value === null ||
      value === undefined ||
      value === ""
    ){
      return "—";
    }

    const n = Number(value);

    if(!Number.isFinite(n)){
      return "—";
    }

    return (
      (n * 100).toLocaleString(
        da ? "da-DK" : "en-US",
        {
          minimumFractionDigits:1,
          maximumFractionDigits:1
        }
      ) + "%"
    );

  };


  /*
    ==========================================
    BUILD LIVE HOLDINGS
    ==========================================
  */

  const holdings =
    (Array.isArray(p.arrayHoldings)
      ? p.arrayHoldings
      : []
    ).map(h => {

      /*
        Instrument name
      */

      const name =
        h.instrumentName ||
        h.name ||
        h.tickerExchange ||
        "—";


      /*
        Asset class
      */

      const assetClass =
        da
          ? (
              h.classMajorTop ||
              h.class_major_top_eng ||
              "—"
            )
          : (
              h.class_major_top_eng ||
              h.classMajorTop ||
              "—"
            );


      /*
        Instrument type
      */

      const type =
        da
          ? (
              h.type_label_dk ||
              h.type_label_eng ||
              "—"
            )
          : (
              h.type_label_eng ||
              h.type_label_dk ||
              "—"
            );


      /*
        Identifiers
      */

      const isin =
        h.isin || "—";

      const ccy =
        h.ccy || "—";


      /*
        Instrument characteristics
      */

      const meta = [];

      const accumulation = boolText(
        h.isAcc,
        da
          ? "Akkumulerende"
          : "Accumulating",
        da
          ? "Udbyttebetalende"
          : "Distributing"
      );

      if(accumulation){
        meta.push(accumulation);
      }


      const management = boolText(
        h.isActive,
        da
          ? "Aktivt forvaltet"
          : "Actively managed",
        da
          ? "Passivt forvaltet"
          : "Passively managed"
      );

      if(management){
        meta.push(management);
      }


      /*
        Danish positive list
      */

      if(da){

        const positiveList = boolText(
          h.isPositivListe,
          "På positivlisten",
          "Ikke på positivlisten"
        );

        if(positiveList){
          meta.push(positiveList);
        }

      }


      /*
        Final normalized holding
      */

      return {

        name,
        assetClass,
        type,
        isin,
        ccy,
        weight:h.weight,
        meta

      };

    });


  /*
    ==========================================
    HOLDINGS HTML
    ==========================================
  */

  const title =
    da
      ? "Beholdninger"
      : "Holdings";


  const html = `

    <div class="wealthplan-holdings">

      <!-- HEADER -->

      <div class="wealthplan-holdings-title">

        <span>
          ${title} (${holdings.length})
        </span>

      </div>


      <!-- COLUMN HEADINGS -->

      <div class="wealthplan-holdings-header">

        <span>
          Instrument
        </span>

        <span>
          ${da ? "Aktivklasse" : "Asset class"}
        </span>

        <span>
          Type
        </span>

        <span>
          ISIN
        </span>

        <span>
          CCY
        </span>

        <span class="wealthplan-holding-weight">
          ${da ? "Vægt" : "Weight"}
        </span>

      </div>


      <!-- LIVE HOLDINGS -->

      ${holdings.map(h => `

        <div class="wealthplan-holding-row">

          <!-- INSTRUMENT -->

          <div class="wealthplan-holding-name">

            ${esc(h.name)}

            ${h.meta.length ? `

              <div class="wealthplan-holding-meta">

                ${h.meta.map(esc).join(" · ")}

              </div>

            ` : ""}

          </div>


          <!-- ASSET CLASS -->

          <div class="wealthplan-holding-class">
            ${esc(h.assetClass)}
          </div>


          <!-- TYPE -->

          <div class="wealthplan-holding-type">
            ${esc(h.type)}
          </div>


          <!-- ISIN -->

          <div class="wealthplan-holding-isin">
            ${esc(h.isin)}
          </div>


          <!-- CURRENCY -->

          <div class="wealthplan-holding-ccy">
            ${esc(h.ccy)}
          </div>


          <!-- WEIGHT -->

          <div class="wealthplan-holding-weight">
            ${formatWeight(h.weight)}
          </div>

        </div>

      `).join("")}

    </div>

  `;


  /*
    ==========================================
    INSERT BELOW SELECTED BASKET ROW
    ==========================================
  */

  row.insertAdjacentHTML(
    "afterend",
    html
  );

  icons();

}


