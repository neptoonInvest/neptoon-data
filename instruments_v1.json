/* =====================================================
   MORTGAGE OVERLAY
===================================================== */


function createMortgageState(inputs){

  const m = inputs.mortgage || {};

  const remainingMonths = Math.max(
    1,
    Math.round(
      (Number(m.remainingYears) || 1) * 12
    )
  );

  const noRepaymentMonths = clamp(
    Math.round(
      (Number(m.interestOnlyYears) || 0) * 12
    ),
    0,
    remainingMonths
  );

  const nominalDebt = Math.max(
    0,
    Number(m.outstandingDebt) || 0
  );

  return {
    enabled:!!m.enabled && nominalDebt > 0,

    nominalDebt,

    annualRate:Math.max(
      0,
      Number(m.annualRate) || 0
    ),

    annualCosts:Math.max(
      0,
      Number(m.annualCosts) || 0
    ),

    remainingMonths,
    noRepaymentMonths,
    originalRemainingMonths:remainingMonths
  };

}





function mortgageMonthStep(state,month,inputs){

  const realDebt = () =>
    state.enabled
      ? mortgageRealDebt(state.nominalDebt,month,inputs)
      : 0;

  const emptyStep = () => ({
    principalNominal:0,
    principalReal:0,
    interestNominal:0,
    interestReal:0,
    costsNominal:0,
    costsReal:0,
    paymentNominal:0,
    paymentReal:0,
    realDebt:realDebt()
  });

  if(
    !state.enabled ||
    state.nominalDebt <= 0 ||
    month <= 0
  ){
    return emptyStep();
  }

  if(month > state.originalRemainingMonths){
    // Never silently extinguish unpaid debt.
    return emptyStep();
  }

  const openingDebt =
    state.nominalDebt;

  const r =
    annualToMonthly(state.annualRate);

  /*
    CONTRACTUAL INTEREST
  */

  const interestNominal =
    openingDebt * r;

  /*
    ADDITIONAL ANNUAL COSTS

    Annual decimal rate on opening debt.
    Does not affect amortization.
  */

  const costsNominal =
    openingDebt *
    (Number(state.annualCosts) || 0) / 12;

  /*
    CONTRACTUAL PRINCIPAL
  */

  let principalNominal = 0;

  if(month > state.noRepaymentMonths){

    const monthsLeft = Math.max(
      1,
      state.originalRemainingMonths - month + 1
    );

    const payment = r === 0
      ? openingDebt / monthsLeft
      : openingDebt * r /
        (1 - Math.pow(1 + r,-monthsLeft));

    principalNominal = clamp(
      payment - interestNominal,
      0,
      openingDebt
    );

  }

  /*
    FINAL MATURITY

    Settle all remaining principal,
    including an interest-only balloon.
  */

  if(month === state.originalRemainingMonths){
    principalNominal = openingDebt;
  }

  state.nominalDebt = Math.max(
    0,
    openingDebt - principalNominal
  );

  /*
    TOTAL MONTHLY DEBT SERVICE
  */

  const paymentNominal =
    principalNominal +
    interestNominal +
    costsNominal;

  /*
    NOMINAL TO REAL
  */

  const inflationFactor =
    Math.pow(
      1 + (Number(inputs.inflation) || 0),
      month / 12
    );

  const toReal = value =>
    inflationFactor > 0
      ? value / inflationFactor
      : value;

  return {
    principalNominal,
    principalReal:toReal(principalNominal),

    interestNominal,
    interestReal:toReal(interestNominal),

    costsNominal,
    costsReal:toReal(costsNominal),

    paymentNominal,
    paymentReal:toReal(paymentNominal),

    realDebt:realDebt()
  };

}









function mortgageRealDebt(nominalDebt,month,inputs){
  const factor=Math.pow(1+inputs.inflation,Math.max(0,month)/12);
  return factor>0 ? nominalDebt/factor : nominalDebt;
}



    
    
  function deferredPensionTaxLiabilityAtMonth(
  inputs,
  month,
  freedomMonth,
  liquidationMonth,
  annualBuildRate,
  annualUseRate
){

  if(
    !inputs.pensionTaxEnabled ||
    month >= liquidationMonth
  ){
    return 0;
  }

  const taxNominal =
    Math.max(0, Number(inputs.pensionTaxAmount) || 0);

  if(taxNominal === 0) return 0;

  const inflation = Number(inputs.inflation) || 0;

  const taxRealAtLiquidation =
    taxNominal /
    Math.pow(1 + inflation, liquidationMonth / 12);

  const buildMonthlyRate =
    annualToMonthly(annualBuildRate);

  const useMonthlyRate =
    annualToMonthly(annualUseRate);

  const buildMonthsRemaining =
    Math.max(
      0,
      Math.min(liquidationMonth, freedomMonth) - month
    );

  const useMonthsRemaining =
    liquidationMonth -
    month -
    buildMonthsRemaining;

  return (
    taxRealAtLiquidation /
    (
      Math.pow(1 + buildMonthlyRate, buildMonthsRemaining) *
      Math.pow(1 + useMonthlyRate, useMonthsRemaining)
    )
  );

}
    










