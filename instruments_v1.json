      y+4,
      {align:"right"}
    );

    y += 16;


    /* =====================================
       SHORT MODEL DESCRIPTION
    ===================================== */

    const description = da
      ? p.descriptionLong_da
      : p.descriptionLong_en;

    if(description){

      heading(
        T("Portfolio Strategy","Porteføljestrategi")
      );

      /*
        Keep the report concise:
        use the introductory paragraph only.
      */

      const intro = String(description)
        .split(/\n\s*\n/)[0]
        .trim();

      smallText(intro);

    }

  });


  /* =====================================
     ADD FOOTERS AFTER ALL PAGES EXIST
  ===================================== */

  const pageCount =
    pdf.internal.getNumberOfPages();

  for(let i=1;i<=pageCount;i++){

    pdf.setPage(i);
    drawFooter();

  }


  /* =====================================
     DOWNLOAD
  ===================================== */

  const dateFile =
    timestamp.toISOString().slice(0,10);

  pdf.save(
    `Neptoon_Wealth_Plan_${dateFile}.pdf`
  );

  console.log(
    "WEALTH PLAN PDF GENERATED",
    {
      models:plans.length,
      pages:pageCount
    }
  );

}



