/* =====================================================
   TIME MACHINE · HISTORICAL STATISTICS
===================================================== */

function tmCalculatePeriodReturn(series, key){

  if(!Array.isArray(series) || series.length < 2){
    return null;
  }

  const first = Number(series[0][key]);
  const last = Number(series[series.length - 1][key]);

  const months = series.length - 1;

  if(
    !Number.isFinite(first) ||
    !Number.isFinite(last) ||
    first <= 0 ||
    last <= 0 ||
    months <= 0
  ){
    return null;
  }

  return {

    accumulated:
      (last / first - 1) * 100,

    annualized:
      (Math.pow(last / first, 12 / months) - 1) * 100

  };

}


/* =====================================================
   RENDER ALL DECADES + TOTAL
===================================================== */

function tmRenderStatistics(){

  if(!TIME_MACHINE.data) return;

  const tbody = tmEl("tm-statistics-body");

  if(!tbody) return;

  const key = tmNAVKey();
  const lang = tmLang();

  const chapters = TIME_MACHINE.chapters;

  const formatReturn = value => {

    if(!Number.isFinite(value)){
      return "—";
    }

    return tmFormatPercent(value);

  };

  const returnClass = value => {

    if(!Number.isFinite(value)){
      return "";
    }

    if(value > 0) return "positive";
    if(value < 0) return "negative";

    return "";

  };

  tbody.innerHTML = chapters.map((chapter,index) => {

    const result = tmCalculatePeriodReturn(
      chapter.series,
      key
    );

    const accumulated = result?.accumulated;
    const annualized = result?.annualized;

    const era =
      chapter.title?.[lang] ||
      chapter.title?.en ||
      "";

    const active =
      index === TIME_MACHINE.chapterIndex;

    return `
      <tr
        class="${active ? "active" : ""}"
        data-tm-chapter="${index}"
        tabindex="0"
        role="button"
        aria-label="${chapter.period}"
      >

        <td>
          ${chapter.period}
        </td>

        <td class="tm-stats-era">
          ${era}
        </td>

        <td class="tm-stats-number ${returnClass(accumulated)}">
          ${formatReturn(accumulated)}
        </td>

        <td class="tm-stats-number ${returnClass(annualized)}">
          ${formatReturn(annualized)}
        </td>

      </tr>
    `;

  }).join("");


  /* =====================================
     TOTAL · CONTINUOUS HISTORICAL NAV
  ===================================== */

  const total = tmCalculatePeriodReturn(
    TIME_MACHINE.data.nav,
    key
  );

  const totalPeriod =
    tmEl("tm-stats-total-period");

  const totalLabel =
    tmEl("tm-stats-total-label");

  const totalReturn =
    tmEl("tm-stats-total-return");

  const totalAnnualized =
    tmEl("tm-stats-total-annualized");

  if(totalPeriod){

    totalPeriod.textContent =
      tmText("TOTAL","TOTAL");

  }

  if(totalLabel){

    const nav = TIME_MACHINE.data.nav;

    const firstYear =
      nav[0]?.date?.slice(0,4) || "1900";

    const lastYear =
      nav[nav.length - 1]?.date?.slice(0,4) || "";

    totalLabel.textContent =
      `${firstYear}–${lastYear}`;

  }

  if(totalReturn){

    totalReturn.textContent =
      total
        ? formatReturn(total.accumulated)
        : "—";

    totalReturn.classList.remove(
      "positive","negative"
    );

    if(total){
      totalReturn.classList.add(
        returnClass(total.accumulated)
      );
    }

  }

  if(totalAnnualized){

    totalAnnualized.textContent =
      total
        ? formatReturn(total.annualized)
        : "—";

    totalAnnualized.classList.remove(
      "positive","negative"
    );

    if(total){
      totalAnnualized.classList.add(
        returnClass(total.annualized)
      );
    }

  }

}



