  border-bottom:2px solid transparent;
  border-radius:0;
  background:transparent;
  color:#64748b;
  font-size:12px;
  font-weight:600;
  cursor:pointer;
}

.lcAccountTab.active{
  color:#4E79BD;
  border-bottom-color:#4E79BD;
}

.lcAccountTab:hover{
  color:#4E79BD;
}

/* FORM */

.lcAccountForm{
  display:flex;
  flex-direction:column;
  gap:17px;
  padding:24px 30px 22px;
}

.lcAccountField{
  display:flex;
  flex-direction:column;
  gap:7px;
}

.lcAccountField label{
  color:#475569;
  font-size:11px;
  font-weight:600;
}

.lcAccountField input{
  width:100%;
  box-sizing:border-box;
  min-height:42px;
  padding:10px 12px;
  border:1px solid #cbd5e1;
  border-radius:0;
  background:#fff;
  color:#1e293b;
  font-family:inherit;
  font-size:13px;
  outline:none;
}

.lcAccountField input:focus{
  border-color:#4E79BD;
  box-shadow:0 0 0 2px rgba(78,121,189,.12);
}

/* BUTTONS */

.lcAccountPrimaryBtn{
  display:block;
  width:100%;
  min-height:43px;
  padding:11px 16px;
  border:1px solid #4E79BD;
  border-radius:0;
  background:#4E79BD;
  color:#fff;
  font-family:inherit;
  font-size:12px;
  font-weight:600;
  text-align:center;
  cursor:pointer;
  transition:background .15s ease;
}

.lcAccountPrimaryBtn:hover{
  background:#3d66a7;
}

.lcAccountPrimaryBtn:disabled{
  opacity:.55;
  cursor:wait;
}

.lcAccountTextBtn{
  align-self:center;
  padding:4px 8px;
  border:0;
  border-radius:0;
  background:transparent;
  color:#64748b;
  font-family:inherit;
  font-size:11px;
  cursor:pointer;
}

.lcAccountTextBtn:hover{
  color:#4E79BD;
  text-decoration:underline;
}

.lcAccountMessage{
  min-height:0;
  color:#475569;
  font-size:12px;
  line-height:1.5;
}

.lcAccountMessage:empty{
  display:none;
}

/* ACCOUNT BENEFITS */

.lcAccountBenefits{
  padding:21px 30px 24px;
  border-top:1px solid #e2e8f0;
  background:#fbfcfe;
}

.lcAccountBenefitsTitle{
  margin-bottom:16px;
  color:#64748b;
  font-size:10px;
  font-weight:700;
  letter-spacing:.7px;
}

.lcAccountBenefit{
  display:flex;
  align-items:flex-start;
  gap:11px;
  margin-bottom:13px;
  color:#334155;
  font-size:12px;
  line-height:1.5;
}

.lcAccountBenefitIcon{
  flex:0 0 16px;
  color:#4E79BD;
  font-size:15px;
  text-align:center;
}

.lcAccountFineprint{
  margin:17px 0 0;
  color:#94a3b8;
  font-size:10px;
  line-height:1.5;
  text-align:center;
}

/* =====================================================
   AUTHENTICATED MEMBER VIEW
===================================================== */

.lcAccountMemberInfo{
  padding:25px 30px 20px;
}

.lcAccountMemberInfo h3{
  margin:0 0 7px;
  font-family:"Times New Roman",serif;
  font-size:23px;
  font-weight:400;
  color:#1e293b;
}

#lcAccountMemberEmail{
  color:#64748b;
  font-size:12px;
  overflow-wrap:anywhere;
}

.lcAccountPlanRow{
  display:flex;
  align-items:center;
  justify-content:space-between;
  margin-top:25px;
  padding-top:16px;
  border-top:1px solid #e2e8f0;
  color:#475569;
  font-size:12px;
}

#lcAccountPlanLabel{
  color:#4E79BD;
  font-size:11px;
  letter-spacing:.5px;
}

/* FEATURES */

.lcAccountFeatures{
  padding:0 30px 20px;
}

.lcAccountFeature{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
  padding:12px 0;
  border-bottom:1px solid #edf1f5;
  color:#334155;
  font-size:12px;
}

.lcAccountFeature span:last-child{
  color:#4E79BD;
  font-weight:600;
}

/* PREMIUM */

.lcAccountPremiumBox{
  margin:4px 30px 20px;
  padding:19px;
  border:1px solid #dce3ec;
  border-radius:0;
  background:#fafbfd;
}

.lcAccountPremiumBox[hidden]{
  display:none !important;
}

.lcAccountPremiumHeading{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:12px;
  color:#1e293b;
  font-size:14px;
}

#lcAccountPremiumPrice{
  font-family:"Times New Roman",serif;
  font-size:24px;
  font-weight:400;
}

.lcAccountPremiumBox p{
  margin:13px 0 18px;
  color:#64748b;
  font-size:12px;
  line-height:1.6;
}

.lcAccountLogout{
  display:block;
  margin:0 auto 20px;
}

/* FOCUS ACCESSIBILITY */

.lcAccountModal button:focus-visible{
  outline:2px solid #4E79BD;
  outline-offset:3px;
}

/* MOBILE */

@media(max-width:520px){

  .lcAccountOverlay{
    padding:12px;
    align-items:center;
  }

  .lcAccountModal{
    max-height:calc(100dvh - 24px);
  }

  .lcAccountHeader{
    padding:22px 20px 19px;
  }

  .lcAccountHeader h2{
    font-size:23px;
  }

  .lcAccountTabs{
    margin:18px 20px 0;
  }

  .lcAccountForm{
    padding:20px;
    gap:15px;
  }

  .lcAccountBenefits{
    padding:19px 20px 22px;
  }

  .lcAccountMemberInfo{
    padding:22px 20px 18px;
  }

  .lcAccountFeatures{
    padding:0 20px 18px;
  }

  .lcAccountPremiumBox{
    margin:4px 20px 18px;
    padding:16px;
  }

}





/* =====================================================
   ACCOUNT & MEMBERSHIP — READ ONLY
===================================================== */

#accountPreferencesPanel .lcAccountGrid{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:18px;
  align-items:stretch;
}

#accountPreferencesPanel .lcAccountCard{
  display:flex;
  flex-direction:column;
  min-width:0;
  border-radius:0;
}

#accountPreferencesPanel .lcAccountCardFooter{
  margin-top:auto;
  padding-top:22px;
}

#accountPreferencesPanel .lcAccountCardFooter small{
  display:block;
  padding-top:12px;
  border-top:1px solid #dbe3ef;
  color:#64748b;
  font-size:12px;
  line-height:1.6;
}

#accountPreferencesPanel .lcAccountPill{
  white-space:nowrap;
}

#accountPreferencesPanel .lcCloudPrice{
  display:flex;
  align-items:baseline;
  gap:10px;
}

/* Premium members no longer need the purchase price */

#accountPreferencesPanel[data-plan="premium"] .lcCloudPrice{
  display:none;
}

/* MOBILE */

@media(max-width:700px){

  #accountPreferencesPanel .lcAccountGrid{
    grid-template-columns:1fr;
    gap:14px;
  }

}






/* ACCOUNT MEMBERSHIP STATUS PILLS */

#accountPreferencesPanel .lcAccountPill{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  padding:4px 10px;
  border:1px solid #d4dfef;
  background:#edf3fc;
  color:#4e79bd;
  font-size:11px;
  font-weight:700;
  white-space:nowrap;
  border-radius:0;
}

#accountPreferencesPanel[data-plan="premium"]
#accountSaveStatus{
  background:#edf7f0;
  border-color:#b9ddc5;
  color:#287447;
}


/* =====================================================
   05 · SAVE & STORAGE
===================================================== */

#accountStoragePanel{
  width:100%;
}

/* TWO-COLUMN LAYOUT */

#accountStoragePanel .lcAccountGrid{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:18px;
  align-items:stretch;
}

/* CARDS */

#accountStoragePanel .lcAccountCard{
  display:flex;
  flex-direction:column;
  min-width:0;
  padding:24px;
  background:#f7f9fc;
  border:1px solid #d8e1ee;
  border-top:3px solid #cbd5e1;
  border-radius:0;
}

#accountStoragePanel .lcStorageSave{
  border-top-color:#4E79BD;
}

#accountStoragePanel .lcStorageRestore{
  border-top-color:#94a3b8;
}

/* HEADERS */

#accountStoragePanel .lcAccountCardTop{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
  margin-bottom:20px;
}

#accountStoragePanel .lcAccountEyebrow{
  font-size:11px;
  font-weight:700;
  letter-spacing:1px;
  color:#4E79BD;
}

#accountStoragePanel .lcAccountCard h3{
  margin:16px 0 12px;
  font-size:20px;
  line-height:1.3;
  color:#0f172a;
}

#accountStoragePanel .lcAccountDescription{
  font-size:13px;
  line-height:1.65;
  color:#526782;
}

/* STATUS PILLS */

#accountStoragePanel .lcAccountPill{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  padding:4px 10px;
  border:1px solid #d4dfef;
  background:#edf3fc;
  color:#4E79BD;
  font-size:11px;
  font-weight:700;
  white-space:nowrap;
  border-radius:0;
}

#accountStoragePanel .lcAccountPillMuted{
  background:#f1f5f9;
  border-color:#d8e1eb;
  color:#64748b;
}

/* FEATURES */

#accountStoragePanel .lcAccountFeatures{
  margin-top:16px;
  padding-top:14px;
  border-top:1px solid #dbe3ef;
}

#accountStoragePanel .lcAccountFeatures > div{
  display:flex;
  align-items:flex-start;
  gap:10px;
  margin-bottom:12px;
  font-size:13px;
  line-height:1.5;
}

#accountStoragePanel .lcAccountFeatures > div > span:first-child{
  color:#4E79BD;
  font-weight:700;
}

/* FOOTER — BUTTONS ALIGNED */

#accountStoragePanel .lcAccountCardFooter{
  margin-top:auto;
  padding-top:28px;
}

#accountStoragePanel .lcAccountButton{
  display:block;
  width:100%;
  min-height:44px;
  padding:12px 16px;
  border-radius:0;
  font-size:13px;
  font-weight:700;
  cursor:pointer;
}

#accountStoragePanel .lcAccountButtonPrimary{
  background:#4E79BD;
  border:1px solid #4E79BD;
  color:#fff;
}

#accountStoragePanel .lcAccountButtonSecondary{
  background:#fff;
  border:1px solid #4E79BD;
  color:#4E79BD;
}

#accountStoragePanel .lcAccountButton:disabled{
  background:#f1f5f9;
  border-color:#d8e1eb;
  color:#94a3b8;
  cursor:not-allowed;
  opacity:1;
}

#accountStoragePanel .lcAccountCardFooter small{
  display:block;
  margin-top:12px;
  font-size:12px;
  line-height:1.5;
  color:#64748b;
}

/* MOBILE */

@media(max-width:700px){

  #accountStoragePanel .lcAccountGrid{
    grid-template-columns:1fr;
    gap:14px;
  }

  #accountStoragePanel .lcAccountCard{
    padding:20px;
  }

  #accountStoragePanel .lcAccountCard h3{
    font-size:18px;
  }

}


/* NEPTOON PREMIUM CONFIRMATION */

.lcPaymentSuccessOverlay[hidden]{display:none!important;}

.lcPaymentSuccessOverlay{
  position:fixed;
  inset:0;
  z-index:99999;
  background:rgba(17,32,56,.58);
  display:flex;
  align-items:center;
  justify-content:center;
  padding:20px;
}

.lcPaymentSuccessModal{
  position:relative;
  width:min(100%,560px);
  max-height:90vh;
  overflow-y:auto;
  box-sizing:border-box;
  background:#fff;
  border:2px solid #4E79BD;
  border-radius:0;
  padding:36px;
  box-shadow:0 18px 55px rgba(0,0,0,.16);
  color:#102344;
}

.lcPaymentSuccessKicker{
  font:600 10px Arial,sans-serif;
  letter-spacing:1.5px;
  color:#4E79BD;
  margin-bottom:24px;
}

.lcPaymentSuccessModal h2{
  font:normal 30px "Times New Roman",serif;
  margin:0 0 14px;
  color:#102344;
}

.lcPaymentSuccessModal p{
  font:14px/1.65 Arial,sans-serif;
  color:#53647d;
  margin:0 0 24px;
}

.lcPaymentSuccessClose{
  position:absolute;
  right:18px;
  top:18px;
  background:#f1f5fa;
  border:0;
  border-radius:0;
  width:30px;
  height:30px;
  font-size:22px;
  cursor:pointer;
  color:#53647d;
}

.lcPaymentSuccessBenefits{
  border-top:1px solid #dce4ef;
  margin-bottom:24px;
}

.lcPaymentSuccessBenefit{
  display:grid;
  grid-template-columns:32px 1fr 20px;
  align-items:center;
  gap:16px;
  padding:17px 0;
  border-bottom:1px solid #dce4ef;
}

.lcPaymentSuccessIcon{
  color:#4E79BD;
  font-size:25px;
  text-align:center;
}

.lcPaymentSuccessBenefit strong{
  display:block;
  font:normal 19px "Times New Roman",serif;
  color:#102344;
  margin-bottom:5px;
}

.lcPaymentSuccessBenefit small{
  display:block;
  font:12px/1.5 Arial,sans-serif;
  color:#53647d;
}

.lcPaymentSuccessCheck{
  color:#2762bc;
  font-size:21px;
}

.lcPaymentSuccessContinue{
  width:100%;
  padding:15px;
  background:#4E79BD;
  color:white;
  border:1px solid #4E79BD;
  border-radius:0;
  font:600 13px Arial,sans-serif;
  cursor:pointer;
}

.lcPaymentSuccessContinue:hover{
  background:#3866a8;
}

@media(max-width:600px){
  .lcPaymentSuccessModal{padding:26px 20px;}
  .lcPaymentSuccessModal h2{font-size:25px;}
  .lcPaymentSuccessBenefit{gap:10px;}
}

#lcPaymentSuccessOverlay [data-ui-lang][hidden]{
  display:none!important;
}

/* =====================================================
   NEPTOON LIFE CYCLE · WELCOME JOURNEY
===================================================== */

.lifeWelcomeJourney{
  padding:24px 0 30px;
  border-bottom:1px solid #dce5f0;
  margin-bottom:26px;
}

.lifeWelcomeJourney h2{
  font:normal 27px "Times New Roman",serif;
  color:#102344;
  margin:7px 0 8px;
}

.lifeWelcomeJourneyIntro{
  font:13px/1.6 Arial,sans-serif;
  color:#53647d;
  margin:0 0 22px;
}

/* PORTRAITS */

.lifeStageGrid{
  display:grid;
  grid-template-columns:repeat(4,minmax(0,1fr));
  gap:12px;
}

.lifeStageCard{
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:5px;
  background:transparent;
  border:0;
  border-radius:0;
  padding:0;
  color:#102344;
  cursor:pointer;
  font-family:Arial,sans-serif;
}

.lifeStagePhoto{
  width:100%;
  aspect-ratio:1.3;
  display:flex;
  align-items:center;
  justify-content:center;
  background:#f0f3f8;
  border:2px solid transparent;
  box-sizing:border-box;
  overflow:hidden;
}

.lifeStagePhoto span{
  font-size:10px;
  color:#8492a7;
}

.lifeStageCard.active .lifeStagePhoto{
  border-color:#4E79BD;
}

.lifeStageCard strong{
  font-size:12px;
  margin-top:8px;
}

.lifeStageCard > span{
  font-size:11px;
  color:#53647d;
}

/* TIMELINE */

.lifeStageTimeline{
  position:relative;
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin:20px 12.5% 24px;
  height:22px;
}

.lifeStageTimelineLine{
  position:absolute;
  left:0;
  right:0;
  top:50%;
  height:3px;
  background:#4E79BD;
  transform:translateY(-50%);
}

.lifeStageTimelineDot{
  position:relative;
  z-index:1;
  width:13px;
  height:13px;
  border:3px solid #4E79BD;
  border-radius:50%;
  background:white;
}

.lifeStageTimelineDot.active{
  background:#4E79BD;
}

/* NARRATIVE */

.lifeStageNarrative{
  padding:22px 0 24px;
}

.lifeStageNarrativeMeta{
  display:flex;
  justify-content:space-between;
  gap:12px;
  font:600 10px Arial,sans-serif;
  color:#4E79BD;
  letter-spacing:.4px;
}

.lifeStageNarrative h3{
  font:normal 23px "Times New Roman",serif;
  color:#102344;
  margin:17px 0 12px;
}

.lifeStageNarrative p{
  font:13px/1.65 Arial,sans-serif;
  color:#344861;
  margin:0 0 18px;
}

.lifeStageNarrativeFooter{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:15px;
}

#lifeStageKeywords{
  font:10px Arial,sans-serif;
  color:#64748b;
}

#lifeStageNextButton{
  background:#4E79BD;
  border:1px solid #4E79BD;
  border-radius:0;
  padding:13px 17px;
  color:white;
  font:600 12px Arial,sans-serif;
  cursor:pointer;
}

#lifeStageNextButton:hover{
  background:#3866a8;
}

/* BRIDGE */

.lifeWelcomeJourneyBridge{
  display:flex;
  align-items:center;
  justify-content:center;
  gap:12px;
  padding:18px 0 0;
  font:12px Arial,sans-serif;
  color:#64748b;
}

.lifeWelcomeBridgeArrow{
  color:#4E79BD;
  font-size:22px;
}

/* AGE INPUTS */

#lifeWelcomeStartFields{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:15px;
  width:100%;
  margin-top:22px;
}

/* MOBILE */

@media(max-width:650px){

  .lifeStageGrid{
    grid-template-columns:repeat(2,minmax(0,1fr));
    gap:18px 12px;
  }

  .lifeStageTimeline{
    display:none;
  }

  .lifeStageNarrativeFooter{
    flex-direction:column;
    align-items:stretch;
  }

  #lifeStageNextButton{
    width:100%;
  }

  .lifeWelcomeJourney h2{
    font-size:24px;
  }

  #lifeWelcomeStartFields{
    grid-template-columns:repeat(2,minmax(0,1fr));
    gap:10px;
  }

}


