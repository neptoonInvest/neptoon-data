function buildBalanceSheet(snapshot, state){

  const isFinalEstate =
    state === "finalEstate";

  /*
    =========================================
    TERMINAL ESTATE

    All assets liquidated and the
    Funding Portfolio settled.
    =========================================
  */

  if(isFinalEstate){

    const estate =
      number(snapshot.lifeCycleWealth);

    return {

      assets:estate > 0 ? [{
        key:"finalCash",
        icon:"wallet",
        label:da
          ? "Endelig kontantbeholdning"
          : "Final cash position",
        amount:estate,
        formattedAmount:money(estate)
      }] : [],

      liabilities:[],

      grossAssets:estate,
      mortgage:0,
      totalLiabilities:0,
      netWealth:estate,

      formattedGrossAssets:money(estate),
      formattedTotalLiabilities:money(0),
      formattedNetWealth:money(estate)

    };
  }

  /*
    =========================================
    ORDINARY ECONOMIC BALANCE SHEET

    All economic assets, including
    Public Pension Market Value.
    =========================================
  */

  const assets =
    assetDefinitions
      .map(def => ({
        key:def.key,
        icon:def.icon,
        label:def.label,
        amount:number(snapshot[def.field])
      }))
      .filter(item => item.amount > 0)
      .map(item => ({
        ...item,
        formattedAmount:money(item.amount)
      }));

  /*
    =========================================
    ORDINARY LIABILITIES

    Mortgage, bank loan and
    four deferred tax liabilities.
    =========================================
  */

  const liabilities =
    liabilityDefinitions
      .map(def => ({
        key:def.key,
        icon:def.icon,
        label:def.label,
        amount:Math.abs(
          number(snapshot[def.field])
        )
      }))
      .filter(item => item.amount > 0)
      .map(item => ({
        ...item,
        formattedAmount:money(item.amount)
      }));

  /*
    =========================================
    FUNDING PORTFOLIO

    Exists throughout the Life Cycle.

    BUILDING:
      Zero until consumption financing starts.

    USING:
      Accumulates consumption funding
      at the common USING return.

    Included as a liability whenever
    its balance is positive.
    =========================================
  */

  const funding =
    number(snapshot.fundingPortfolio);

  if(funding > 0){

    liabilities.push({
      key:"fundingPortfolio",
      icon:"wallet",
      label:da
        ? "Akkumuleret forbrugsfinansiering"
        : "Accumulated consumption funding",
      amount:funding,
      formattedAmount:money(funding)
    });

  }

  /*
    =========================================
    ECONOMIC BALANCE TOTALS

    Same component accounting as
    Excel Market Value Audit.
    =========================================
  */

  const grossAssets =
    assets.reduce(
      (sum,item) => sum + item.amount,
      0
    );

  const totalLiabilities =
    liabilities.reduce(
      (sum,item) => sum + item.amount,
      0
    );

  const netWealth =
    grossAssets - totalLiabilities;

  return {

    assets,
    liabilities,

    grossAssets,
    totalLiabilities,

    mortgage:Math.max(
      0,
      number(snapshot.mortgageDebtReal)
    ),

    netWealth,

    formattedGrossAssets:money(grossAssets),
    formattedTotalLiabilities:money(totalLiabilities),
    formattedNetWealth:money(netWealth)

  };

}

