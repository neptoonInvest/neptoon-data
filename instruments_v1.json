function renderLifeCycleAssessment(scenario){

  const lang = INIT.lang === "da" ? "da" : "en";
  const status = scenario?.expected?.status;

  const T = {
    da:{
      feasibleTitle:"Din livscyklus hænger økonomisk sammen",
      feasibleText:"Med dine valgte forudsætninger kan dine økonomiske ressourcer finansiere dit planlagte forbrug og din Legacy gennem livet.",
      infeasibleTitle:"Din livscyklus kræver en økonomisk tilpasning",
      infeasibleText:"Med dine valgte forudsætninger er der ikke tilstrækkelige økonomiske ressourcer til at finansiere dit ønskede forbrug og din Legacy. Overvej at øge opsparingen, reducere forbruget eller justere dine øvrige forudsætninger."
    },
    en:{
      feasibleTitle:"Your Life Cycle is financially feasible",
      feasibleText:"Under your selected assumptions, your financial resources can finance your planned consumption and Legacy throughout your lifetime.",
      infeasibleTitle:"Your Life Cycle requires financial adjustment",
      infeasibleText:"Under your selected assumptions, your financial resources are insufficient to finance your desired consumption and Legacy. Consider increasing savings, reducing consumption or adjusting your other assumptions."
    }
  }[lang];

  const root = byId("lifeCycleAssessment");
  if(!root) return;

  const title = byId("lifeCycleAssessmentTitle");
  const text = byId("lifeCycleAssessmentText");
  const icon = byId("lifeCycleAssessmentIcon");

  if(!status){
    root.hidden = true;
    return;
  }

  root.hidden = false;

  const feasible = status !== "notReached";

  root.classList.toggle("isFeasible",feasible);
  root.classList.toggle("isInfeasible",!feasible);

  icon.textContent = feasible ? "✓" : "!";
  title.textContent = feasible ? T.feasibleTitle : T.infeasibleTitle;
  text.textContent = feasible ? T.feasibleText : T.infeasibleText;
}
function bindAccountFinancialInputs(){

  const pairs = [

    ["accountWealthToday", "wealthToday"],

    ["accountMonthlySavings", "monthlySavings"]

  ];

  pairs.forEach(([accountId, engineId]) => {

    const accountInput = byId(accountId);
    const engineInput = byId(engineId);

    if(!accountInput || !engineInput) return;

    /*
      Initialize My Account from authoritative inputs
    */

    accountInput.value = engineInput.value;

    /*
      My Account -> Engine input
    */

    accountInput.addEventListener("input", () => {

      engineInput.value = accountInput.value;

      engineInput.dispatchEvent(
        new Event("input", { bubbles:true })
      );

    });

    /*
      Engine input -> My Account
    */

    engineInput.addEventListener("input", () => {

      accountInput.value = engineInput.value;

    });

  });

}

