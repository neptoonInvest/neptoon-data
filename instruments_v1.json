/* Event delegation avoids rebinding when baskets rerender. */

/* =====================================================
   20 · DELEGATED BUTTON EVENTS
===================================================== */

document.addEventListener('click', e => {

  const b = e.target.closest('button');

  if(!b) return;


  /* =========================
     NAVIGATION
  ========================= */

  if(b.dataset.tab){
    openTab(b.dataset.tab);
    return;
  }

  if(b.dataset.go){
    openTab(b.dataset.go);
    return;
  }

  if(b.dataset.send){
    sendToMyWealth(b.dataset.send);
    return;
  }


  /* =========================
     ASSETS · REMOVE
  ========================= */

  if(b.dataset.removeAsset !== undefined){

    APP.assets.splice(
      Number(b.dataset.removeAsset),
      1
    );

    renderAssets();
    return;
  }


  /* =========================
     ASSETS · ADD
  ========================= */

  if(b.dataset.addAsset !== undefined){

    if(APP.assets.length < 5){
      APP.assets.push(null);
    }

    renderAssets();
    return;
  }


  /* =========================
     ASSETS · LIVE SELECTION
  ========================= */

  if(b.dataset.chooseAsset !== undefined){

    const ticker =
      b.dataset.chooseAsset;

    const index =
      Number(b.dataset.index);

    const instrument =
      INSTRUMENT_STATE.all.find(
        x => x.tickerExchange === ticker
      );

    if(!instrument) return;

    if(
      !Number.isInteger(index) ||
      index < 0 ||
      index >= APP.assets.length
    ){
      return;
    }

    /*
      Prevent duplicate instruments
      in the five-asset basket.
    */

    const duplicate =
      APP.assets.some(
        (id, j) =>
          j !== index &&
          id === ticker
      );

    if(duplicate) return;

    APP.assets[index] = ticker;

    renderAssets();

    return;
  }


  /* =========================
     PORTFOLIOS · REMOVE
  ========================= */

  if(b.dataset.removePlan !== undefined){

    APP.planSlots.splice(
      Number(b.dataset.removePlan),
      1
    );

    APP.expandedPlan = -1;

    renderPortfolios();
    return;
  }


  /* =========================
     PORTFOLIOS · ADD
  ========================= */

  if(b.dataset.addPlan !== undefined){

    if(APP.planSlots.length < 5){

      APP.planSlots.push({
        risk: 3,
        modelNo: null
      });

    }

    renderPortfolios();
    return;
  }


  /* =========================
     PORTFOLIOS · EXPAND
  ========================= */

  if(b.dataset.expand !== undefined){

    const index =
      Number(b.dataset.expand);

    APP.expandedPlan =
      APP.expandedPlan === index
        ? -1
        : index;

    renderPortfolios();
    return;
  }


  /* =========================
     PORTFOLIOS · COLLAPSE
  ========================= */

  if(b.hasAttribute('data-collapse')){

    APP.expandedPlan = -1;

    renderPlanDetails();
    return;
  }


  /* =========================
     MYWEALTH · SELECT
  ========================= */

  if(b.dataset.selectMywealth !== undefined){

    APP.myWealth.selectedIndex =
      Number(b.dataset.selectMywealth);

    renderMyWealth();

    paintEmptyCanvas('wealth-canvas');

    return;
  }

});
