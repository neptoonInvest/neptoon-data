},



/* H — PUBLIC PENSION */
{
  id: "publicPension",
  letter: "H",
  title: "Public Pension",
  items: [
    {
      q: "Can I include my expected public pension?",
      a: "Yes. Enter your expected monthly public pension and the age at which payments begin. For many households, public pension is an important source of income during the later years of life, even when private savings are limited."
    },
    {
      q: "What amount should I enter?",
      a: "Enter your expected monthly public pension after tax, expressed in today's purchasing power. You can use an estimate based on your country's pension system or your personal pension forecast."
    },
    {
      q: "How does public pension help finance my consumption?",
      a: "Once pension payments begin, they provide additional financial resources that can support your monthly consumption. This reduces the amount of wealth that must be financed from your investments."
    },
    {
      q: "Does my public pension count before I start receiving it?",
      a: "Yes. Neptoon includes the estimated economic value of future pension payments in your household wealth before they begin. This is a calculated value of future income, not money you can withdraw today."
    },
    {
      q: "Does Neptoon assume my public pension increases over time?",
      a: "Yes. The model assumes annual nominal pension growth equal to inflation plus 0.5 percentage points. This means public pension payments increase slightly in real purchasing power over time."
    },
    {
      q: "What happens when my public pension payments end?",
      a: "Neptoon includes public pension payments throughout the remaining modeled lifetime. At the end of life, no further payments are assumed, and the remaining economic value of future public pension becomes zero."
    }
  ]
},




/* I — OTHER FUTURE VALUES */
{
  id: "futureValues",
  letter: "I",
  title: "Other Future Values",
  items: [
    {
      q: "Can I include an expected inheritance?",
      a: "Yes. Enter the expected amount and the age at which you expect to receive it. Neptoon includes its estimated economic value in your Life Cycle before the inheritance is received."
    },
    {
      q: "What other future amounts can I include?",
      a: "You can include another expected lump-sum financial amount, such as a future gift, compensation payment or other identifiable financial resource. Enter the expected amount and when it will become available."
    },
    {
      q: "Why can't I enter all my personal possessions?",
      a: "Neptoon is a financial Life Cycle model, not an inventory of household belongings. Everyday possessions such as furniture, televisions, phones, clothing and ordinary jewelry are assumed to be used or consumed during your lifetime. Their resale values are therefore excluded from your financial wealth plan."
    },
    {
      q: "What if I own something valuable that I expect to sell?",
      a: "If you expect a significant future payment from selling a valuable personal asset, you can include the expected net proceeds under Other Future Values. Ordinary household possessions that you do not plan to sell are not included."
    },
    {
      q: "What happens when I receive a future amount?",
      a: "The amount becomes available in your Free Portfolio at the selected age. Neptoon already recognizes its estimated economic value before receipt, so receiving the payment converts future wealth into available investment capital rather than creating additional economic wealth at that moment."
    }
  ]
},




