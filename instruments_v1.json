  /* Mortgage, bank loan and pension toggles */

.mortgageToggle{
  display:inline-flex;
  align-items:center;
  justify-content:flex-end;
  flex-wrap:nowrap;
  gap:8px;
  white-space:nowrap;
  flex-shrink:0;
  cursor:pointer;
}

.mortgageToggle input[type="checkbox"]{
  width:15px;
  height:15px;
  margin:0;
  flex:0 0 15px;
  accent-color:#4E79BD;
  cursor:pointer;
}

.mortgageToggle span{
  white-space:nowrap;
  flex-shrink:0;
}
  
  .mortgageHead{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:24px;
}

.mortgageHead > div:first-child{
  flex:1 1 auto;
  min-width:0;
}
  
/* =========================================
