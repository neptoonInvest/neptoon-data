/* =====================================================
   WEALTHPLANS · DRAW HISTORY CHART
===================================================== */

function drawPlanHistoryChart(series){

  const canvas =
    document.getElementById("planHistoryCanvas");

  if(!canvas) return;

  const container = canvas.parentElement;

  const width = container.clientWidth;
  const height = container.clientHeight;

  if(width < 50 || height < 50) return;

  const dpr = window.devicePixelRatio || 1;

  canvas.width = Math.round(width * dpr);
  canvas.height = Math.round(height * dpr);

  const ctx = canvas.getContext("2d");

  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  ctx.clearRect(0, 0, width, height);

  if(!series.length){

    ctx.fillStyle = "#64748b";
    ctx.font = "13px Arial";
    ctx.textAlign = "center";

    ctx.fillText(
      "Select Wealth Plans to view historical performance",
      width / 2,
      height / 2
    );

    return;

  }

  const mobile = width < 500;

  const pad = {
    top: 18,
    right: 15,
    bottom: 38,
    left: mobile ? 43 : 58
  };

  const plotW = width - pad.left - pad.right;
  const plotH = height - pad.top - pad.bottom;

  const allPoints =
    series.flatMap(s => s.points);

  const values =
    allPoints.map(p => p.value);

  const dataMin =
    Math.min(100, ...values);

  const dataMax =
    Math.max(100, ...values);

  const range =
    Math.max(dataMax - dataMin, 10);

  const step =
    assetHistoryNiceStep(range / 5);

  const yMin =
    Math.floor(
      Math.max(0, dataMin - range * .05) / step
    ) * step;

  const yMax =
    Math.ceil(
      (dataMax + range * .05) / step
    ) * step;

  const minDate =
    Math.min(
      ...allPoints.map(p => Date.parse(p.date))
    );

  const maxDate =
    Math.max(
      ...allPoints.map(p => Date.parse(p.date))
    );

  const x = date =>
    pad.left +
    (Date.parse(date) - minDate) /
    Math.max(1, maxDate - minDate) * plotW;

  const y = value =>
    pad.top +
    (yMax - value) /
    Math.max(1, yMax - yMin) * plotH;


  /* ================================================
     GRID + Y AXIS
  ================================================ */

  ctx.font =
    mobile ? "10px Arial" : "11px Arial";

  ctx.textAlign = "right";
  ctx.textBaseline = "middle";

  for(
    let tick = yMin;
    tick <= yMax + step * .001;
    tick += step
  ){

    const yy = y(tick);

    ctx.beginPath();
    ctx.moveTo(pad.left, yy);
    ctx.lineTo(width - pad.right, yy);

    ctx.strokeStyle = "#dce3ee";
    ctx.lineWidth = 1;
    ctx.stroke();

    ctx.fillStyle = "#475569";

    ctx.fillText(
      Math.round(tick).toLocaleString("en-US"),
      pad.left - 7,
      yy
    );

  }


  /* ================================================
     X AXIS DATE LABELS
  ================================================ */

  const ticks = mobile ? 4 : 7;

  ctx.textAlign = "center";
  ctx.textBaseline = "top";
  ctx.fillStyle = "#475569";

  for(let i = 0; i <= ticks; i++){

    const ratio = i / ticks;

    const timestamp =
      minDate + ratio * (maxDate - minDate);

    const date = new Date(timestamp);

    const label =
      PLAN_HISTORY_VIEW.period === "1Y"
        ? date.toLocaleDateString("en-US", {
            month: "short",
            year: "2-digit",
            timeZone: "UTC"
          })
        : String(date.getUTCFullYear());

    const xx =
      pad.left + ratio * plotW;

    ctx.fillText(
      label,
      xx,
      height - pad.bottom + 12
    );

  }


  /* ================================================
     HISTORICAL SERIES
  ================================================ */

  series.forEach(s => {

    const highlighted =
      PLAN_HISTORY_VIEW.highlighted;

    const muted =
      highlighted &&
      highlighted !== s.ticker;

    ctx.beginPath();

    s.points.forEach((p, i) => {

      const xx = x(p.date);
      const yy = y(p.value);

      if(i === 0){
        ctx.moveTo(xx, yy);
      }else{
        ctx.lineTo(xx, yy);
      }

    });

    ctx.strokeStyle = s.color;
    ctx.lineWidth = muted ? 1.2 : 2.3;
    ctx.globalAlpha = muted ? .18 : 1;
    ctx.lineJoin = "round";
    ctx.lineCap = "round";
    ctx.stroke();
    ctx.globalAlpha = 1;

  });

}


