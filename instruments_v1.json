function initLifeBalanceStateSelector(lang){

  const da =
    String(lang || "en")
      .toLowerCase()
      .startsWith("da");

  const grid =
    document.getElementById(
      "lifeBalanceStateGrid"
    );

  if(!grid) return;

  /*
    =========================================
    LANGUAGE
    =========================================
  */

  grid.querySelectorAll(
    ".lifeBalanceStateTitle"
  ).forEach(el => {

    el.textContent =
      da
        ? el.dataset.labelDa
        : el.dataset.labelEn;

  });

  grid.querySelectorAll(
    ".lifeBalanceStateSub"
  ).forEach(el => {

    el.textContent =
      da
        ? el.dataset.subDa
        : el.dataset.subEn;

  });

  const buttons = [
    ...grid.querySelectorAll(
      ".lifeBalanceStateBtn"
    )
  ];

  /*
    =========================================
    PAINT ACTIVE STATE
    =========================================
  */

  const paint = () => {

    buttons.forEach(btn => {

      const active =
        btn.dataset.balanceState ===
        activeLifeBalanceState;

      btn.classList.toggle(
        "is-active",
        active
      );

      btn.setAttribute(
        "aria-pressed",
        String(active)
      );

    });

  };

  /*
    =========================================
    BIND CLICK HANDLER ONCE
    =========================================
  */

  if(!grid.dataset.bound){

    grid.dataset.bound = "true";

    grid.addEventListener("click", event => {

      const btn =
        event.target.closest(
          ".lifeBalanceStateBtn"
        );

      if(
        !btn ||
        !grid.contains(btn)
      ){
        return;
      }

      /*
        Activate selected standard state.
      */

      activeLifeBalanceState =
        btn.dataset.balanceState;

      /*
        IMPORTANT:

        Clear monthly age override.

        The four standard states now
        regain control of the renderer.
      */

      window.activeLifeBalanceAgeIndex =
        null;

      /*
        Repaint active button.
      */

      paint();

      /*
        Repaint economic Balance Sheet.

        No simulation rerun.
      */

      if(window.currentFreedomDayInformation){

        renderFreedomDayInformation(
          window.currentFreedomDayInformation
        );

      }

    });

  }

  /*
    Initial paint.
  */

  paint();

}


