    function bindTaxOptions(){

  document
    .querySelectorAll(
      'input[name="taxRate"]'
    )
    .forEach(
      input => {

        input.addEventListener(
          "change",
          () => {

            if(!input.checked){
              return;
            }


            const taxRate =
              Number(
                input.value
              );


            if(
              !Number.isFinite(taxRate)
            ){
              return;
            }


            STATE.taxRate =
              clamp(
                taxRate,
                0,
                1
              );


            render();

          }
        );

      }
    );

}
    
function setNumericInput(
  id,
  value
){
  const el = byId(id);

  if(!el){
    return;
  }

  el.value =
    String(value);
}





function guardMoneyInput(id){

  const el = byId(id);

  if(!el) return false;

  const raw = String(el.value ?? "").trim();

  /*
    Empty fields are allowed.
  */
  if(raw === "") return false;

  const value = numberValue(raw);

  /*
    Reject negative or invalid amounts.
    Explicit minus check protects against
    parsers that remove the minus sign.
  */
  if(
    raw.startsWith("-") ||
    !Number.isFinite(value) ||
    value < 0
  ){

    el.value = "0";

    return true;

  }

  return false;

}

