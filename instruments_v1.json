const WELCOME_PREVIEW_CONFIG = {
  tickers: [
    "NVDA.US",
    "EUNL.XETRA"
  ],
  capital: 100000,
  horizon: 10
};


function renderWelcome(){

  const host =
    document.getElementById("welcome-preview");

  if(!host) return;

  const {
    tickers,
    capital,
    horizon
  } = WELCOME_PREVIEW_CONFIG;

  const instruments =
    INSTRUMENT_STATE.all || [];

  const locale =
    APP.lang === "da"
      ? "da-DK"
      : "en-US";

  const fmt = value =>
    new Intl.NumberFormat(locale, {
      maximumFractionDigits: 0
    }).format(value);

  const labels =
    APP.lang === "da"
      ? {
          invested: "investeret",
          years: "år",
          expected: "FORVENTET FORMUE",
          range: "10-årigt udfaldsinterval",
          median: "Median",
          missing: "Data ikke tilgængelige"
        }
      : {
          invested: "invested",
          years: "years",
          expected: "EXPECTED WEALTH",
          range: "10-year outcome range",
          median: "Median",
          missing: "Data unavailable"
        };


  host.innerHTML = tickers.map(ticker => {

    const instrument =
      instruments.find(
        x => x.tickerExchange === ticker
      );

    if(!instrument){

      return `
        <article class="welcome-investment-card">
          <strong>${esc(ticker)}</strong>
          <div class="small">${labels.missing}</div>
        </article>
      `;

    }

    const expRet =
      Number(instrument.expRetNet);

    const risk =
      Number(instrument.risk);

    if(
      !Number.isFinite(expRet) ||
      !Number.isFinite(risk) ||
      risk < 0
    ){

      return `
        <article class="welcome-investment-card">
          <strong>${esc(instrument.name)}</strong>
          <div class="small">${labels.missing}</div>
        </article>
      `;

    }

    const result = calcWealthGBM({
      W0: capital,
      savingsMonthly: 0,
      horizon,
      expRet,
      risk
    });

    const {
      expectedWealth,
      medianWealth,
      q10,
      q90
    } = result;

    if(
      ![
        expectedWealth,
        medianWealth,
        q10,
        q90
      ].every(Number.isFinite)
    ){
      return `
        <article class="welcome-investment-card">
          <strong>${esc(instrument.name)}</strong>
          <div class="small">${labels.missing}</div>
        </article>
      `;
    }

    /*
      Position expected wealth within
      the P10–P90 range.

      Logarithmic scaling is more
      appropriate for wealth distributions.
    */

    const log10 = Math.log(Math.max(q10, 1));
    const log90 = Math.log(Math.max(q90, 1));

    const position =
      log90 > log10
        ? (
            Math.log(Math.max(expectedWealth, 1)) -
            log10
          ) / (log90 - log10)
        : 0.5;

    const width =
      Math.max(
        0,
        Math.min(100, position * 100)
      );

    return `

      <article class="welcome-investment-card">

        <div class="welcome-investment-name">
          ${esc(instrument.name)}
        </div>

        <div class="welcome-investment-sub">
          ${fmt(capital)} ${labels.invested}
          · ${horizon} ${labels.years}
        </div>

        <div class="welcome-investment-kicker">
          ${labels.expected}
        </div>

        <div class="welcome-investment-value">
          ${fmt(expectedWealth)}
        </div>

        <div class="welcome-range-head">

          <span>${labels.range}</span>
          <span>P10–P90</span>

        </div>

        <div class="welcome-range-track">
          <div
            class="welcome-range-fill"
            style="width:${width}%"
          ></div>
        </div>

        <div class="welcome-statistics">

          <div>
            <span>P10</span>
            <strong>${fmt(q10)}</strong>
          </div>

          <div>
            <span>${labels.median}</span>
            <strong>${fmt(medianWealth)}</strong>
          </div>

          <div>
            <span>P90</span>
            <strong>${fmt(q90)}</strong>
          </div>

        </div>

      </article>

    `;

  }).join("");

}

