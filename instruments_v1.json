    const enterprise =
      Number(row.privateEnterprise) || 0;

    const privatePension =
      Number(row.privatePension) || 0;

    const inheritance =
      Number(row.heritageShadow) || 0;

    const otherResources =
      Number(row.otherShadow) || 0;

const publicPension =
  Number(row.publicPensionShadow) || 0;

const supplementaryPension =
  Number(row.supplementaryPensionShadow) || 0;

    const mortgage =
      Number(row.mortgageDebtReal) || 0;

    const bankLoan =
      Number(row.bankLoanDebtReal) || 0;

    const funding =
      Number(row.fundingPortfolio) || 0;

const pensionFixedTaxLiability =
  Number(row.deferredPensionTaxLiability) || 0;

const pensionCapitalGainsTaxLiability =
  Number(row.deferredPrivatePensionCapitalGainsTaxLiability) || 0;

const houseTaxLiability =
  Number(row.deferredRealEstateTaxLiability) || 0;

const enterpriseTaxLiability =
  Number(row.deferredEnterpriseTaxLiability) || 0;

const totalDeferredTaxLiability =
  pensionFixedTaxLiability +
  pensionCapitalGainsTaxLiability +
  houseTaxLiability +
  enterpriseTaxLiability;


    /*
      GROSS MARKET VALUE OF RESOURCES
    */

    const grossMarketValue =
      freePortfolio +
      realEstate +
      enterprise +
      privatePension +
      inheritance +
otherResources +
publicPension +
supplementaryPension;

    /*
      NET EQUITY BEFORE CONSUMPTION FUNDING
    */

const netMarketValue =
  grossMarketValue -
  mortgage -
  bankLoan -
  totalDeferredTaxLiability;

    /*
      RESIDUAL EQUITY AFTER CONSUMPTION
    */

    const residualEquity =
      netMarketValue -
      funding;


    /*
      RECONCILIATION AGAINST CANONICAL MOUNTAIN
    */

    const canonicalWealth =
      Number(row.lifeCycleWealth) || 0;

    const reconciliationError =
      residualEquity -
      canonicalWealth;


    return {

      Month:
        row.month,

      Age:
        row.age,

      Phase:
        row.phase,

      /*
        ASSETS
      */

      "MV Free Portfolio":
        freePortfolio,

      "MV Real Estate":
        realEstate,

