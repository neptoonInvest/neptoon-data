========================================= */

.optionalComponent[data-panel="other"] .otherAssetRow{
  display:grid;
  grid-template-columns:
    minmax(240px, 2.2fr)
    repeat(4, minmax(0, 1fr));
  gap:12px;
  align-items:start;
}

.optionalComponent[data-panel="other"] .otherAssetRow > .componentIdentity{
  grid-column:1;
  grid-row:1;
}

.optionalComponent[data-panel="other"] .otherAssetRow > .miniField{
  grid-column:auto;
  grid-row:1;
}

.optionalComponent[data-panel="other"] .otherAssetRow > .miniField input{
  width:100%;
