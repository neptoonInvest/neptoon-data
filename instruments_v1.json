function bindInputs(){




  let renderTimer = null;

  const RENDER_DELAY = 400;

  function scheduleRender(){

    clearTimeout(renderTimer);

    renderTimer = setTimeout(() => {

      renderTimer = null;

      render();
      blinkAccountUpdate();

    }, RENDER_DELAY);

  }

  function renderImmediately(){

    clearTimeout(renderTimer);
    renderTimer = null;

    render();
    blinkAccountUpdate();

  }

  /*
    INPUT EVENTS
  */

  document.addEventListener("input", event => {

    const input = event.target;

    if(!input.matches("input, select")){
      return;
    }

    /*
      SLIDERS: IMMEDIATE
    */

    if(input.matches('input[type="range"]')){

      renderImmediately();
      return;

    }

    /*
      OTHER INPUTS: DEBOUNCED
    */

    scheduleRender();

  });

  /*
    CHANGE EVENTS
  */

/*
  CHANGE EVENTS
*/

document.addEventListener("change", event => {

  const input = event.target;

  if(!input.matches("input, select")){
    return;
  }

  /*
    PAINT INPUT EXPLANATION
  */

  if(input.id){
    paintScenarioExplanation(input.id);
  }

  if(input.classList.contains("money")){
    formatMoneyInput(input);
  }

  /*
    SLIDERS: ALREADY UPDATED
    THROUGH INPUT EVENT
  */

  if(input.matches('input[type="range"]')){
    return;
  }

  scheduleRender();

});

  /*
    INITIAL MONEY FORMATTING
  */

  document
    .querySelectorAll(".money")
    .forEach(formatMoneyInput);

}
