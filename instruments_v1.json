async function submitLifeCycleAccount(event){

  event.preventDefault();

  const email =
    document.getElementById("lcAccountEmail")
      ?.value.trim().toLowerCase();

  const password =
    document.getElementById("lcAccountPassword")?.value;

  const button =
    document.getElementById("lcAccountSubmit");

  const message =
    document.getElementById("lcAccountAuthMessage");

  const da = INIT.lang === "da";

  if(!email || !password) return;

  button.disabled = true;
  message.textContent = "";

  try{

    if(lcAccountMode === "signup"){

  const {data,error} =
  await supabaseClient.auth.signUp({
    email,
    password,
    options:{
      emailRedirectTo:
        "https://webapps.neptoonwealth.com/lifecycle/"
    }
  });

      if(error) throw error;

      if(!data.session){

        message.textContent = da
          ? "Kontrollér din e-mail for at bekræfte din konto."
          : "Check your email to confirm your account.";

        return;

      }

    }else{

      const {error} =
        await supabaseClient.auth.signInWithPassword({
          email,
          password
        });

      if(error) throw error;

    }

    /*
      AUTHENTICATED USER
    */

    const {data,error} =
      await supabaseClient.auth.getUser();

    if(error) throw error;

    ACCOUNT.user = data.user;
    ACCOUNT.plan = data.user ? "free" : "visitor";
    ACCOUNT.email = data.user?.email || "";

    paintAppAccountStatus();
    renderAccountMembership();

    openLifeCycleLogin();

  }catch(error){

    console.error("ACCOUNT AUTH ERROR",error);

    message.textContent =
      error.message || (
        da
          ? "Login mislykkedes. Prøv igen."
          : "Authentication failed. Please try again."
      );

  }finally{

    button.disabled = false;

  }

}


    
