function numberValue(id){
  const el = byId(id);
  if(!el) return 0;

  const raw = String(el.value ?? "").trim();
  if(raw === "") return 0;

  const n = Number(raw);
  return Number.isFinite(n) ? n : 0;
}

function optionalNumberValue(id){
  const el = byId(id);
  if(!el) return null;

  const raw = String(el.value ?? "").trim();
  if(raw === "") return null;

  const n = Number(raw);
  return Number.isFinite(n) ? n : null;
}

function percentValue(id){
  return numberValue(id) / 100;
}

function moneyValue(id){
  const raw =
    String(byId(id)?.value || "")
      .replace(/\./g,"")
      .replace(/,/g,"")
      .replace(/[^\d-]/g,"");

  const n = Number(raw);
  return Number.isFinite(n) ? n : 0;
}

function getTaxRate(){
  const selected =
    document.querySelector(
      'input[name="taxRate"]:checked'
    );

  return selected
    ? Number(selected.value)
    : 0.35;
}



function nominalToRealAfterTax(
  nominalReturn,
  taxRate,
  inflation
){
  return (
    (1 + (1-taxRate)*nominalReturn) /
    (1+inflation)
  ) - 1;
}

function annualToMonthly(rate){
  const safe =
    Math.max(
      -0.9999,
      Number(rate) || 0
    );

  return Math.pow(1+safe,1/12)-1;
}

function formatMoneyInput(el){
  const raw =
    String(el.value || "")
      .replace(/\./g,"")
      .replace(/,/g,"")
      .replace(/[^\d-]/g,"");

  if(raw === "" || raw === "-"){
    el.value = "";
    return;
  }

  const n = Number(raw);

  if(!Number.isFinite(n)){
    el.value = "";
    return;
  }

  el.value =
    Math.round(n)
      .toLocaleString("da-DK");
}

function formatMoney(value){
  const n = Number(value);

  if(!Number.isFinite(n)){
    return "—";
  }

  const abs = Math.abs(n);

  if(abs >= 1000000){
    return (
      (n/1000000)
        .toLocaleString(
          "en-GB",
          {
            minimumFractionDigits:1,
            maximumFractionDigits:2
          }
        )
      + "m"
    );
  }

  if(abs >= 1000){
    return (
      Math.round(n/1000)
        .toLocaleString("en-GB")
      + "k"
    );
  }

  return Math.round(n).toLocaleString("en-GB");
}

function formatAge(age){
  return Number.isFinite(age)
    ? age.toFixed(1)
    : "—";
}

function ageToMonth(inputs,age){
  return Math.round(
    (age-inputs.currentAge)*12
  );
}

function totalMonthsFor(inputs){
  return Math.round(
    (inputs.deathAge-inputs.currentAge)*12
  );
}

function restoreOptionalComponents(settings){

  Object.entries(settings.components || {}).forEach(
    ([key,enabled]) => {

      const el = document.querySelector(
        `[data-panel="${key}"]`
      );

      if(!el) return;

      el.hidden = !enabled;

    }
  );

}


