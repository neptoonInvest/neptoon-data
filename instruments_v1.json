function guardRealReturnInput(
  id
){

  const el =
    byId(id);

  if(!el){
    return;
  }


  /*
    Blank is allowed.
  */

  const raw =
    String(
      el.value ?? ""
    ).trim();

  if(raw === ""){
    return;
  }


  /*
    numberValue expects the
    element ID, not el.value.
  */

  let value =
    numberValue(id);


  if(
    !Number.isFinite(value)
  ){
    return;
  }


  /*
    Input is displayed as percentage:
      5 = 5%
     -5 = -5%
  */

  value =
    clamp(
      value,
      INPUT_BOUNDS.realReturn.min * 100,
      INPUT_BOUNDS.realReturn.max * 100
    );


  el.value =
    String(value);

}

function guardAssetAge(
  id,
  currentAge,
  deathAge
){

  const el =
    byId(id);

  if(!el){
    return;
  }


  /*
    Blank liquidation age is valid:
    model interprets it as liquidation at death.
  */

  if(
    el.value.trim() === ""
  ){
    return;
  }


let age =
  numberValue(id);


  if(
    !Number.isFinite(age)
  ){

    el.value = "";
    return;

  }


  age =
    clamp(
      age,
      currentAge,
      deathAge
    );


  el.value =
    String(age);

}


