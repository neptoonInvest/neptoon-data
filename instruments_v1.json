function showLifeCyclePaymentSuccess(){

  const params = new URLSearchParams(window.location.search);

  if(params.get("payment") !== "success") return;
  if(ACCOUNT.plan !== "premium") return;

  const overlay = document.getElementById("lcPaymentSuccessOverlay");

  if(!overlay){
    console.error("PAYMENT SUCCESS MODAL NOT FOUND");
    return;
  }

  const lang = INIT.lang === "da" ? "da" : "en";

  // Show only the selected language
  overlay.querySelectorAll("[data-ui-lang]").forEach(el => {
    el.hidden = el.dataset.uiLang !== lang;
  });

  const button = document.getElementById("lcPaymentSuccessContinue");

  if(button){
    button.textContent = lang === "da"
      ? "Fortsæt til Life Cycle"
      : "Continue to Life Cycle";
  }

  // Close modal
  const close = () => {
    overlay.hidden = true;
    document.body.style.overflow = "";
  };

  document.getElementById("lcPaymentSuccessClose").onclick = close;

  if(button) button.onclick = close;

  // Open modal
  overlay.hidden = false;
  document.body.style.overflow = "hidden";

  // Remove payment parameters
  const url = new URL(window.location.href);

  url.searchParams.delete("payment");
  url.searchParams.delete("session_id");

  window.history.replaceState(
    {},
    "",
    url.pathname + url.search + url.hash
  );

  button?.focus();

  console.log("NEPTOON PREMIUM CONFIRMATION DISPLAYED");

}


