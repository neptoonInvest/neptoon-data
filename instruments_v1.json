===================================================== */

function getMyWealthInvestments(){

  const {source, ids} = APP.myWealth;

  if(!Array.isArray(ids) || !ids.length){
    return [];
  }

  if(source === "assets"){

    return ids.map(id => {

      const p = (INSTRUMENT_STATE.all || [])
        .find(x =>
          String(x.tickerExchange).trim().toUpperCase() ===
          String(id).trim().toUpperCase()
        );

      if(!p) return null;

      return {
        id,
        name:p.name || id,
        expRetNet:Number(p.expRetNet),
        expRetGross:Number(p.expRetGross),
        costs:Number(p.costs || 0),
        risk:Number(p.risk)
      };

    }).filter(Boolean);

  }

  if(source === "portfolios"){

    return ids.map(id => {

      const p = (PORTFOLIO_STATE.all || [])
        .find(x =>
          String(x.modelNo) === String(id)
        );

      if(!p) return null;

      const m = p.objKeyFigures || {};

      return {
        id,
        name:p.modelLabel || `Model ${id}`,
        expRetNet:Number(m.expRetNet),
        expRetGross:Number(m.expRetGross),
        costs:Number(m.costs || 0),
        risk:Number(m.risk)
      };

    }).filter(Boolean);

  }

  return [];

}



/* =====================================================
   MYWEALTH · FUTURE VALUE
===================================================== */

function myWealthFV(w0, monthlySavings, annualReturn, years){

  if(!Number.isFinite(annualReturn) || annualReturn <= -1){
    return NaN;
  }

  const months = Math.round(years * 12);

  const monthlyReturn =
    Math.pow(1 + annualReturn, 1 / 12) - 1;

  const growth =
    Math.pow(1 + monthlyReturn, months);

  const savingsFV =
    Math.abs(monthlyReturn) < 1e-12
      ? monthlySavings * months
      : monthlySavings *
        (growth - 1) /
        monthlyReturn;

  return w0 * growth + savingsFV;

}

function calculateMyWealthRace(){

  return getMyWealthInvestments().map(p => {

    const net = myWealthFV(
      MYWEALTH_VIEW.w0,
      MYWEALTH_VIEW.monthlySavings,
      p.expRetNet,
      MYWEALTH_VIEW.horizon
    );

    const gross = myWealthFV(
      MYWEALTH_VIEW.w0,
      MYWEALTH_VIEW.monthlySavings,
      p.expRetGross,
      MYWEALTH_VIEW.horizon
    );

    return {
      ...p,
      net,
      gross,
      costImpact:Number.isFinite(gross) && Number.isFinite(net)
        ? Math.max(0, gross - net)
        : NaN
    };

  });

}


function getInstrumentHistory(tickerExchange){

  const ticker =
    String(tickerExchange || "")
      .trim()
      .toUpperCase();

  return (
    INSTRUMENT_HISTORY_STATE.byTicker.get(ticker)
