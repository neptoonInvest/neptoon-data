/* =====================================================
   NEPTOON · 5-ASSET HISTORY VIEWER
===================================================== */

const ASSET_HISTORY_COLORS = [
  "#124bc4",
  "#ff922b",
  "#16a064",
  "#8238cf",
  "#38bdf8"
];

const ASSET_HISTORY_VIEW = {
  period: "MAX",
  highlighted: null,
  initialized: false,
  resizeObserver: null
};


/* =====================================================
   HISTORY DATA PREPARATION
===================================================== */


/* =====================================================
   WEALTHPLANS · PREPARE HISTORY SERIES
===================================================== */

function preparePlanHistorySeries(){

  const periods = {
    "1Y": 12,
    "3Y": 36,
    "5Y": 60,
    "10Y": 120
  };

  /*
    Selected Wealth Plans.
    ModelNo = 0 is valid.
  */

  const selected = (APP.planSlots || [])
    .filter(slot =>
      slot &&
      slot.modelNo !== "" &&
      slot.modelNo !== null &&
      slot.modelNo !== undefined
    );

  const raw = selected.map((slot, i) => {

    const portfolio =
      PORTFOLIO_STATE.all.find(
        p => Number(p.modelNo) === Number(slot.modelNo)
      );

    if(!portfolio) return null;

    const history =
      (portfolio.arrayHistory || [])
        .filter(h =>
          h &&
          h.date &&
          Number.isFinite(Number(h.accPortIndex)) &&
          Number(h.accPortIndex) > 0
        )
        .map(h => ({
          date: String(h.date).slice(0, 10),
          value: Number(h.accPortIndex)
        }))
        .sort((a, b) =>
          a.date.localeCompare(b.date)
        );

    return {
      ticker: String(portfolio.modelNo),
      name: portfolio.modelLabel ||
            `Wealth Plan ${portfolio.modelNo}`,
      color: ASSET_HISTORY_COLORS[i % 5],
      history
    };

  }).filter(x => x && x.history.length >= 2);

  if(!raw.length) return [];

  /*
    Shared end date.
  */

  const endDate = raw.reduce(
    (latest, x) => {

      const last =
        x.history[x.history.length - 1].date;

      return latest === null || last < latest
        ? last
        : latest;

    },
    null
  );

  /*
    Requested period.
  */

  const end =
    new Date(endDate + "T00:00:00Z");

  let requestedStart = null;

  if(PLAN_HISTORY_VIEW.period !== "MAX"){

    const months =
      periods[PLAN_HISTORY_VIEW.period] || 120;

    const d = new Date(end);

    d.setUTCMonth(
      d.getUTCMonth() - months
    );

    requestedStart =
      d.toISOString().slice(0, 10);

  }

  /*
    Common starting date.
  */

  const commonStart = raw.reduce(
    (latest, x) => {

      const first = x.history[0].date;

      return latest === null || first > latest
        ? first
        : latest;

    },
    requestedStart
  );

  const startDate =
    requestedStart && requestedStart > commonStart
      ? requestedStart
      : commonStart;

  /*
    Normalize all portfolios to 100.
  */

  return raw.map(item => {

    const points = item.history.filter(
      h =>
        h.date >= startDate &&
        h.date <= endDate
    );

    if(points.length < 2) return null;

    const base = points[0].value;

    const normalized = points.map(h => ({
      date: h.date,
      value: 100 * h.value / base
    }));

    const first = normalized[0];
    const last =
      normalized[normalized.length - 1];

    const years =
      (new Date(last.date) - new Date(first.date)) /
      (365.25 * 86400000);

    const totalReturn =
      last.value / 100 - 1;

    const annualReturn =
      years > 0
        ? Math.pow(
            last.value / 100,
            1 / years
          ) - 1
        : null;

    return {
      ...item,
      points: normalized,
      totalReturn,
      annualReturn,
      firstDate: first.date,
      lastDate: last.date
    };

  }).filter(Boolean);

}


/* =====================================================
   NICE Y AXIS STEP
===================================================== */

function assetHistoryNiceStep(value){

  const exponent =
    Math.floor(Math.log10(Math.max(value, 1e-10)));

  const magnitude =
    Math.pow(10, exponent);

  const fraction =
    value / magnitude;

  const nice =
    fraction <= 1 ? 1 :
    fraction <= 2 ? 2 :
    fraction <= 5 ? 5 : 10;

  return nice * magnitude;

}


/* =====================================================
   DRAW CHART
===================================================== */

function drawAssetHistoryChart(series){

  const canvas =
    document.getElementById("assetHistoryCanvas");

  if(!canvas) return;

  const container = canvas.parentElement;

  const width = container.clientWidth;
  const height = container.clientHeight;

  if(width < 50 || height < 50) return;

  const dpr = window.devicePixelRatio || 1;

  canvas.width = Math.round(width * dpr);
  canvas.height = Math.round(height * dpr);

  const ctx = canvas.getContext("2d");

  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  ctx.clearRect(0, 0, width, height);

  if(!series.length){

    ctx.fillStyle = "#64748b";
    ctx.font = "13px Arial";
    ctx.textAlign = "center";

    ctx.fillText(
      "Select instruments to view historical performance",
      width / 2,
      height / 2
    );

    return;

  }

  const mobile = width < 500;

  const pad = {
    top: 18,
    right: 15,
    bottom: 38,
    left: mobile ? 43 : 58
  };

  const plotW = width - pad.left - pad.right;
  const plotH = height - pad.top - pad.bottom;

  const allPoints = series.flatMap(s => s.points);

  const values = allPoints.map(p => p.value);

  const dataMin = Math.min(100, ...values);
  const dataMax = Math.max(100, ...values);

  const range = Math.max(dataMax - dataMin, 10);

  const step = assetHistoryNiceStep(range / 5);

  const yMin =
    Math.floor(Math.max(0, dataMin - range * .05) / step)
    * step;

  const yMax =
    Math.ceil((dataMax + range * .05) / step)
    * step;

  const minDate = Math.min(
    ...allPoints.map(p => Date.parse(p.date))
  );

  const maxDate = Math.max(
    ...allPoints.map(p => Date.parse(p.date))
  );

  const x = date =>
    pad.left +
    (Date.parse(date) - minDate) /
    Math.max(1, maxDate - minDate) * plotW;

  const y = value =>
    pad.top +
    (yMax - value) /
    Math.max(1, yMax - yMin) * plotH;

  /*
    GRID + Y AXIS
  */

  ctx.font = mobile ? "10px Arial" : "11px Arial";
  ctx.textAlign = "right";
  ctx.textBaseline = "middle";

  for(let tick = yMin; tick <= yMax + step * .001; tick += step){

    const yy = y(tick);

    ctx.beginPath();
    ctx.moveTo(pad.left, yy);
    ctx.lineTo(width - pad.right, yy);
    ctx.strokeStyle = "#dce3ee";
    ctx.lineWidth = 1;
    ctx.stroke();

    ctx.fillStyle = "#475569";
    ctx.fillText(
      Math.round(tick).toLocaleString("en-US"),
      pad.left - 7,
      yy
    );

  }

  /*
    X AXIS DATE LABELS
  */

  const ticks = mobile ? 4 : 7;

  ctx.textAlign = "center";
  ctx.textBaseline = "top";
  ctx.fillStyle = "#475569";

  for(let i = 0; i <= ticks; i++){

    const ratio = i / ticks;

    const timestamp =
      minDate + ratio * (maxDate - minDate);

    const date = new Date(timestamp);

    const label =
      ASSET_HISTORY_VIEW.period === "1Y"
        ? date.toLocaleDateString("en-US", {
            month: "short",
            year: "2-digit",
            timeZone: "UTC"
          })
        : String(date.getUTCFullYear());

    const xx =
      pad.left + ratio * plotW;

    ctx.fillText(
      label,
      xx,
      height - pad.bottom + 12
    );

  }

  /*
    HISTORICAL SERIES
  */

  series.forEach(s => {

    const highlighted =
      ASSET_HISTORY_VIEW.highlighted;

    const muted =
      highlighted && highlighted !== s.ticker;

    ctx.beginPath();

    s.points.forEach((p, i) => {

      const xx = x(p.date);
      const yy = y(p.value);

      if(i === 0){
        ctx.moveTo(xx, yy);
      }else{
        ctx.lineTo(xx, yy);
      }

    });

    ctx.strokeStyle = s.color;
    ctx.lineWidth = muted ? 1.2 : 2.3;
    ctx.globalAlpha = muted ? .18 : 1;
    ctx.lineJoin = "round";
    ctx.lineCap = "round";
    ctx.stroke();
    ctx.globalAlpha = 1;

  });

}


