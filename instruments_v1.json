/* =====================================================
   DRAW ONE CINEMA FRAME
===================================================== */


function drawMyWealthCinemaFrame(progress){

  const canvas =
    document.getElementById(
      "mywealth-history-canvas"
    );

  const series = MYWEALTH_CINEMA.series;

  if(
    !canvas ||
    !Array.isArray(series) ||
    series.length < 2
  ){
    return;
  }

  /* ============================================
     CANVAS SETUP
  ============================================ */

  const rect = canvas.getBoundingClientRect();

  const W = rect.width;
  const H = rect.height;

  if(W <= 0 || H <= 0) return;

  const dpr = Math.min(
    window.devicePixelRatio || 1,
    2
  );

  const pixelW = Math.round(W*dpr);
  const pixelH = Math.round(H*dpr);

  if(
    canvas.width !== pixelW ||
    canvas.height !== pixelH
  ){
    canvas.width = pixelW;
    canvas.height = pixelH;
  }

  const ctx = canvas.getContext("2d");

  if(!ctx) return;

  ctx.setTransform(dpr,0,0,dpr,0,0);
  ctx.clearRect(0,0,W,H);

  const compact = W < 500;

  const pad = {
    left:compact ? 45 : 64,
    right:compact ? 12 : 28,
    top:compact ? 54 : 44,
    bottom:44
  };

  const plotW = W-pad.left-pad.right;
  const plotH = H-pad.top-pad.bottom;

  if(plotW <= 0 || plotH <= 0) return;


  /* ============================================
     VALIDATE HISTORICAL NAV
  ============================================ */

  const values = series.flatMap(p => [
    p.investmentNAV,
    p.benchmarkNAV
  ]);

  if(values.some(v =>
    !Number.isFinite(v) || v <= 0
  )){
    return;
  }

  const locale =
    APP.lang === "da"
      ? "da-DK"
      : "en-US";

  const formatNAV = value =>
    Math.round(value).toLocaleString(locale);

  const formatReturn = value =>
    `${value > 0 ? "+" : ""}${value.toFixed(1)}%`;

  const formatRelative = value =>
    `${value > 0 ? "+" : ""}${value.toFixed(1)}`;


  /* ============================================
     LINEAR Y AXIS · NICE TICK INTERVALS
     FIXED FOR ENTIRE CINEMA
  ============================================ */

  const dataMin = Math.min(100,...values);
  const dataMax = Math.max(100,...values);

  const dataRange =
    Math.max(dataMax-dataMin,10);

  const margin = dataRange*0.06;

  const rawMin =
    Math.max(0,dataMin-margin);

  const rawMax =
    dataMax+margin;

  const targetIntervals =
    compact ? 4 : 5;

  const rawStep =
    (rawMax-rawMin)/targetIntervals;

  const magnitude =
    Math.pow(
      10,
      Math.floor(Math.log10(rawStep))
    );

  const normalized =
    rawStep/magnitude;

  const niceMultiplier =
    normalized <= 1   ? 1 :
    normalized <= 2   ? 2 :
    normalized <= 2.5 ? 2.5 :
    normalized <= 5   ? 5 : 10;

  const tickStep =
    niceMultiplier*magnitude;

  const axisMin =
    Math.max(
      0,
      Math.floor(rawMin/tickStep)*tickStep
    );

  const axisMax =
    Math.ceil(rawMax/tickStep)*tickStep;

  const axisRange =
    Math.max(axisMax-axisMin,tickStep);

  const X = index =>
    pad.left +
    index/(series.length-1)*plotW;

  const Y = nav =>
    pad.top +
    (axisMax-nav)/axisRange*plotH;


  /* ============================================
     GRID AND Y-AXIS LABELS
  ============================================ */

  ctx.font = compact
    ? "10px Arial"
    : "11px Arial";

  ctx.textBaseline = "middle";

  const tickCount =
    Math.round(
      (axisMax-axisMin)/tickStep
    );

  for(let i=0;i<=tickCount;i++){

    const value =
      axisMin+i*tickStep;

    const y = Y(value);

    ctx.beginPath();
    ctx.moveTo(pad.left,y);
    ctx.lineTo(W-pad.right,y);

    ctx.strokeStyle = "#E2EAF4";
    ctx.lineWidth = 1;
    ctx.stroke();

    ctx.fillStyle = "#64748B";
    ctx.textAlign = "right";

    ctx.fillText(
      formatNAV(value),
      pad.left-8,
      y
    );

  }


  /* ============================================
     NAV 100 REFERENCE LINE
  ============================================ */

  if(100 >= axisMin && 100 <= axisMax){

    const baseY = Y(100);

    ctx.beginPath();
    ctx.moveTo(pad.left,baseY);
    ctx.lineTo(W-pad.right,baseY);

    ctx.strokeStyle =
      "rgba(8,23,53,0.35)";

    ctx.lineWidth = 1;
    ctx.setLineDash([4,4]);
    ctx.stroke();
    ctx.setLineDash([]);

  }


  /* ============================================
     ANNUAL X-AXIS TICKS
  ============================================ */

  const firstYear =
    Number(series[0].date.slice(0,4));

  const lastYear =
    Number(series.at(-1).date.slice(0,4));

  const yearSpan =
    lastYear-firstYear;

  const maxYearLabels =
    Math.max(
      2,
      Math.floor(plotW/(compact ? 46 : 60))
    );

  const yearStep =
    Math.max(
      1,
      Math.ceil(
        (yearSpan+1)/maxYearLabels
      )
    );

  ctx.font = compact
    ? "9px Arial"
    : "10px Arial";

  ctx.textBaseline = "middle";
  ctx.textAlign = "center";

  const drawnYears = new Set();

  for(let year=firstYear;year<=lastYear;year++){

    if(
      (year-firstYear)%yearStep !== 0 &&
      year !== lastYear
    ){
      continue;
    }

    /* Find observation nearest January 1 */

    const target =
      `${year}-01-01`;

    let nearestIndex = 0;
    let nearestDistance = Infinity;

    for(let i=0;i<series.length;i++){

      const distance =
        Math.abs(
          Date.parse(series[i].date) -
          Date.parse(target)
        );

      if(distance < nearestDistance){

        nearestDistance = distance;
        nearestIndex = i;

      }

    }

    if(drawnYears.has(nearestIndex)){
      continue;
    }

    drawnYears.add(nearestIndex);

    const x = X(nearestIndex);

    ctx.beginPath();
    ctx.moveTo(x,pad.top+plotH);
    ctx.lineTo(x,pad.top+plotH+4);

    ctx.strokeStyle = "#94A3B8";
    ctx.lineWidth = 1;
    ctx.stroke();

    ctx.fillStyle = "#64748B";

    ctx.fillText(
      String(year),
      x,
      H-17
    );

  }


  /* ============================================
     CURRENT CINEMA OBSERVATION
  ============================================ */

  const clamped =
    Math.max(0,Math.min(1,progress));

  const exactIndex =
    clamped*(series.length-1);

  const index =
    Math.min(
      series.length-1,
      Math.floor(exactIndex)
    );

  const nextIndex =
    Math.min(
      index+1,
      series.length-1
    );

  const fraction =
    exactIndex-index;

  const current = series[index];
  const next = series[nextIndex];

  /* Linear interpolation */

  const interpolateNAV = key => {

    const a = current[key];
    const b = next[key];

    return a+fraction*(b-a);

  };

  const investmentNAV =
    interpolateNAV("investmentNAV");

  const benchmarkNAV =
    interpolateNAV("benchmarkNAV");


  /* ============================================
     DRAW HISTORICAL CURVES
  ============================================ */

  function drawCurve(key,color){

    ctx.beginPath();

    for(let i=0;i<=index;i++){

      const p = series[i];

      const x = X(i);
      const y = Y(p[key]);

      if(i===0){
        ctx.moveTo(x,y);
      }else{
        ctx.lineTo(x,y);
      }

    }

    const endpointNAV =
      interpolateNAV(key);

    const endpointX =
      X(exactIndex);

    const endpointY =
      Y(endpointNAV);

    ctx.lineTo(endpointX,endpointY);

    ctx.strokeStyle = color;
    ctx.lineWidth = compact ? 2 : 2.8;
    ctx.lineJoin = "round";
    ctx.lineCap = "round";
    ctx.stroke();

    /* Moving endpoint */

    ctx.beginPath();

    ctx.arc(
      endpointX,
      endpointY,
      4.5,
      0,
      Math.PI*2
    );

    ctx.fillStyle = color;
    ctx.fill();

    ctx.strokeStyle = "#FFFFFF";
    ctx.lineWidth = 1.5;
    ctx.stroke();

  }

  drawCurve(
    "benchmarkNAV",
    "#8A929E"
  );

  drawCurve(
    "investmentNAV",
    "#4E79BD"
  );


  /* ============================================
     MOVING TIME CURSOR
  ============================================ */

  const cursorX =
    X(exactIndex);

  ctx.beginPath();
  ctx.moveTo(cursorX,pad.top);
  ctx.lineTo(cursorX,pad.top+plotH);

  ctx.strokeStyle =
    "rgba(78,121,189,0.22)";

  ctx.lineWidth = 1;
  ctx.setLineDash([4,4]);
  ctx.stroke();
  ctx.setLineDash([]);


  /* ============================================
     CHART LEGEND
     INVESTMENT + MARKET BENCHMARK
  ============================================ */

  const assetName =
    MYWEALTH_HISTORY.selected?.name ||
    "Investment";

  ctx.font = compact
    ? "10px Arial"
    : "11px Arial";

  ctx.textBaseline = "middle";
  ctx.textAlign = "left";

  const legendY = 17;

  /* Asset */

  ctx.fillStyle = "#4E79BD";
  ctx.fillRect(
    pad.left,
    legendY-4,
    12,
    8
  );

  ctx.fillStyle = "#081735";

  const maxNameWidth =
    compact
      ? Math.max(50,plotW*0.43)
      : Math.max(90,plotW*0.50);

  let displayName = assetName;

  while(
    displayName.length > 3 &&
    ctx.measureText(displayName).width >
      maxNameWidth
  ){
    displayName =
      displayName.slice(0,-1);
  }

  if(displayName !== assetName){
    displayName =
      displayName.slice(0,-1)+"…";
  }

  ctx.fillText(
    displayName,
    pad.left+18,
    legendY
  );

  /* Benchmark */

  const benchmarkText =
    "Market Benchmark";

  const benchmarkWidth =
    ctx.measureText(benchmarkText).width;

  const benchmarkX =
    W-pad.right-benchmarkWidth-18;

  ctx.fillStyle = "#8A929E";
  ctx.fillRect(
    benchmarkX,
    legendY-4,
    12,
    8
  );

  ctx.fillStyle = "#081735";

  ctx.fillText(
    benchmarkText,
    benchmarkX+18,
    legendY
  );


  /* ============================================
     UPDATE FIVE LIVE METRICS
  ============================================ */

  const returnA =
    investmentNAV-100;

  const returnB =
    benchmarkNAV-100;

/* Geometric relative performance */

const relative =
  (investmentNAV / benchmarkNAV - 1) * 100;

  const setMetric = (id,value) => {

    const el =
      document.getElementById(id);

    if(el){
      el.textContent = value;
    }

  };

  setMetric(
    "mywealth-history-investment-nav",
    formatNAV(investmentNAV)
  );

  setMetric(
    "mywealth-history-benchmark-nav",
    formatNAV(benchmarkNAV)
  );

  setMetric(
    "mywealth-history-return-a",
    formatReturn(returnA)
  );

  setMetric(
    "mywealth-history-return-b",
    formatReturn(returnB)
  );

setMetric(
  "mywealth-history-relative",
  formatReturn(relative)
);
  const relativeEl =
    document.getElementById(
      "mywealth-history-relative"
    );

  if(relativeEl){

    relativeEl.style.color =
      relative > 0
        ? "#4E79BD"
        : relative < 0
          ? "#DC2626"
          : "#081735";

  }

}


/* =====================================================
