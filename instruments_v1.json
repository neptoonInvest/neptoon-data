/* =====================================================
   FIRE SLIDER
===================================================== */

function syncFireSlider(inputs){

  const slider =
    byId("fireConsumptionSlider");

  if(!slider){
    return;
  }

  const base =
    Math.max(
      0,
      inputs.baseMonthlyConsumption
    );

  const max =
    base * 2;

  /*
    Slider itself is 0 → 100.

    We translate that into:
      0   = user's FIRE input
      100 = 2 x user's FIRE input

    This is much more robust than putting
    large monetary values directly into range.
  */

  const sliderPosition =
    clamp(
      Number(slider.value) || 0,
      0,
      100
    );

  const target =
    base +
    (
      base *
      sliderPosition / 100
    );

  STATE.fireBase =
    base;

  STATE.fireTarget =
    target;

  slider.min = "0";
  slider.max = "100";
  slider.step = "1";

  slider.disabled =
    base <= 0;


const formatFullMoney = value =>
  Math.round(value).toLocaleString("da-DK");


byId("fireSliderMin")
  .textContent =
    "MIN " +
    formatFullMoney(base);


byId("fireSliderMax")
  .textContent =
    "MAX " +
    formatFullMoney(max);

const lang =
  INIT?.lang === "da"
    ? "da"
    : "en";

byId("fireSliderValue")
  .textContent =
    formatFullMoney(target) +
    (lang === "da"
      ? " / måned"
      : " / month");

}

/* =====================================================
   EDGE STATE TOAST
===================================================== */

let edgeToastTimer =
  null;

let lastEdgeToastKey =
  null;


function showEdgeToast(
  key,
  title,
  textValue
){

  const toast =
    byId("lifeCycleToast");

  if(!toast){
    return;
  }

  if(lastEdgeToastKey === key){
    return;
  }

  lastEdgeToastKey =
    key;

  clearTimeout(
    edgeToastTimer
  );

  byId("lifeCycleToastTitle")
    .textContent =
      title;

  byId("lifeCycleToastText")
    .textContent =
      textValue;

  toast.hidden =
    false;

  requestAnimationFrame(
    () => {
      toast.classList.add("show");
    }
  );

  edgeToastTimer =
    setTimeout(
      () => {

        toast.classList.remove(
          "show"
        );

        setTimeout(
          () => {
            toast.hidden = true;
          },
          180
        );

      },
      4200
    );

}


function clearEdgeToastState(){
  lastEdgeToastKey = null;
}


function paintEdgeState(
  scenario
){

  const status =
    scenario.expected?.status;

  if(status === "alreadyReached"){

    showEdgeToast(
      "alreadyReached",
      "Financial freedom already reached",
      "Under the current assumptions the Life Cycle begins in the USING phase today."
    );

    return;
  }

  if(status === "notReached"){

    showEdgeToast(
      "notReached",
      "Financial freedom not reached",
      "Under the current assumptions the target is not reached within the selected lifetime."
    );

    return;
  }

  clearEdgeToastState();

}


/* =====================================================
   RESULT HEADER
===================================================== */





function captureRiskReturnBase(){

  RISK_RETURN_BASE = {};

  for(const phaseKey of ["phase1", "phase2"]){

    const model =
      selectedModels[phaseKey];

    const metrics =
      model?.objKeyFigures;

    if(!metrics) continue;

    RISK_RETURN_BASE[phaseKey] = Object.freeze({

      expRetGross:
        Number(metrics.expRetGross),

      costs:
        Number(metrics.costs ?? 0)

    });

  }

  Object.freeze(RISK_RETURN_BASE);

}


function applyEconomicOutlook(){

  if(!RISK_RETURN_BASE) return;

  const delta = {

    negative: -0.015,
    central: 0,
    optimistic: 0.015

  }[ECONOMIC_OUTLOOK] ?? 0;


  /*
    Update selected portfolios
    independently for both phases.
  */

for(const phaseKey of ["phase1", "phase2"]){

    const model =
      selectedModels[phaseKey];

    const metrics =
      model?.objKeyFigures;

    const base =
      RISK_RETURN_BASE[phaseKey];

    if(!metrics || !base) continue;


    /*
      1. Scenario-adjusted gross return
    */

    const expRetGross =
      base.expRetGross + delta;


    /*
      2. Original portfolio costs
    */

    const costs =
      base.costs;


    /*
      3. Backend-consistent net return
    */

    const expRetNet =
      (1 + expRetGross) /
      (1 + costs) - 1;


    /*
      4. Update selected portfolio metrics

      All other metrics remain unchanged.
    */

    metrics.expRetGross =
      expRetGross;

    metrics.expRetNet =
      expRetNet;


    console.log(
      "ECONOMIC OUTLOOK APPLIED",
      {
        phaseKey,
        outlook: ECONOMIC_OUTLOOK,
        expRetGross,
        expRetNet,
        costs
      }
    );

  }

}




