/* =========================================
   SUPPLEMENTARY PENSION — COMPACT ROW
========================================= */

.supplementaryPensionRow{
  display:grid;
  grid-template-columns:
    minmax(180px, 1fr)
    minmax(160px, 1fr)
    minmax(160px, 220px);
  align-items:center;
  gap:16px;
  border-top:1px solid #e5e7eb;
}

/* Identity */

.supplementaryPensionRow .componentIdentity{
  min-width:0;
}

/* Radio options */

.supplementaryPensionOptions{
  display:flex;
  flex-direction:column;
  gap:8px;
  min-width:0;
}

.supplementaryPensionOption{
  display:flex;
  align-items:center;
  gap:7px;
  font-size:12px;
  white-space:nowrap;
  cursor:pointer;
}

.supplementaryPensionOption input{
  margin:0;
  accent-color:#4E79BD;
}

/* Annual amount */

.supplementaryPensionRow .supplementaryPensionAmount{
  min-width:0;
  width:100%;
  flex:initial;
}

.supplementaryPensionAmount input{
  width:100%;
  box-sizing:border-box;
}

/* Responsive */

@media(max-width:760px){

  .supplementaryPensionRow{
    grid-template-columns:
      minmax(0, 1fr)
      minmax(0, 1fr);
  }

  .supplementaryPensionRow .componentIdentity{
    grid-column:1 / -1;
  }

}
/* =========================================
   SUPPLEMENTARY PENSION — GRID FIX
========================================= */

.componentRow.supplementaryPensionRow{
  display:grid !important;

  grid-template-columns:
    minmax(0, 1fr)
    minmax(0, 1fr)
    minmax(0, 180px);

  align-items:center;
  gap:16px;
}

/* Column 1 — Identity */

.supplementaryPensionRow > .componentIdentity{
  grid-column:1;
  grid-row:1;
  min-width:0;
}

/* Column 2 — Radio options */

.supplementaryPensionRow > .supplementaryPensionOptions{
  grid-column:2;
  grid-row:1;
  min-width:0;
}

/* Column 3 — Annual amount */

.supplementaryPensionRow > .supplementaryPensionAmount{
  grid-column:3 !important;
  grid-row:1 !important;

  width:100%;
  min-width:0;
  margin:0;
  position:static;
}

.supplementaryPensionRow > .supplementaryPensionAmount input{
  width:100%;
  box-sizing:border-box;
}
  
  /* SUPPLEMENTARY PENSION — COLUMN ALIGNMENT */

.componentRow.supplementaryPensionRow{
  display:grid !important;
  grid-template-columns:
    minmax(180px, 1.1fr)
    minmax(0, 1.5fr)
    160px;

  align-items:center;
  column-gap:12px;
}

/* Column 1 — Identity */
.supplementaryPensionRow > .componentIdentity{
  grid-column:1;
  grid-row:1;
  min-width:0;
}

/* Column 2 — Radios */
.supplementaryPensionRow > .supplementaryPensionOptions{
  grid-column:2;
  grid-row:1;
  justify-self:start;
  align-items:flex-start;
  min-width:0;
}

/* Column 3 — Annual amount */
.supplementaryPensionRow > .supplementaryPensionAmount{
  grid-column:3;
  grid-row:1;
  justify-self:end;
  width:160px;
  min-width:0;
  margin:0;
}

.supplementaryPensionRow
.supplementaryPensionAmount input{
  width:100%;
  box-sizing:border-box;
}

/* Keep both radios left-aligned */
.supplementaryPensionOption{
  display:flex;
  align-items:center;
  justify-content:flex-start;
  gap:7px;
  margin:0;
}
/* SUPPLEMENTARY PENSION — FORCE RIGHT COLUMN */

.componentRow.supplementaryPensionRow{
  display:grid !important;
  grid-template-columns:
    minmax(180px, 1fr)
    minmax(0, 1.5fr)
    160px !important;
  column-gap:12px;
  width:100%;
  box-sizing:border-box;
}

.supplementaryPensionRow > .componentIdentity{
  grid-column:1 !important;
  grid-row:1;
}

.supplementaryPensionRow > .supplementaryPensionOptions{
  grid-column:2 !important;
  grid-row:1;
  justify-self:start;
  align-items:flex-start;
}

.supplementaryPensionRow > .miniField.supplementaryPensionAmount{
  grid-column:3 !important;
  grid-row:1 !important;
  justify-self:end;
  width:160px !important;
  max-width:none;
  min-width:0;
  margin:0;
  position:static;
}

.supplementaryPensionRow > .miniField.supplementaryPensionAmount input{
  width:100%;
  box-sizing:border-box;
}
  
  .supplementaryPensionOptions{
