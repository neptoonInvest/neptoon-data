     NO HORIZONTAL SCROLL
     ===================================== */

  .chartSection .chartWrap{
    position:relative;
    width:100%;
    min-width:0;
    max-width:100%;
    box-sizing:border-box;
    overflow:hidden;
    padding:0;
  }

  .chartSection #lifeChart{
