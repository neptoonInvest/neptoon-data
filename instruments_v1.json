function findFreedomMonth(
  inputs,
  annualBuildRate,
  annualUseRate,
  buildWinningLedger = false
){

  const totalMonths =
    totalMonthsFor(inputs);

  if(
    totalMonths <= 0 ||
    totalMonths > 1500
  ){
    return null;
  }


  /*
    Search from TODAY through the final month that still
    leaves at least one USING month.

    month === 0 feasible:
      financial freedom is already supported today.

    no feasible month:
      financial freedom is not reached within lifetime.
  */

  for(
    let month=0;
    month<totalMonths;
    month++
  ){

    const result =
      simulateLifeCycleCandidate(
        inputs,
        month,
        annualBuildRate,
        annualUseRate,
        false
      );



if(month === 0 || result.feasible){

  const ledger = result.ledger || [];



}

















    if(result.feasible){

      const winningSimulation =
        buildWinningLedger
          ? simulateLifeCycleCandidate(
              inputs,
              month,
              annualBuildRate,
              annualUseRate,
              true
            )
          : result;





if(buildWinningLedger){

  const rows =
    winningSimulation.ledger || [];



}












      return {

        status:
          month === 0
            ? "alreadyReached"
            : "normal",

        month,

        age:
          inputs.currentAge +
          month/12,

        accumulatedWealth:
          winningSimulation
            .wealthAtFreedom,

        requiredWealth:
          winningSimulation
            .wealthAtFreedom,

        terminalEstate:
          winningSimulation
            .terminalEstate,

        simulation:
          winningSimulation

      };

    }

  }


  return {
    status:"notReached",
    month:null,
    age:null,
    accumulatedWealth:null,
    requiredWealth:null,
    terminalEstate:null,
    simulation:null
  };

}

