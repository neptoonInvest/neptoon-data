   Phase 2 = Using Wealth

   Portfolio selection comes from My Account.
   No interactive risk selectors.
===================================================== */

function paintPortfolioAssumptions(){

  /*
    COMMON ASSUMPTIONS
  */

  const inputs =
    readInputs();

  const taxRate =
    getTaxRate();


  /*
    PUBLIC PENSION — FIXED NOMINAL GROWTH
  */

  const publicPensionGrowthField =
    byId("publicPensionGrowth");

  if(publicPensionGrowthField){

    publicPensionGrowthField.value =
      (
        inputs.inflation * 100 + 0.5
      ).toFixed(1);

    publicPensionGrowthField.disabled = true;

  }


  /*
    FORMAT PERCENTAGE
  */

  const pctValue = value =>
    value !== null &&
    value !== undefined &&
    value !== "" &&
    Number.isFinite(Number(value))
      ? (Number(value) * 100).toFixed(2) + "%"
      : "—";


  /*
    PHASE METRICS
  */

  const paintPhase = (
    phaseKey,
    prefix
  ) => {

    const model =
      selectedModels[phaseKey];

    const metrics =
      model?.objKeyFigures || {};

const expRetNet =
  metrics.expRetNet == null ||
  metrics.expRetNet === ""
    ? NaN
    : Number(metrics.expRetNet);

    const expRetGross =
      metrics.expRetGross;

    const costs =
      metrics.costs;


    /*
      Preserve existing nominal-to-real
      after-tax calculation.
    */

    const realReturn =
      Number.isFinite(expRetNet)
        ? nominalToRealAfterTax(
            expRetNet,
            taxRate,
            inputs.inflation
          )
        : null;


    const grossField =
      byId(prefix + "ExpRetGross");

    if(grossField){

      grossField.textContent =
        pctValue(expRetGross);

    }


    const costsField =
      byId(prefix + "Costs");

    if(costsField){

      costsField.textContent =
        pctValue(
          costs == null
            ? null
            : Math.abs(Number(costs))
        );

    }


    const realField =
      byId(prefix + "ExpRetReal");

    if(realField){

      realField.textContent =
        pctValue(realReturn);

    }

  };


  /*
    TWO INDEPENDENT PORTFOLIOS
  */

  paintPhase(
    "phase1",
    "build"
  );

  paintPhase(
    "phase2",
    "use"
  );


  /*
    COMMON FOOTER
  */

  const riskTaxValue =
    byId("riskTaxValue");

  if(riskTaxValue){

    riskTaxValue.textContent =
      pctValue(taxRate);

  }


  const riskInflationValue =
    byId("riskInflationValue");

  if(riskInflationValue){

    riskInflationValue.textContent =
      pctValue(inputs.inflation);

  }


  /*
    ECONOMIC OUTLOOK
  */

  const da =
    String(INIT?.lang || "en")
      .toLowerCase()
      .startsWith("da");

  const economicLabels = {

    negative:
      da ? "Negativt" : "Negative",

    central:
      da ? "Centralt" : "Central",

    optimistic:
      da ? "Optimistisk" : "Optimistic"

  };

  const economicField =
    byId("riskEconomicOutlookValue");

  if(economicField){

    economicField.textContent =
      economicLabels[ECONOMIC_OUTLOOK] ||
      economicLabels.central;

  }


  /*
    LEGACY HEADER FIELDS
  */

  ["risk1Text", "risk2Text"].forEach(id => {

    const el =
      byId(id);

    if(el){
      el.textContent = "";
    }

  });

}


