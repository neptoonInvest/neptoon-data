    line-height:1.6;
    text-align:center;
    margin-top:12px;
  }


  /* =====================================
     CHART SECTION
     ===================================== */

  .chartSection{
    width:100%;
    min-width:0;
    max-width:100%;
    box-sizing:border-box;
    padding:12px 0;
  }

  /* FIRE AND LEGACY CONTROL BARS */

