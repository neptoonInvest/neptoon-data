const LIFE_CYCLE_PORTFOLIO_URL =
  "https://neptooninvest.github.io/neptoon-data/portfolios_v1.json";

/*
  LANGUAGE DETECTION
*/

function detectLifeCycleLanguage(){

  const saved =
    localStorage.getItem("neptoon_lang");

  if(
    saved === "da" ||
    saved === "en"
  ){
    return saved;
  }

  const browser =
    (
      navigator.languages?.[0] ||
      navigator.language ||
      "en"
    ).toLowerCase();

  return browser.startsWith("da")
    ? "da"
    : "en";

}


/*
  LOAD PORTFOLIO DATA
*/

async function fetchLifeCyclePortfolios(){

  const response =
    await fetch(
      LIFE_CYCLE_PORTFOLIO_URL,
      { cache: "no-cache" }
    );

  if(!response.ok){

    throw new Error(
      "Portfolio fetch failed: " +
      response.status
    );

  }

  const data =
    await response.json();

  /*
    Supports either a direct array
    or an object with portfolios array.
  */

  const portfolios =
    Array.isArray(data)
      ? data
      : data.portfolios;

  if(
    !Array.isArray(portfolios) ||
    portfolios.length === 0
  ){

    throw new Error(
      "Missing portfolio catalogue"
    );

  }

  return portfolios;

}


