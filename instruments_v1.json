/* =====================================================
   FUTURE RESOURCES — IMPLIED VALUATION RATE
===================================================== */

function calculateFutureResourceRate(
  valueToday,
  futureNominalAmount,
  currentAge,
  realizationAge
){

  const years =
    realizationAge - currentAge;

  /*
    A constant compound rate requires
    positive initial and future values,
    and a positive time horizon.
  */

  if(
    valueToday <= 0 ||
    futureNominalAmount <= 0 ||
    years <= 0
  ){
    return null;
  }

  const rate =
    Math.pow(
      futureNominalAmount / valueToday,
      1 / years
    ) - 1;

  return Number.isFinite(rate)
    ? rate
    : null;

}

