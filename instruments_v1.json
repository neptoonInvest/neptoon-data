  flex:0 0 auto;
  white-space:nowrap;
  font-size:13px;
  font-weight:700;
  color:var(--lifeNavy);
  font-variant-numeric:tabular-nums;
}


/* =====================================================
   PERSONALIZED FREEDOM NARRATIVE
===================================================== */

#lifeBalancePanel .freedomDayNarrative {
  margin-top:30px;
}

#lifeBalancePanel .freedomDayItems {
  display:grid;
  grid-template-columns:
    repeat(2,minmax(0,1fr));
  gap:14px;
}

#lifeBalancePanel .freedomDayItem {
  display:flex;
  align-items:flex-start;
  gap:12px;
  min-width:0;

  padding:16px;

  border:1px solid var(--lifeBorder);
  background:#fff;
}

#lifeBalancePanel .freedomDayItemIcon {
  display:flex;
  align-items:center;
  justify-content:center;
  flex:0 0 34px;

  width:34px;
  height:34px;

  background:var(--lifeSoftBlue);
  color:var(--lifeBlue);
}

#lifeBalancePanel .freedomDayItemIcon svg {
  width:18px;
  height:18px;
  stroke:currentColor;
  stroke-width:1.8;
  fill:none;
}

#lifeBalancePanel .freedomDayItemContent {
  flex:1;
  min-width:0;
}

#lifeBalancePanel .freedomDayItemHead {
  display:flex;
  justify-content:space-between;
  align-items:baseline;
  flex-wrap:wrap;
  gap:5px 12px;
  margin-bottom:7px;
}

#lifeBalancePanel .freedomDayItemTitle {
  font-size:13px;
  font-weight:700;
  color:var(--lifeBlue);
}

#lifeBalancePanel .freedomDayItemValue {
  font-size:12px;
  font-weight:700;
  white-space:nowrap;
  color:var(--lifeNavy);
  font-variant-numeric:tabular-nums;
}

#lifeBalancePanel .freedomDayItemText {
  font-size:12px;
  line-height:1.7;
  color:var(--lifeText);
}


/* =====================================================
   METHODOLOGY
===================================================== */

#lifeBalancePanel .lifeBalanceFooter {
  margin-top:26px;
  padding-top:15px;
  border-top:1px solid var(--lifeBorder);
}

#lifeBalancePanel .lifeBalanceFootnote,
#lifeBalancePanel .freedomDayMethodologyNote {
  font-size:11px;
  line-height:1.7;
  color:var(--lifeMuted);
}

#lifeBalancePanel .freedomDayMethodologyNote {
  margin-top:8px;
}


/* =====================================================
   RESPONSIVE
===================================================== */

@media(max-width:700px) {

  #lifeBalancePanel .lifeBalanceSheet {
    grid-template-columns:minmax(0,1fr);
    row-gap:0;
  }

  #lifeBalancePanel .lifeBalanceColumn {
    border-bottom:1px solid var(--lifeBorder);
    margin-bottom:14px;
  }

  #lifeBalancePanel .lifeBalanceTotals {
