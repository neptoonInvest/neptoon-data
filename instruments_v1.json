function populateLifeBalanceAgeSelect(
  inputs,
  scenario
){

  const select =
    document.getElementById(
      "lifeBalanceAgeSelect"
    );

  if(!select) return;

  const ledger =
    scenario?.ledger || [];

  if(!ledger.length) return;

  const startAge =
    Number(inputs.currentAge);

  if(!Number.isFinite(startAge)) return;

  const previousValue =
    select.value;

  select.replaceChildren();

  const da =
    String(INIT.lang || "en")
      .toLowerCase()
      .startsWith("da");

  const addOption = (
    index,
    label
  ) => {

    const option =
      document.createElement("option");

    option.value =
      String(index);

    option.textContent =
      label;

    select.appendChild(option);

  };

  /*
    FIRST ENTRY — TODAY
  */

  addOption(
    0,
    da
      ? `I dag · ${startAge} år`
      : `Today · Age ${startAge}`
  );

  /*
    ANNUAL OBSERVATIONS
  */

  for(
    let index = 12;
    index < ledger.length - 1;
    index += 12
  ){

    const age =
      startAge + index / 12;

    addOption(
      index,
      da
        ? `${age} år`
        : `Age ${age}`
    );

  }

  /*
    FINAL LEDGER OBSERVATION
  */

  const finalIndex =
    ledger.length - 1;

  const finalAge =
    startAge + finalIndex / 12;

  addOption(
    finalIndex,
    da
      ? `${finalAge.toFixed(1)} år · Slutalder`
      : `Age ${finalAge.toFixed(1)} · Terminal`
  );

  /*
    PRESERVE SELECTION IF POSSIBLE
  */

  if(
    Array.from(select.options)
      .some(option =>
        option.value === previousValue
      )
  ){

    select.value =
      previousValue;

  }else{

    select.value = "0";

  }

}


