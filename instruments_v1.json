/*
  DATE FORMATTER

  Month zero = current calendar month.
*/

const startDate =
  new Date();

startDate.setDate(1);

const dateFormatter =
  new Intl.DateTimeFormat(
    "en-GB",
    {
      month:"long",
      year:"numeric"
    }
  );

const ageFormatter =
  new Intl.NumberFormat(
    "en-GB",
    {
      minimumFractionDigits:1,
      maximumFractionDigits:1
    }
  );


/*
  HOVER
*/

canvas.onmousemove =
  event => {

    const rect =
      canvas.getBoundingClientRect();

    const mouseX =
      event.clientX -
      rect.left;

    const mouseY =
      event.clientY -
      rect.top;


    /*
      ONLY ACTIVE INSIDE PLOT
    */

    if(
      mouseX < pad.left ||
      mouseX > pad.left + plotW ||
      mouseY < pad.top ||
      mouseY > pad.top + plotH
    ){

      tooltip.style.display =
        "none";

      return;

    }


    /*
      NEAREST MONTH
    */

    const month =
      Math.round(
        (
          mouseX -
          pad.left
        ) /
        plotW *
        totalMonths
      );

    const point =
      path.reduce(
        (nearest,p) =>

          Math.abs(
            p.month - month
          ) <
          Math.abs(
            nearest.month - month
          )

            ? p
            : nearest

      );


    /*
      DATE
    */

    const pointDate =
      new Date(
        startDate.getFullYear(),
        startDate.getMonth() +
          point.month,
        1
      );


    /*
      AGE
    */

    const age =
      inputs.currentAge +
      point.month / 12;


    /*
      TOOLTIP CONTENT
    */

    tooltip.innerHTML = `

      <div class="lifeChartTooltipTitle">
        ${dateFormatter.format(pointDate)}
      </div>

      <div class="lifeChartTooltipRow">
        <span>Age:</span>
        <span class="lifeChartTooltipValue">
          ${ageFormatter.format(age)}
        </span>
      </div>

      <div class="lifeChartTooltipRow">
        <span>Real Wealth:</span>
        <span class="lifeChartTooltipValue">
          ${formatMoney(point.wealth)}
        </span>
      </div>

    `;


    tooltip.style.display =
      "block";


    /*
      POSITION WITHIN CONTAINER
    */

    const tooltipW =
      tooltip.offsetWidth;

    const tooltipH =
      tooltip.offsetHeight;

    const left =
      Math.max(
        8,
        Math.min(
          mouseX + 16,
          container.clientWidth -
          tooltipW - 8
        )
      );

    const top =
      Math.max(
        8,
        Math.min(
          mouseY -
          tooltipH - 12,
          container.clientHeight -
          tooltipH - 8
        )
      );

    tooltip.style.left =
      left + "px";

    tooltip.style.top =
      top + "px";

  };


canvas.onmouseleave =
  () => {

    tooltip.style.display =
      "none";

  };



















