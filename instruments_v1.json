===================================================== */

function completeMyWealthCinema(){

  const series = MYWEALTH_CINEMA.series;

  if(!series?.length) return;

  MYWEALTH_CINEMA.running = false;
  MYWEALTH_CINEMA.completed = true;
  MYWEALTH_CINEMA.frame = null;
  MYWEALTH_CINEMA.progress = 1;

  MYWEALTH_HISTORY.status = "completed";

  /*
    =========================
    LANGUAGE + METHOD
    =========================
  */

  const da = INIT.lang === "da";

  const isJensen =
    myWealthMode === "stocks" &&
    comparisonMethod === "jensen";

  /*
    =========================
    FINAL RESULTS
    =========================
  */

  const last = series.at(-1);

  const investmentNAV = last.investmentNAV;
  const benchmarkNAV = last.benchmarkNAV;

  const excessReturn =
    (investmentNAV / benchmarkNAV - 1) * 100;

  /*
    =========================
    DOM ELEMENTS
    =========================
  */

  const status =
    document.getElementById(
      "mywealth-history-status"
    );

  const verdictMarket =
    document.getElementById(
      "mywealth-history-verdict-market"
    );

  const verdictDecision =
    document.getElementById(
      "mywealth-history-verdict-decision"
    );

  if(status){

    status.textContent =
      da ? "AFSLUTTET" : "COMPLETED";

  }

  /*
    =========================
    VERDICT A
    =========================
  */

  if(verdictMarket){

    if(investmentNAV > benchmarkNAV){

      verdictMarket.textContent = isJensen
        ? (
            da
              ? "JA · BEDRE END BETAJUSTERET BENCHMARK"
              : "YES · OUTPERFORMED BETA-ADJUSTED BENCHMARK"
          )
        : (
            da
              ? "JA · BEDRE END MARKEDET"
              : "YES · OUTPERFORMED THE MARKET"
          );

    }else if(investmentNAV < benchmarkNAV){

      verdictMarket.textContent = isJensen
        ? (
            da
              ? "NEJ · DÅRLIGERE END BETAJUSTERET BENCHMARK"
              : "NO · UNDERPERFORMED BETA-ADJUSTED BENCHMARK"
          )
        : (
            da
              ? "NEJ · DÅRLIGERE END MARKEDET"
              : "NO · UNDERPERFORMED THE MARKET"
          );

    }else{

      verdictMarket.textContent = isJensen
        ? (
            da
              ? "SAMME AFKAST SOM BETAJUSTERET BENCHMARK"
              : "MATCHED BETA-ADJUSTED BENCHMARK"
          )
        : (
            da
              ? "SAMME AFKAST SOM MARKEDET"
              : "MATCHED THE MARKET"
          );

    }

  }

  /*
    =========================
    VERDICT B
    =========================

    Historical outperformance is not
    an independent buy/sell signal.
  */

  if(verdictDecision){

    verdictDecision.textContent = da
      ? "Historiske afkast alene giver ikke grundlag for en købs- eller salgsbeslutning"
      : "Historical returns alone do not justify a buy or sell decision";

  }

  /*
    =========================
    DEBUG
    =========================
  */

  console.log(
    "MYWEALTH CINEMA COMPLETED",
    {
      language: INIT.lang,
      method: isJensen ? "jensen" : "market",
      investmentNAV,
      benchmarkNAV,
      relativeWealthDifferencePct: excessReturn,
      observations: series.length
    }
  );

}


/* =====================================================
   PLAY 5-SECOND CINEMA
===================================================== */

function playMyWealthCinema(){

  const investment =
    MYWEALTH_HISTORY.selected;

console.log("investment selected",MYWEALTH_HISTORY.selected);

console.log("investment selected",MYWEALTH_HISTORY.selected);

console.log("investment selected",MYWEALTH_HISTORY.selected);

console.log("investment selected",MYWEALTH_HISTORY.selected);
 

  const sourceSeries =
    MYWEALTH_HISTORY.series;

  if(
    !Array.isArray(sourceSeries) ||
    sourceSeries.length < 2
  ){
    console.warn(
      "Market Race history not ready"
    );
    return;
  }

  /*
    =========================
    COMPARISON METHOD
    =========================
  */

  const beta =
    Number(investment?.beta);

  const useJensen =
    comparisonMethod === "jensen" &&
    myWealthMode === "stocks" &&
    Number.isFinite(beta);

  const series = useJensen
    ? applyStaticBeta(
        sourceSeries,
        beta
      )
    : sourceSeries;

  /*
    =========================
    START CINEMA
    =========================
  */

  resetMyWealthCinema();

  MYWEALTH_CINEMA.series = series;

  MYWEALTH_CINEMA.selectionId =
    MYWEALTH_HISTORY.selectedId;

  MYWEALTH_CINEMA.running = true;

  MYWEALTH_HISTORY.status = "playing";

  const status =
    document.getElementById(
      "mywealth-history-status"
    );

  if(status){
    status.textContent = "PLAYING";
  }

  const startTime = performance.now();

  function animate(now){

    if(!MYWEALTH_CINEMA.running){
      return;
    }

    if(
      MYWEALTH_CINEMA.selectionId !==
      MYWEALTH_HISTORY.selectedId
    ){
      resetMyWealthCinema();
      return;
    }

    const elapsed = now-startTime;

    const progress = Math.min(
      1,
      elapsed/MYWEALTH_CINEMA.duration
    );

    MYWEALTH_CINEMA.progress = progress;

    drawMyWealthCinemaFrame(progress);

    if(progress < 1){

      MYWEALTH_CINEMA.frame =
        requestAnimationFrame(animate);

    }else{

      completeMyWealthCinema();

    }

  }

  drawMyWealthCinemaFrame(0);

  MYWEALTH_CINEMA.frame =
    requestAnimationFrame(animate);

}


