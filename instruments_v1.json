function renderPortfolioRiskDisplays(){

  const phases = [

    {
      key:"phase1",
      mountainDots:"riskBuild",
      mountainLabel:"buildModelLabel",
      accountDots:"buildRiskIndicator",
      accountLevel:"buildRiskLevel"
    },

    {
      key:"phase2",
      mountainDots:"riskUse",
      mountainLabel:"useModelLabel",
      accountDots:"useRiskIndicator",
      accountLevel:"useRiskLevel"
    }

  ];

  phases.forEach(phase => {

    const model =
      selectedModels?.[phase.key];

    const risk =
      model?.objKeyFigures?.risk;

    const riskDot =
      risk != null &&
      Number.isFinite(Number(risk))
        ? riskDotFromRisk(Number(risk))
        : 0;

    const modelLabel =
      model?.identity?.modelLabel || "—";


    /*
      ============================================
      A. MOUNTAIN — RISK DOTS
      ============================================
    */

    const mountainDots =
      byId(phase.mountainDots);

    if(mountainDots){

      mountainDots.innerHTML =
        Array.from({length:7}, (_,i) => `
          <span class="riskDot ${i < riskDot ? "active" : ""}"></span>
        `).join("");

    }


    /*
      ============================================
      B. MOUNTAIN — MODEL LABEL
      ============================================
    */

    const mountainLabel =
      byId(phase.mountainLabel);

    if(mountainLabel){

      mountainLabel.textContent =
        modelLabel;

    }



/*
  MY ACCOUNT — RISK DOTS
*/

const accountDots =
  byId(phase.accountDots);

if(accountDots){

  accountDots.querySelectorAll("i").forEach(
    (dot,i) => {

      dot.classList.toggle(
        "on",
        i < riskDot
      );

    }
  );

    }


    /*
      ============================================
      D. MY ACCOUNT — RISK LEVEL
      ============================================
    */

    const accountLevel =
      byId(phase.accountLevel);

    if(accountLevel){

      accountLevel.textContent =
        riskDot > 0
          ? `${riskDot} / 7`
          : "— / 7";

    }

  });

}


