  gap:12px;
}

.lang-switch button{
  display:flex;
  align-items:center;
  justify-content:center;

  width:32px;
  height:27px;
  padding:3px 0 5px;

  border:0;
  border-bottom:2px solid transparent;
  border-radius:0;

  background:transparent;
